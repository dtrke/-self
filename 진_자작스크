local function WaitUntilStationary(duration, maxWait)
    local stationaryTime = 0
    local startTime = tick()
    while stationaryTime < duration and (tick() - startTime) < (maxWait or 30) do
        task.wait(0.1)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Magnitude < 1 then
            stationaryTime = stationaryTime + 0.1
        else
            stationaryTime = 0
        end
    end
end

-- 앞서 완성한 "ScrollingFrame 없는 스크롤" 방식 그대로 재사용
local function ScrollToPotionButton(targetButton, viewport, itemContainer)
    if not (targetButton and viewport and itemContainer) then
        return
    end
    local layout = itemContainer:FindFirstChildWhichIsA("UIListLayout")
        or itemContainer:FindFirstChildWhichIsA("UIGridLayout")
    if not layout then
        return
    end

    local btnPos = targetButton.AbsolutePosition
    local btnSize = targetButton.AbsoluteSize
    local viewportPos = viewport.AbsolutePosition
    local viewportSize = viewport.AbsoluteSize

    local deltaY = (btnPos.Y + btnSize.Y / 2) - (viewportPos.Y + viewportSize.Y / 2)

    local currentPos = itemContainer.Position
    local newOffsetY = currentPos.Y.Offset - deltaY

    local maxOffset = 0
    local minOffset = -(layout.AbsoluteContentSize.Y - viewport.AbsoluteSize.Y)
    if minOffset > maxOffset then minOffset = maxOffset end


    newOffsetY = math.clamp(newOffsetY, minOffset, maxOffset)
    itemContainer.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, newOffsetY)
end

