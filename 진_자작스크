task.spawn(function()
    local hasSentExitMessage = false
    local function sendSystemExitWebhook()
        if not biomeMacroConnection then return end
        if hasSentExitMessage then return end
        hasSentExitMessage = true

        local HttpService = game:GetService("HttpService")
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or
            (fluxus and fluxus.request) or request
        if not requestFunc then return end

        local hooks = {}
        if Settings.Webhook and Settings.Webhook ~= "" then table.insert(hooks, Settings.Webhook) end
        if Settings.Webhook2 and Settings.Webhook2 ~= "" then table.insert(hooks, Settings.Webhook2) end
        if #hooks == 0 then return end

        local payload = HttpService:JSONEncode({
            ["embeds"] = { {
                ["description"] = "> ## Player has left the game (Disconnected/Left)",
                ["color"] = 16711680,
                ["timestamp"] = DateTime.now():ToIsoDate(),
                ["footer"] = { ["text"] = "Player: " .. game:GetService("Players").LocalPlayer.Name }
            } }
        })

        for _, hook in ipairs(hooks) do
            task.spawn(function()
                pcall(function()
                    requestFunc({
                        Url = hook,
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body =
                            payload
                    })
                end)
            end)
        end
    end

    local coreGui = game:GetService("CoreGui")
    local promptOverlay = coreGui:FindFirstChild("RobloxPromptGui") and
        coreGui.RobloxPromptGui:FindFirstChild("promptOverlay")
    if promptOverlay then
        promptOverlay.ChildAdded:Connect(function(child)
            if child.Name == "ErrorPrompt" then
                sendSystemExitWebhook()
            end
        end)
    end

    game:GetService("Players").PlayerRemoving:Connect(function(player)
        if player == game:GetService("Players").LocalPlayer then
            sendSystemExitWebhook()
        end
    end)
end)

