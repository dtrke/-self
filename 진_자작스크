-- [NEW] 제목 포매팅 함수 (PascalCase -> Spaced Word)
local function FormatMusicTitle(name)
    if not name then return "" end
    -- 확장자 제거 (.mp3, .wav 등)
    local title = name:gsub("%.%w+$", "")
    -- 첫 대문자가 아닌 뒤의 대문자 앞에 한 칸 띄어쓰기 추가
    title = title:gsub("([^%s])(%u)", "%1 %2")
    return title
end

-- Settings.MusicVisualizerSetting.isDraggingTimeline in settings registry
local function UpdateSeek(inputPos)
    local sound = GetCurrentPlayingSound()
    if sound and sound.TimeLength > 0 then
        local relX = math.clamp((inputPos.X - timelineBox.AbsolutePosition.X) / timelineBox.AbsoluteSize.X, 0, 1)
        sound.TimePosition = relX * sound.TimeLength
    end
end

