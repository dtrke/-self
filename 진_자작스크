local prFarmToggled = false
OtherGameTab.Toggle({
    Text = "자동 파밍",
    Enabled = false,
    Callback = function(value)
        prFarmToggled = value
        if value then
            -- F키 무한 스팸 (0.1초마다)
            task.spawn(function()
                local vim = game:GetService("VirtualInputManager")
                while prFarmToggled do
                    vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.005)
                    vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                    if keypress and keyrelease then
                        pcall(function()
                            keypress(0x46)
                            task.wait(0.02)
                            keyrelease(0x46)
                        end)
                    end
                    task.wait(0.01)
                end
            end)

            -- 텔레포트 추적 로직
            task.spawn(function()
                local priorityList = { "Gilded Jewelry", "Tablet", "Smartphone", "Jewelry", "Electronics" }
                local blacklist = {}
                while prFarmToggled do
                    local RaycastIgnore = workspace:FindFirstChild("RaycastIgnore")
                    if not RaycastIgnore then
                        task.wait(1)
                        continue
                    end

                    local targets = {}
                    for _, child in ipairs(RaycastIgnore:GetChildren()) do
                        if child:IsA("Model") and not blacklist[child] then
                            table.insert(targets, child)
                        end
                    end

                    if #targets == 0 then
                        task.wait(1)
                        continue
                    end

                    local selectedTarget = nil
                    for _, itemName in ipairs(priorityList) do
                        for _, model in ipairs(targets) do
                            local nameVal = model:GetAttribute("Itemname") or
                                (model:FindFirstChild("Itemname") and (model.Itemname:IsA("StringValue") or model.Itemname:IsA("ValueBase")) and model.Itemname.Value) or
                                model.Name
                            if nameVal == itemName then
                                selectedTarget = model
                                break
                            end
                        end
                        if selectedTarget then break end
                    end

                    if not selectedTarget then
                        selectedTarget = targets[math.random(1, #targets)]
                    end

                    local teleportCount = 0
                    while selectedTarget and selectedTarget.Parent == RaycastIgnore and prFarmToggled do
                        local success, pivot = pcall(function() return selectedTarget:GetPivot() end)
                        if success and pivot then
                            local char = game.Players.LocalPlayer.Character
                            if char then char:PivotTo(pivot) end
                        end

                        teleportCount = teleportCount + 1
                        if teleportCount >= 5 then
                            -- 5번 이상 시도했는데 안 먹어지면 버그 걸린 아이템/빛나는 파트로 간주하여 무시 & 파괴
                            blacklist[selectedTarget] = true
                            pcall(function() selectedTarget:Destroy() end)
                            break
                        end

                        task.wait(0.1)
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

