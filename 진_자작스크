                    -- ✅ [리팩터링] Memory Match/Auto Item Use가 각자 자신을 감시하다가
                    -- 미리 계산해둔 플래그(getgenv().MemoryMatchWantsSlot / AutoItemUseWantsSlot)를
                    -- 그대로 읽음 - 여기서 매번 직접 UI 스캔이나 타이머 계산을 하지 않음.
                    local hasAnySignal = Settings.Emergency
                        or IsMemoryMatchSignaledFast()
                        or getgenv().AutoItemUseWantsSlot == true
                        or IsPotionCraftSignaled()

                    if not hasAnySignal then
                        return
                    end

                    getgenv().IsFlexibilityState = true

                    if Settings.Emergency then
                        Settings.EmergencyReady = true
                        -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 90초)
                        local emergencyWaitStart = tick()
                        while Settings.Emergency and (tick() - emergencyWaitStart) < 180 do
                            task.wait(0.5)
                        end
                        Settings.EmergencyReady = false
                    end

                    -- ✅ [사용자 요청] Memory Match/Potion Craft 등 단일성 행동이 진행 중이거나
                    -- 곧 시작할 신호가 있으면 낚시가 자리를 반납하고, 그 기능이 끝날 때
                    -- 넘겨받는다 (직접 실행하지 않음 - 실행 주체는 각자의 감시 루프뿐이라
                    -- 이중 실행이 구조적으로 불가능함)
                    --
                    -- ✅ [버그 수정] Auto Item Use는 이제 독립 루프(파일 앞쪽)가 낚시 활성
                    -- 여부와 무관하게 타이머로 직접 판단하고 실행까지 전담하므로, 여기서
                    -- 따로 다시 실행하지 않는다 (중복 실행 방지, 실행 주체 단일화).
                    YieldFishingForSingleActions()

                    getgenv().IsFlexibilityState = false
                end

                while Settings.Sols.autoFishActive do
                    -- ✅ [사용자 요청] 판매 타임아웃으로 인한 재시작 요청 플래그 초기화
                    -- (이 지점에 도달했다는 건 이미 재시작이 반영된 것이므로 플래그를 내림)
                    if getgenv().FishRestartRequested then
                        getgenv().FishRestartRequested = false
                    end
                    if getgenv().MemoryMatchActive or (getgenv().CurrentActiveFeature and getgenv().CurrentActiveFeature ~= "Fishing") then
                        SetCurrentAction("낚시 - 다른 기능 진행 중, 대기")
                        task.wait(0.5)
                        continue
                    end

                    -- ✅ [버그 수정] 새 캐스팅 사이클을 시작하기 전에 통합 신호를 먼저 체크한다.
                    -- (자리를 잡기도 전에 확인해서, 신호가 있으면 아예 ESC/Tab 메뉴 조작이나
                    -- 이동을 시작조차 하지 않게 함 - 이게 없으면 낚시가 메뉴 조작/이동을 이미
                    -- 시작한 뒤에야 신호를 발견해서 캐릭터 리셋과 겹치는 사고가 났었음)
                    if IsAnySingleActionSignaled() then
                        SetCurrentAction("낚시 - 다른 기능에 자리 확인 중")
                        task.wait(0.5)
                        continue
                    end

                    SetCurrentAction("낚시 - 캐스팅 준비 중")
                    StartMacro("Fishing")
                    local lastActivityTime = tick()

                    local pathExists = false
                    local isTargetPos = false
                    local selector = nil

                    local success, result = pcall(function()
                        local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
                            .PageViewClipper.PageView.PageViewInnerFrame.Page
                        selector = basePage["Movement ModeFrame"].Selector
                        return selector.Selection3
                    end)

                    if success and result then
                        pathExists = true
                        if result.Position == UDim2.new(0, 32, 0, 0) then
                            isTargetPos = true
                        end
                    end

                    local proceed = false

                    if isTargetPos then
                        proceed = true
                    else
                        -- ✅ [버그 수정] ESC/Tab 메뉴를 열고 방향키로 탐색하는 이 블록은
                        -- 몇 초씩 걸리는 상태 변경 작업인데, 기존엔 여기 진입 전에 신호를
                        -- 체크하는 지점이 전혀 없었음. 그래서 낚시가 메뉴 조작을 이미 시작한
                        -- 뒤에야 포션 제작/메모리 매치 신호를 만나서 캐릭터 리셋과 메뉴 조작이
                        -- 겹치는 사고가 났음. 시작 전에 먼저 양보한다.
                        YieldFishingForSingleActions()
                        if not Settings.Sols.autoFishActive then continue end

                        SetCurrentAction("낚시 - 클릭 이동 모드 확인/전환 중")
                        if not pathExists then
                            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                            task.wait(1.5)
                            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
                            lastActivityTime = tick() -- [ACT] ESC

                            vim:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
                            task.wait(1.5)
                            vim:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)
                            lastActivityTime = tick() -- [ACT] Tab

                            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                            task.wait(1)
                            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)

                            local success2, result2 = pcall(function()
                                return coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
                                    .PageViewClipper.PageView.PageViewInnerFrame.Page["Movement ModeFrame"].Selector
                                    .Selection3
                            end)
                            if success2 and result2 and result2.Position == UDim2.new(0, 32, 0, 0) then
                                proceed = true
                            end
                        else
                            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                            task.wait(1.5)
                            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
                            lastActivityTime = tick() -- [ACT] ESC

                            vim:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
                            task.wait(1.5)
                            vim:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)
                            lastActivityTime = tick() -- [ACT] Tab

                            local hoverSuccess = false
                            if selector then
                                for i = 1, 50 do
                                    if not Settings.Sols.autoFishActive then break end
                                    vim:SendKeyEvent(true, Enum.KeyCode.Down, false, game)
                                    task.wait(0.35)
                                    vim:SendKeyEvent(false, Enum.KeyCode.Down, false, game)
                                    lastActivityTime = tick() -- [ACT] Down
                                    if selector.GuiState == Enum.GuiState.Hover then
                                        hoverSuccess = true
                                        break
                                    end
                                end

                                if not hoverSuccess and Settings.Sols.autoFishActive then
                                    for i = 1, 50 do
                                        if not Settings.Sols.autoFishActive then break end
                                        vim:SendKeyEvent(true, Enum.KeyCode.Up, false, game)
                                        task.wait(0.35)
                                        vim:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                                        lastActivityTime = tick() -- [ACT] Up
                                        if selector.GuiState == Enum.GuiState.Hover then
                                            hoverSuccess = true
                                            break
                                        end
                                    end
                                end
                            end

                            if hoverSuccess then
                                local targetReached = false
                                while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                    if getgenv().MemoryMatchActive then
                                        task.wait(0.5)
                                        continue
                                    end
                                    local s3 = nil
                                    pcall(function() s3 = selector.Selection3 end)
                                    if s3 and s3.Position == UDim2.new(0, 32, 0, 0) then
                                        targetReached = true
                                        break
                                    end

                                    vim:SendKeyEvent(true, Enum.KeyCode.Right, false, game)
                                    task.wait(1)
                                    vim:SendKeyEvent(false, Enum.KeyCode.Right, false, game)
                                    lastActivityTime = tick() -- [ACT] Right
                                end

                                if targetReached then
                                    task.wait(1)
                                    vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                                    task.wait(1.5)
                                    vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
                                    proceed = true
                                else
                                    break
                                end
                            else
                                Settings.Sols.masterMacroEnabled = false
                                if updateBiomeMacroState then updateBiomeMacroState() end
                                if updateAutoBiomeUseState then updateAutoBiomeUseState() end
                                break
                            end
                        end
                    end

                    if proceed and Settings.Sols.autoFishActive then
                        while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                            if getgenv().MemoryMatchActive then
                                task.wait(0.5)
                                continue
                            end

                            -- ✅ [사용자 요청] Memory Match/Potion Craft/Auto Item Use 중
                            -- 뭐라도 가능할 경우 낚시 투척보다 먼저 우선 실행되도록 통합 체크
                            -- (직접 실행하지 않고, 신호가 사라질 때까지 기다리기만 함)
                            if Settings.Sols and Settings.Sols.masterMacroEnabled then
                                YieldFishingForSingleActions()
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end
                            end

                            if tick() - lastActivityTime > 180 then
                                break
                            end

                            -- ! - 1
                            SetCurrentAction("낚시 - Place1에서 낚싯대 던지는 중")
                            local cam = workspace.CurrentCamera
                            local originalCamCFrame = nil
                            local originalCamType = nil

                            if cam then
                                originalCamType = cam.CameraType
                                originalCamCFrame = cam.CFrame
                                cam.CameraType = Enum.CameraType.Scriptable
                                local p1 = workspace:FindFirstChild("ScriptParts") and
                                    workspace.ScriptParts:FindFirstChild("Place1")
                                if p1 then
                                    cam.CFrame = CFrame.new(p1.Position) * CFrame.Angles(math.rad(-90), 0, 0)
                                else
                                    cam.CFrame = CFrame.new(55, 99, -279) * CFrame.Angles(math.rad(-90), 0, 0)
                                end
                            end

                            task.wait(1)

                            local viewport = workspace.CurrentCamera.ViewportSize
                            local centerX = math.floor(viewport.X / 2)
                            local centerY = math.floor(viewport.Y / 2)

                            showPremiumIndicator(centerX, centerY)
                            vim:SendMouseButtonEvent(centerX, centerY, 1, true, game, 0)
                            task.wait(0.05)
                            vim:SendMouseButtonEvent(centerX, centerY, 1, false, game, 0)
                            lastActivityTime = tick() -- [ACT] Phase1 cast

                            task.wait(0.1)

                            if cam and originalCamCFrame and originalCamType then
                                cam.CFrame = originalCamCFrame
                                cam.CameraType = originalCamType
                            end

                            local p1 = workspace:FindFirstChild("ScriptParts") and
                                workspace.ScriptParts:FindFirstChild("Place1")
                            local touched = false

                            local function checkTouched()
                                local currentHrp = game.Players.LocalPlayer.Character and
                                    game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if currentHrp and p1 and (currentHrp.Position - p1.Position).Magnitude < 10 then
                                    return true
                                end
                                return false
                            end

                            touched = checkTouched()
                            local skipToPhase2 = false

                            if not touched then
                                local isStoppedTime = 0
                                while isStoppedTime < 3 and Settings.Sols.autoFishActive do
                                    task.wait(0.1)
                                    if checkTouched() then
                                        touched = true
                                        break
                                    end
                                    local currentHrp = game.Players.LocalPlayer.Character and
                                        game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if currentHrp and currentHrp.Velocity.Magnitude < 1 then
                                        isStoppedTime = isStoppedTime + 0.1
                                    else
                                        isStoppedTime = 0
                                    end
                                end

                                if not touched then
                                    touched = checkTouched()
                                end

                                if not touched then
                                    local hum = game.Players.LocalPlayer.Character and
                                        game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
                                    if hum then
                                        hum.Health = 0
                                    end
                                    task.wait(5)
                                    skipToPhase2 = true
                                end
                            end

                            if not skipToPhase2 then
                                task.wait(1)

                                -- ! - Flexibility
                                doFlexibility()

                                while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                    if getgenv().MemoryMatchActive then
                                        task.wait(0.5)
                                        continue
                                    end
                                    if tick() - lastActivityTime > 180 then
                                        break
                                    end

                                    SetCurrentAction("낚시 - 물고기 잡히길 기다리는 중")
                                    local n1, n2 = findFishStorageCount()
                                    if n1 ~= -1 and n1 == n2 then
                                        break
                                    end

                                    local mainUI = game.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild(
                                        "MainInterface")
                                    if mainUI then
                                        local clicked = false
                                        local rootImageLabel = nil
                                        for _, img1 in ipairs(mainUI:GetDescendants()) do
                                            if img1:IsA("ImageLabel") and math.abs(img1.BackgroundTransparency - 0.4) < 0.01 then
                                                rootImageLabel = img1
                                                for _, img2 in ipairs(img1:GetDescendants()) do
                                                    if img2:IsA("ImageLabel") then
                                                        local textCount = 0
                                                        for _, ch2 in ipairs(img2:GetChildren()) do
                                                            if ch2:IsA("TextLabel") then
                                                                textCount = textCount + 1
                                                            end
                                                        end

                                                        if textCount == 4 then
                                                            for _, img3 in ipairs(img2:GetDescendants()) do
                                                                if img3:IsA("ImageLabel") and img3:FindFirstChildWhichIsA("UIListLayout") then
                                                                    for _, btn in ipairs(img3:GetChildren()) do
                                                                        if btn:IsA("ImageButton") and btn.LayoutOrder == 0 then
                                                                            clickExactly(btn)
                                                                            clicked = true
                                                                            break
                                                                        end
                                                                    end
                                                                end
                                                                if clicked then break end
                                                            end
                                                        end
                                                    end
                                                    if clicked then break end
                                                end
                                            end
                                            if clicked then break end
                                        end

                                        if rootImageLabel and clicked then
                                            SetCurrentAction("낚시 - 물고기를 낚는 중")
                                            local targetTextLabel = nil
                                            local waitStart = tick()
                                            local safe1Trigger = false

                                            while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                                if getgenv().MemoryMatchActive then
                                                    task.wait(0.5)
                                                    continue
                                                end
                                                if tick() - waitStart > 30 then
                                                    safe1Trigger = true
                                                    break
                                                end
                                                targetTextLabel = nil
                                                for _, subImg1 in ipairs(rootImageLabel:GetDescendants()) do
                                                    if subImg1:IsA("ImageLabel") then
                                                        local imgCount = 0
                                                        for _, c in ipairs(subImg1:GetChildren()) do
                                                            if c:IsA("ImageLabel") then imgCount = imgCount + 1 end
                                                        end
                                                        if imgCount == 3 then
                                                            for _, subImg2 in ipairs(subImg1:GetDescendants()) do
                                                                if subImg2:IsA("ImageLabel") then
                                                                    local txtCount = 0
                                                                    for _, c in ipairs(subImg2:GetChildren()) do
                                                                        if c:IsA("TextLabel") then
                                                                            txtCount = txtCount +
                                                                                1
                                                                        end
                                                                    end
                                                                    if txtCount == 2 then
                                                                        for _, t in ipairs(subImg2:GetChildren()) do
                                                                            if t:IsA("TextLabel") and t.Text == "Click / Touch Screen to Reel" then
                                                                                targetTextLabel = t
                                                                                break
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                                if targetTextLabel then break end
                                                            end
                                                        end
                                                    end
                                                    if targetTextLabel then break end
                                                end

                                                if targetTextLabel and math.abs(targetTextLabel.Position.X.Scale) < 0.01 and math.abs(targetTextLabel.Position.X.Offset) < 0.01 and math.abs(targetTextLabel.Position.Y.Scale) < 0.01 and math.abs(targetTextLabel.Position.Y.Offset) < 0.01 then
                                                    break
                                                end
                                                task.wait(0.1)
                                            end

                                            if safe1Trigger then
                                                -- Fallthrough to Safe 1
                                            else
                                                local function getRepeatA1BarAndZone(root)
                                                    local threeImgParent = nil
                                                    for _, subImg1 in ipairs(root:GetDescendants()) do
                                                        if subImg1:IsA("ImageLabel") then
                                                            local imgCount = 0
                                                            for _, c in ipairs(subImg1:GetChildren()) do
                                                                if c:IsA("ImageLabel") then imgCount = imgCount + 1 end
                                                            end
                                                            if imgCount == 3 then
                                                                threeImgParent = subImg1
                                                                break
                                                            end
                                                        end
                                                    end
                                                    if not threeImgParent then return nil, nil end

                                                    local aspectParent = nil
                                                    for _, subImg2 in ipairs(threeImgParent:GetDescendants()) do
                                                        if subImg2:IsA("ImageLabel") and subImg2:FindFirstChildWhichIsA("UIAspectRatioConstraint") then
                                                            aspectParent = subImg2
                                                            break
                                                        end
                                                    end
                                                    if not aspectParent then return nil, nil end

                                                    local textParent = nil
                                                    for _, subImg3 in ipairs(aspectParent:GetDescendants()) do
                                                        if subImg3:IsA("ImageLabel") then
                                                            local txtCount = 0
                                                            for _, c in ipairs(subImg3:GetChildren()) do
                                                                if c:IsA("TextLabel") then txtCount = txtCount + 1 end
                                                            end
                                                            if txtCount == 1 then
                                                                textParent = subImg3
                                                                break
                                                            end
                                                        end
                                                    end
                                                    if not textParent then return nil, nil end

                                                    local barImg, zoneInner = nil, nil
                                                    for _, c in ipairs(textParent:GetChildren()) do
                                                        if c:IsA("ImageLabel") and c.ZIndex == 2 then
                                                            barImg = c
                                                        elseif c:IsA("ImageLabel") and c.ZIndex == 1 then
                                                            for _, ch in ipairs(c:GetChildren()) do
                                                                if ch:IsA("ImageLabel") then
                                                                    zoneInner = ch
                                                                    break
                                                                end
                                                            end
                                                        end
                                                    end
                                                    return barImg, zoneInner
                                                end

                                                SetCurrentAction("낚시 - 릴링 미니게임 진행 중")
                                                while targetTextLabel and Settings.Sols.autoFishActive do
                                                    if math.abs(targetTextLabel.Position.X.Scale) < 0.01 and math.abs(targetTextLabel.Position.X.Offset) < 0.01 and math.abs(targetTextLabel.Position.Y.Scale - 1) < 0.01 and math.abs(targetTextLabel.Position.Y.Offset) < 0.01 then
                                                        break
                                                    end

                                                    local barImg, zoneInner = getRepeatA1BarAndZone(rootImageLabel)
                                                    if barImg and zoneInner then
                                                        local leftEdgeX = barImg.AbsolutePosition.X
                                                        local barSizeX = barImg.AbsoluteSize.X
                                                        local zoneCenterX = zoneInner.AbsolutePosition.X +
                                                            zoneInner.AbsoluteSize.X / 2

                                                        if zoneCenterX < leftEdgeX then
                                                            local viewport = workspace.CurrentCamera.ViewportSize
                                                            local centerX = math.floor(viewport.X / 2)
                                                            local centerY = math.floor(viewport.Y / 2)
                                                            showPremiumIndicator(centerX, centerY)
                                                            Services.VirtualInputManager:SendMouseButtonEvent(centerX,
                                                                centerY, 0, true, game, 0)
                                                            task.wait(0.01)
                                                            Services.VirtualInputManager:SendMouseButtonEvent(centerX,
                                                                centerY, 0, false, game, 0)
                                                            lastActivityTime = tick() -- [ACT] reel click
                                                        end
                                                    end

                                                    task.wait(0.01)
                                                end

                                                task.wait(2.5)
                                            end

                                            -- ! - Safe 1
                                            SetCurrentAction("낚시 - 잡은 물고기 확인 창 닫는 중")
                                            local clickedClose = false
                                            for _, subImg in ipairs(rootImageLabel:GetDescendants()) do
                                                if subImg:IsA("ImageLabel") and subImg:FindFirstChildWhichIsA("ScrollingFrame") then
                                                    for _, btn in ipairs(subImg:GetDescendants()) do
                                                        if btn:IsA("ImageButton") then
                                                            clickExactly(btn)
                                                            clickedClose = true
                                                            lastActivityTime = tick() -- [ACT] Safe1 close
                                                            break
                                                        end
                                                    end
                                                end
                                                if clickedClose then break end
                                            end

                                            task.wait(0.75)

                                            -- ! - Flexibility
                                            doFlexibility()
                                        else
                                            task.wait(0.5)
                                        end
                                    end
                                    task.wait(0.5)
                                end
                            end

                            if not Settings.Sols.autoFishActive then break end
                            if tick() - lastActivityTime > 180 then continue end -- global restart logic

                            -- ! - 2
                            while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end
                                -- ✅ [사용자 요청] 카메라 조작 직전에 통합 신호를 체크
                                YieldFishingForSingleActions()
                                if not Settings.Sols.autoFishActive then break end
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end
                                cam = workspace.CurrentCamera
                                originalCamCFrame = nil
                                originalCamType = nil

                                SetCurrentAction("낚시 - Place2에서 낚싯대 던지는 중")
                                if cam then
                                    originalCamType = cam.CameraType
                                    originalCamCFrame = cam.CFrame
                                    cam.CameraType = Enum.CameraType.Scriptable
                                    local p2 = workspace:FindFirstChild("ScriptParts") and
                                        workspace.ScriptParts:FindFirstChild("Place2")
                                    if p2 then
                                        cam.CFrame = CFrame.new(p2.Position) * CFrame.Angles(math.rad(-90), 0, 0)
                                    else
                                        cam.CFrame = CFrame.new(109, 107, -296) * CFrame.Angles(math.rad(-90), 0, 0)
                                    end
                                end

                                task.wait(1)

                                local viewport2 = workspace.CurrentCamera.ViewportSize
                                local centerX2 = math.floor(viewport2.X / 2)
                                local centerY2 = math.floor(viewport2.Y / 2)

                                showPremiumIndicator(centerX2, centerY2)
                                vim:SendMouseButtonEvent(centerX2, centerY2, 1, true, game, 0)
                                task.wait(0.05)
                                vim:SendMouseButtonEvent(centerX2, centerY2, 1, false, game, 0)
                                lastActivityTime = tick() -- [ACT] Phase2 cast

                                task.wait(0.1)

                                if cam and originalCamCFrame and originalCamType then
                                    cam.CFrame = originalCamCFrame
                                    cam.CameraType = originalCamType
                                end

                                local p2 = workspace:FindFirstChild("ScriptParts") and
                                    workspace.ScriptParts:FindFirstChild("Place2")
                                local touched2 = false

                                local function checkTouched2()
                                    local currentHrp = game.Players.LocalPlayer.Character and
                                        game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if currentHrp and p2 and (currentHrp.Position - p2.Position).Magnitude < 10 then
                                        return true
                                    end
                                    return false
                                end

                                touched2 = checkTouched2()
                                local phase2Success = false

                                if not touched2 then
                                    local isStoppedTime = 0
                                    while isStoppedTime < 3 and Settings.Sols.autoFishActive do
                                        task.wait(0.1)
                                        if checkTouched2() then
                                            touched2 = true
                                            break
                                        end
                                        local currentHrp = game.Players.LocalPlayer.Character and
                                            game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                        if currentHrp and currentHrp.Velocity.Magnitude < 1 then
                                            isStoppedTime = isStoppedTime + 0.1
                                        else
                                            isStoppedTime = 0
                                        end
                                    end

                                    if not touched2 then
                                        touched2 = checkTouched2()
                                    end

                                    if not touched2 then
                                        local hum = game.Players.LocalPlayer.Character and
                                            game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
                                        if hum then
                                            hum.Health = 0
                                        end
                                        task.wait(5)
                                        continue
                                    else
                                        phase2Success = true
                                    end
                                else
                                    phase2Success = true
                                end

                                if phase2Success then
                                    break
                                end
                            end

                            task.wait(1)

                            -- Flexibility
                            doFlexibility()

                            SetCurrentAction("낚시 - 판매창 여는 중")
                            local fShopParent = findFishingShopFrame()
                            if fShopParent then
                                fShopParent.Visible = true
                            end

                            task.wait(0.75)

                            local fShopParent2 = findFishingShopFrame()
                            if fShopParent2 then
                                local targetFrame = nil
                                for _, ch in ipairs(fShopParent2:GetChildren()) do
                                    if ch:IsA("Frame") and math.abs(ch.Position.X.Scale - 0.995) < 0.05 and math.abs(ch.Position.Y.Scale - 0.09) < 0.05 and math.abs(ch.Size.X.Scale - 0.69) < 0.05 and math.abs(ch.Size.Y.Scale - 0.9) < 0.05 then
                                        targetFrame = ch
                                        break
                                    end
                                end

                                if targetFrame then
                                    for _, desc in ipairs(targetFrame:GetDescendants()) do
                                        if desc:IsA("TextLabel") and string.find(string.lower(desc.Text), "sell") then
                                            clickExactly(desc)
                                            lastActivityTime = tick() -- [ACT] Sell tab
                                            break
                                        end
                                    end
                                end
                            end

                            task.wait(0.5)

                            -- ✅ [사용자 요청] 판매 루프 10분 타임아웃
                            local sellLoopStart = tick()

                            while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end

                                SetCurrentAction("낚시 - 물고기 판매 중")

                                -- ✅ [사용자 요청] 10분이 넘어가면 판매창을 닫고, 캐릭터를
                                -- 재설정한 뒤, Fish 기능을 처음부터 다시 시작한다.
                                if (tick() - sellLoopStart) > 300 then
                                    local timeoutShopParent = findFishingShopFrame()
                                    if timeoutShopParent then timeoutShopParent.Visible = false end

                                    local timeoutHum = game.Players.LocalPlayer.Character and
                                        game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
                                    if timeoutHum then
                                        timeoutHum.Health = 0
                                    end
                                    task.wait(5)

                                    -- ✅ [버그 수정] Luau는 goto/label을 지원하지 않아서, 대신
                                    -- 플래그를 세우고 break로 이 반복문들을 빠져나간다. 이 플래그를
                                    -- 검사하는 나머지 낚시 반복문들도 전부 즉시 빠져나가서 결국
                                    -- 최상위 낚시 반복문까지 도달하면 자동으로 초기화(재시작)된다.
                                    getgenv().FishRestartRequested = true
                                    break
                                end

                                if Settings.Emergency then
                                    local finalShopParent = findFishingShopFrame()
                                    if finalShopParent then finalShopParent.Visible = false end
                                    break
                                end
                                local fShopParent3 = findFishingShopFrame()
                                local targetFrame2 = nil
                                if fShopParent3 then
                                    for _, ch in ipairs(fShopParent3:GetChildren()) do
                                        if ch:IsA("Frame") and math.abs(ch.Position.X.Scale - 0.995) < 0.05 and math.abs(ch.Position.Y.Scale - 0.09) < 0.05 and math.abs(ch.Size.X.Scale - 0.69) < 0.05 and math.abs(ch.Size.Y.Scale - 0.9) < 0.05 then
                                            targetFrame2 = ch
                                            break
                                        end
                                    end
                                end

                                local scrollingFrame = nil
                                if targetFrame2 then
                                    for _, v in ipairs(targetFrame2:GetChildren()) do
                                        if v:IsA("Frame") and v.Visible then
                                            scrollingFrame = v:FindFirstChildWhichIsA("ScrollingFrame")
                                            if scrollingFrame then break end
                                        end
                                    end
                                end

                                local hasFrames = false
                                if scrollingFrame then
                                    for _, ch in ipairs(scrollingFrame:GetChildren()) do
                                        if ch:IsA("Frame") then
                                            hasFrames = true
                                            break
                                        end
                                    end
                                end

                                if not hasFrames then
                                    break
                                end

                                if scrollingFrame then
                                    for _, ch in ipairs(scrollingFrame:GetChildren()) do
                                        if ch:IsA("Frame") and ch.LayoutOrder == 1 then
                                            local imgBtn = ch:FindFirstChildWhichIsA("ImageButton")
                                            if imgBtn then
                                                clickExactly(imgBtn)
                                                lastActivityTime = tick() -- [ACT] item click
                                            end
                                            break
                                        end
                                    end
                                end

                                task.wait(0.5)

                                local fShopParent4 = findFishingShopFrame()
                                if fShopParent4 then
                                    local sellAllBtn = nil
                                    for _, btn in ipairs(fShopParent4:GetDescendants()) do
                                        if btn:IsA("ImageButton") then
                                            local t = btn:FindFirstChildWhichIsA("TextLabel")
                                            if t and string.find(string.lower(t.Text), "sell all") then
                                                sellAllBtn = btn
                                                break
                                            end
                                        end
                                    end
                                    if sellAllBtn then
                                        clickExactly(sellAllBtn)
                                        lastActivityTime = tick() -- [ACT] Sell All
                                    end
                                end

                                task.wait(0.5)

                                local fShopParent5 = findFishingShopFrame()
                                if fShopParent5 then
                                    for _, cgrp in ipairs(fShopParent5:GetDescendants()) do
                                        if cgrp:IsA("CanvasGroup") then
                                            local frm = cgrp:FindFirstChildWhichIsA("Frame")
                                            if frm then
                                                for _, btn2 in ipairs(frm:GetDescendants()) do
                                                    if btn2:IsA("ImageButton") and math.abs(btn2.Position.X.Scale - 0.235) < 0.05 and math.abs(btn2.Position.Y.Scale - 0.5) < 0.05 then
                                                        clickExactly(btn2)
                                                        lastActivityTime = tick() -- [ACT] confirm sell
                                                        break
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end

                                task.wait(1.5)
                            end

                            task.wait(1)

                            local finalShopParent = findFishingShopFrame()
                            if finalShopParent then finalShopParent.Visible = false end

                            task.wait(1)

                            -- ! - Flexibility
                            doFlexibility()

                            -- Loop goes back to ! - 1
                        end
                    end
                end
            end)
        end
    else
        if autoFishConnection then
            task.cancel(autoFishConnection)
            autoFishConnection = nil
        end
        -- ✅ [버그 수정] task.cancel은 코루틴을 강제 종료시켜 자체 정리 코드를 못 돌리므로,
        -- 여기서 직접 자리를 비워줘야 CurrentActiveFeature가 "Fishing"에 영구히 갇히지 않음
        StopMacro("Fishing")
    end
end

