-- 현재 플레이중인 사운드 감지
local function GetCurrentPlayingSound()
    -- [NEW] 1순위: 솔스 탭의 음악 동기화 기능 (HRP 내 BGM 사운드 감시)
    if Settings.Sols.musicSync then
        local char = LocalPlayer.Character or (workspace:FindFirstChild(LocalPlayer.Name))
        if char then
            -- [ADVANCED] 캐릭터 기본 효과음을 제외한 모든 음악 파일 자동 감지
            local excluded = { "Climbing", "Died", "FreeFalling", "GettingUp", "Jumping", "Landing", "Running", "Splash",
                "Swimming" }
            for _, child in ipairs(char:GetDescendants()) do
                if child:IsA("Sound") and child.IsPlaying and child.TimeLength > 0 then
                    if not table.find(excluded, child.Name) then
                        child.Volume = 1 -- 음악 볼륨 1 고정
                        return child
                    end
                end
            end
        end
    end

    -- 2순위: 기존 Funny 음악 기능
    if getgenv and getgenv().FunnyMusicPlaying and getgenv().CurrentFunnyMusic and getgenv().CurrentFunnyMusic ~= "" then
        local funnySound = game:GetService("CoreGui"):FindFirstChild(getgenv().CurrentFunnyMusic)
        if funnySound and funnySound:IsA("Sound") and funnySound.IsPlaying and funnySound.TimeLength > 0 then
            return funnySound
        end
    end
    return nil
end

