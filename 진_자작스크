            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- 가장 가까운 지정 먹이 탐색
            local closestItem = nil
            local minDistance = math.huge
            for _, item in ipairs(itemsFolder:GetChildren()) do
                if item:IsA("Model") and item.Name == selectedFood and not foodBlacklist[item] then
                    local itemPivot = item:GetPivot()
                    local dist = (hrp.Position - itemPivot.Position).Magnitude
                    -- 25스터드 이내의 것은 무시
                    if dist < minDistance and dist >= 25 then
                        minDistance = dist
                        closestItem = item
                    end
                end
            end

            if not closestItem then
                warn("가까운 " .. selectedFood .. "을(를) 찾을 수 없습니다.")
                return
            end

            -- 로딩 스크린 생성
            local loadingGui = Instance.new("ScreenGui")
            loadingGui.Name = "FoodLoadingScreen"
