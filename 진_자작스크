local function useSpecificItemByName(itemName)
    local inventory = LocalPlayer.PlayerGui.MainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
        inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
    if not scrollingFrame then return false end

    local targetItem = nil
    for _, item in pairs(scrollingFrame:GetChildren()) do
        if item.Name == itemName or item:FindFirstChild(itemName, true) then
            targetItem = item
        else
            for _, desc in pairs(item:GetDescendants()) do
                if desc:IsA("TextLabel") and string.find(desc.Text, itemName) then
                    targetItem = item
                    break
                end
            end
        end
        if targetItem then break end
    end

    if targetItem then
        clickExactly(targetItem)
        task.wait(0.5)
        local itemIndex = inventory:WaitForChild("Index"):WaitForChild("ItemIndex")
        local useAmount = itemIndex:WaitForChild("UseHolder"):WaitForChild("UseAmount")
        local useButton = itemIndex.UseHolder:WaitForChild("UseButton")

        if useAmount.Text == "1" then
            clickExactly(useButton)
        else
            useAmount.Text = "1"
            if useAmount:IsA("TextBox") then useAmount:ReleaseFocus() end
            task.wait(0.25)
            clickExactly(useButton)
        end
        return true
    end
    return false
end

local function useSpecificItemByNameWithAmount(itemName, useAmountNum)
    local inventory = LocalPlayer.PlayerGui.MainInterface:FindFirstChild("Inventory")
    if not inventory then return false end

    local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
        inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
    if not scrollingFrame then return false end

    local targetItem = nil
    local currentAmount = 0
    for _, item in pairs(scrollingFrame:GetChildren()) do
        if item.Name == itemName or item:FindFirstChild(itemName, true) then
            targetItem = item
        else
            for _, desc in pairs(item:GetDescendants()) do
                if desc:IsA("TextLabel") and string.find(desc.Text, itemName) then
                    targetItem = item
                    break
                end
            end
        end
        if targetItem then
            -- Try to parse amount
            local btn = targetItem:FindFirstChild("Button")
            if btn and btn:FindFirstChild("ItemAmount") then
                local txt = btn.ItemAmount.Text
                -- e.g., 'x15' -> 15
                local num = txt:match("x(%d+)")
                if num then currentAmount = tonumber(num) end
            end
            break
        end
    end

    if targetItem then
        if currentAmount <= 0 then currentAmount = 1 end -- fallback
        local amountToUse = currentAmount
        if useAmountNum ~= "ALL" and type(useAmountNum) == "number" then
            if currentAmount > useAmountNum then
                amountToUse = useAmountNum
            end
        end

        clickExactly(targetItem)
        task.wait(0.5)
        local itemIndex = inventory:WaitForChild("Index"):WaitForChild("ItemIndex")
        local useAmountBox = itemIndex:WaitForChild("UseHolder"):WaitForChild("UseAmount")
        local useButton = itemIndex.UseHolder:WaitForChild("UseButton")

        useAmountBox.Text = tostring(amountToUse)
        if useAmountBox:IsA("TextBox") then useAmountBox:ReleaseFocus() end
        task.wait(0.25)
        clickExactly(useButton)
        task.wait(0.77)
        return true
    end
    return false
end

local function performRareBiomePopSequence(biomeName)
    if not Settings.Sols.autoRareBiomePop then return end

    if biomeName == "GLITCHED" and not Settings.Sols.popGlitched then return end
    if biomeName == "DREAMSPACE" and not Settings.Sols.popDreamspace then return end
    if biomeName == "CYBERSPACE" and not Settings.Sols.popCyberspace then return end

    -- 1. 대기 및 시작
    Settings.Emergency = true
    StartMacro("Emergency")

    -- 버그 수정: 기존에는 낚시 중일 때만 안전 지점(EmergencyReady)까지 기다렸고,
    -- 메모리 매치만 단독으로 돌고 있을 땐 무조건 2초만 대기 후 캐릭터를 강제 리스폰시켜
    -- 카드 게임 도중에 끊기는 문제가 있었음. Memory Match 진행 중에도 안전 지점을 기다리도록 확장.
    -- ✅ [사용자 요청] 포션 자동 제작 진행 중에도 동일하게 안전 지점까지 기다려준다.
    if (Settings.Sols and Settings.Sols.autoFishActive) or getgenv().MemoryMatchActive or MacroPriority.IsActive.PotionCraft then
        local waitLimit = 60
        local elapsed = 0
        while not Settings.EmergencyReady and elapsed < waitLimit do
            task.wait(0.5)
            elapsed = elapsed + 0.5
        end
    else
        task.wait(2)
    end

    -- 캐릭터 재설정
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.Health = 0
    end

    -- Wait for character respawn
    task.wait(0.5)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)

    -- 2. 인벤토리 열기
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then
        Settings.Emergency = false; StopMacro("Emergency"); return
    end

    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in pairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    clickExactly(btn)
                    task.wait(0.8)
                    break
                end
            end
        end
    end
    if not inventory.Visible then
        Settings.Emergency = false; StopMacro("Emergency"); return
    end
    task.wait(0.5)

    -- ItemsTab 클릭
    local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
    if itemsTab then clickExactly(itemsTab) end
    task.wait(0.3)

    -- LayoutOrder 10001 (포션류) 필터
    local quickCategory = inventory:FindFirstChild("QuickCategory")
    if quickCategory then
        for _, btn in pairs(quickCategory:GetChildren()) do
            if btn:IsA("ImageButton") and btn.LayoutOrder == 10001 then
                clickExactly(btn)
                break
            end
        end
    end

    -- 아이템 정렬 2초 대기
    task.wait(2)

    -- 2-1. 아이템 종류별 우선순위 파악 및 사용
    local function hasItem(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return false end
        for _, item in pairs(scrollingFrame:GetChildren()) do
            if item.Name == itemName or item:FindFirstChild(itemName, true) then return true end
            for _, desc in pairs(item:GetDescendants()) do
                if desc:IsA("TextLabel") and string.find(desc.Text, itemName) then return true end
            end
        end
        return false
    end

    local function getAmount(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return 0 end
        for _, item in pairs(scrollingFrame:GetChildren()) do
            local matched = false
            if item.Name == itemName or item:FindFirstChild(itemName, true) then
                matched = true
            else
                for _, desc in pairs(item:GetDescendants()) do
                    if desc:IsA("TextLabel") and string.find(desc.Text, itemName) then
                        matched = true
                        break
                    end
                end
            end
            if matched then
                local btn = item:FindFirstChild("Button")
                if btn and btn:FindFirstChild("ItemAmount") then
                    local txt = btn.ItemAmount.Text
                    local num = txt:match("x(%d+)")
                    if num then return tonumber(num) end
                end
                return 1 -- fallback if it exists but no xNum
            end
        end
        return 0
    end

    if biomeName == "GLITCHED" or biomeName == "DREAMSPACE" then
        if hasItem("Warp Potion") then
            useSpecificItemByNameWithAmount("Warp Potion", 1)
        end
        if hasItem("Oblivion Potion") then
            useSpecificItemByNameWithAmount("Oblivion Potion", "ALL")
        end
        if hasItem("Godlike Potion") then
            useSpecificItemByNameWithAmount("Godlike Potion", "ALL")
        end
        if hasItem("Heavenly Potion") then
            useSpecificItemByNameWithAmount("Heavenly Potion", "ALL")
        end
        if hasItem("Potion of Bound") then
            useSpecificItemByNameWithAmount("Potion of Bound", "ALL")
        end
        if hasItem("Popping Potion") then
            useSpecificItemByNameWithAmount("Popping Potion", "ALL")
        end
    elseif biomeName == "CYBERSPACE" then
        local warpAmount = getAmount("Warp Potion")
        local hasTrans = hasItem("Transcendent Potion")

        if warpAmount >= 10 then
            useSpecificItemByNameWithAmount("Warp Potion", 10)
        elseif warpAmount < 10 and hasTrans then
            useSpecificItemByNameWithAmount("Transcendent Potion", 1)
        elseif warpAmount < 10 and not hasTrans and warpAmount > 0 then
            useSpecificItemByNameWithAmount("Warp Potion", 10)
        end
    end

    task.wait(1)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end

    Settings.Emergency = false
    StopMacro("Emergency")
end


-- (lastStrangeControllerUse / lastBiomeRandomizerUse는 파일 앞쪽으로 옮겨졌음 - 상태 UI에서도 참조하기 위함)

task.spawn(function()
    local lastTick = tick()
    while true do
        local now = tick()
        local dt = now - lastTick
        lastTick = now

        if Settings and Settings.Emergency then
            lastStrangeControllerUse = lastStrangeControllerUse + dt
            lastBiomeRandomizerUse = lastBiomeRandomizerUse + dt
        end

        -- ✅ [사용자 요청] Auto Item Use가 스스로 감시하다가 쿨타임이 찼을 때
        -- Flexibility(낚시)에 신호를 보내는 방식. 낚시는 이 플래그만 읽으면 되고
        -- 매번 직접 타이머를 계산할 필요가 없음.
        if Settings and Settings.Sols and Settings.Sols.autoBiomeUseReady and Settings.Sols.masterMacroEnabled then
            local nowCheck = tick()
            getgenv().AutoItemUseWantsSlot = (nowCheck - lastStrangeControllerUse) >= (10.5 * 60)
                or (nowCheck - lastBiomeRandomizerUse) >= (18 * 60)
        else
            getgenv().AutoItemUseWantsSlot = false
        end

        task.wait(0.1)
    end
end)

local function performBiomeAutoSequence(force)
    local now = tick()
    local useStrange = (now - lastStrangeControllerUse) >= (10.5 * 60)
    local useBiome = (now - lastBiomeRandomizerUse) >= (18 * 60)

    if not useStrange and not useBiome then return end

    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return end

    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in pairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    clickExactly(btn)
                    task.wait(0.8)
                    if Settings.Emergency or getgenv().MemoryMatchActive then
                        if inventory and inventory.Visible then inventory.Visible = false end
                        return
                    end
                    if not (force or Settings.Sols.autoBiomeUse) then return end
                    break
                end
            end
        end
    end
    if not inventory.Visible then return end
    task.wait(0.5)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
    if itemsTab then clickExactly(itemsTab) end
    task.wait(0.3)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    local quickCategory = inventory:FindFirstChild("QuickCategory")
    if quickCategory then
        for _, btn in pairs(quickCategory:GetChildren()) do
            if btn:IsA("ImageButton") and btn.LayoutOrder == 30001 then
                clickExactly(btn)
                break
            end
        end
    end

    task.wait(2)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    if useStrange then
        useSpecificItemByName("Strange Controller")
        lastStrangeControllerUse = tick()
        task.wait(0.75)
    end

    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    if useBiome then
        useSpecificItemByName("Biome Randomizer")
        lastBiomeRandomizerUse = tick()
    end

    task.wait(0.5)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end
end

-- 아이템 사용 실행 루프 - RegisterSingleAction 등록 방식으로 배선.
-- forceInitialRun=false: 순수 쿨타임 기반이라 "진짜 쿨타임이 찼을 때만" 실행해야 함
-- (Memory Match/Potion Craft처럼 "켜지면 일단 한 번"은 여기선 부적절 - 쿨타임 무시하고
-- 아이템을 낭비하게 됨).
RegisterSingleAction({
    name = "AutoItemUse",
    signalFlagName = "AutoItemUseWantsSlot",
    logName = "아이템 사용",
    forceInitialRun = false,
    isEnabled = function()
        return Settings.Sols.autoBiomeUseReady and Settings.Sols.masterMacroEnabled and not getgenv().MemoryMatchActive
    end,
    isSignaled = function()
        local now = tick()
        return (now - lastStrangeControllerUse) >= (10.5 * 60) or (now - lastBiomeRandomizerUse) >= (18 * 60)
    end,
    run = function()
        StartMacro("AutoItemUse")
        -- ✅ force=true 필수: performBiomeAutoSequence 내부의 (force or Settings.Sols.autoBiomeUse)
        -- 체크에서, autoBiomeUse는 낚시가 켜지면 항상 false로 강제되는 값이라 여기서
        -- force 없이 부르면 아무것도 안 하고 즉시 return해버림 (자세한 배경은
        -- RegisterSingleAction 정의부 규칙 설명 참고)
        pcall(performBiomeAutoSequence, true)
        StopMacro("AutoItemUse")
        -- ⚠️ 여기서 StartMacro("Fishing")을 부르지 않는다 - 위의 "run() 안에서 지켜야
        -- 할 규칙 2" 참고. 자리는 비워두고, 낚시가 스스로 신호가 사라진 걸 확인하고
        -- 자리를 되찾아가게 둔다.
    end
})

