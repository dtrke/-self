-- 매크로를 꺼도 텍스트/이미지는 다 투명해지는데 구분선 4개만 계속 옅게 남아있는
-- 문제가 있었음. 구분선은 텍스트/이미지와 목표 투명도가 다르므로(0.9 vs 0) 별도
-- 리스트로 관리한다.
local AllDividers = { divider1, divider2, divider3, divider4 }

local function FadeStatusUI(shouldShow)
    if shouldShow == statusUIVisible then return end
    statusUIVisible = shouldShow

    local targetFrameTransparency = shouldShow and TargetFrameTransparency or 1
    local targetTextTransparency = shouldShow and 0 or 1
    local targetDividerTransparency = shouldShow and DIVIDER_VISIBLE_TRANSPARENCY or 1

    TweenService:Create(StatusFrame, StatusFadeInfo, { BackgroundTransparency = targetFrameTransparency }):Play()
    for _, label in ipairs(AllStatusLabels) do
        TweenService:Create(label, StatusFadeInfo, { TextTransparency = targetTextTransparency }):Play()
    end
    for _, divider in ipairs(AllDividers) do
        TweenService:Create(divider, StatusFadeInfo, { BackgroundTransparency = targetDividerTransparency }):Play()
    end
    for _, child in ipairs(ExcludedItemsContainer:GetChildren()) do
        if child:IsA("ImageLabel") then
            TweenService:Create(child, StatusFadeInfo, { ImageTransparency = targetTextTransparency }):Play()
        elseif child:IsA("TextLabel") then
            TweenService:Create(child, StatusFadeInfo, { TextTransparency = targetTextTransparency }):Play()
        end
    end
end

-- 이미 만들어둔 아이콘들을 재사용하기 위한 캐시 (매번 새로 만들고 지우면 페이드가 매번
-- 끊기고, GC 부담도 생기므로 이름 기준으로 캐시해서 필요한 것만 추가/삭제한다)
local excludedIconCache = {}

local function RefreshExcludedItemIcons()
    local excluded = Settings.Sols.memoryMatchExcludedItems or {}
    local activeNames = {}

    for _, def in pairs(MemoryMatchItemDefinitions) do
        if excluded[def.imageId] then
            activeNames[def.name] = true
            if not excludedIconCache[def.name] then
                -- ✅ [사용자 요청] 글자(이름) 없이 이미지만 표시
                local iconImage = Instance.new("ImageLabel")
                iconImage.Name = "Icon_" .. def.name
                iconImage.LayoutOrder = 1
                iconImage.Size = UDim2.new(0, 44, 0, 44)
                iconImage.BackgroundTransparency = 1
                iconImage.Image = def.imageId
                iconImage.ZIndex = 1001
                iconImage.ImageTransparency = statusUIVisible and 0 or 1
                iconImage.Parent = ExcludedItemsContainer

                excludedIconCache[def.name] = iconImage
            end
        end
    end

    -- 더 이상 제외 목록에 없는 아이콘은 제거
    for name, iconInstance in pairs(excludedIconCache) do
        if not activeNames[name] then
            iconInstance:Destroy()
            excludedIconCache[name] = nil
        end
    end

    return next(activeNames) ~= nil
end

