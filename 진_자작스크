-- [ 포션 자동 제작 - 뼈대 ]
-- =============================
-- ✅ [뼈대] Memory Match/Auto Item Use와 동일한 "단일성" 패턴:
--   - Fish가 돌고 있으면: Flexibility 지점에서 자리를 양보받아 실행
--   - Fish가 없으면: 다른 단일성 행동(Memory Match, Auto Item Use)이 끝날 때까지 기다렸다가 실행
--   - 이 기능이 실행되는 동안엔: StartMacro("PotionCraft")로 자리를 쥐고 다른 행동을 막음
-- 실제 "포션 제작 UI를 찾아서 클릭하는" 로직은 아직 정해지지 않아 TODO로 남겨둠.
-- getgenv().PotionCraftWantsSlot 을 true로 세팅하는 실제 감지 조건(예: 재료 충분/제작 가능 UI 감지 등)이
-- 정해지면 IsPotionCraftSignaled() 안에 채워 넣으면 됨.
local function IsPotionCraftSignaled()
    if not (Settings.Sols and Settings.Sols.autoPotionCraft and Settings.Sols.masterMacroEnabled) then
        return false
    end
    if MacroPriority.IsActive.PotionCraft then
        return true
    end
    -- TODO: 실제 "포션 제작 가능/필요" 감지 조건을 여기에 채워넣기
    -- (예: 재료 개수 확인, 특정 UI 버튼 감지 등)
    return getgenv().PotionCraftWantsSlot == true
end

-- 낚시가 포션 자동 제작 신호에게 자리를 양보(대기)하는 함수. Memory Match 양보와 동일한 패턴.
local function YieldFishingForPotionCraft()
    if not IsPotionCraftSignaled() then return end

    local prevFlex = getgenv().IsFlexibilityState
    getgenv().IsFlexibilityState = true
    StopMacro("Fishing")

    while IsPotionCraftSignaled() do
        if not Settings.Sols.autoFishActive then break end
        task.wait(0.5)
    end

    getgenv().IsFlexibilityState = prevFlex or false
    if Settings.Sols.autoFishActive then StartMacro("Fishing") end
end

-- ✅ [사용자 요청] 하나로 통합된 "낚시가 지금 양보해야 하는가" 체크.
-- Memory Match / Potion Craft / Auto Item Use 신호를 한 번에 확인해서, 낚시 흐름의
-- 모든 지점(메뉴 조작, 이동, 카메라 조작 등)에서 일관되게 사용한다. 기존엔 지점마다
-- 서로 다른 개별 체크(Memory Match만, Potion Craft만)를 따로 넣다 보니, 체크가 없는
-- 구간(ESC/Tab 메뉴 조작, 캐스팅 장소까지 이동)에서 신호를 완전히 놓치는 문제가 있었음.
local function IsAnySingleActionSignaled()
    return IsMemoryMatchSignaledFast() or IsPotionCraftSignaled() or getgenv().AutoItemUseWantsSlot == true
end

-- 낚시가 "단일성 행동" 신호에게 자리를 양보(대기)하는 통합 함수.
-- 신호가 없으면 즉시 리턴, 있으면 자리를 반납하고 모든 신호가 완전히 사라질 때까지
-- 대기한 뒤 자리를 되찾는다. 낚시 흐름 어디서든 이 함수 하나만 부르면 됨.
local function YieldFishingForSingleActions()
    if not IsAnySingleActionSignaled() then return end

    SetCurrentAction("낚시 - 다른 기능에 자리 양보 중")
    local prevFlex = getgenv().IsFlexibilityState
    getgenv().IsFlexibilityState = true
    StopMacro("Fishing")

    while IsAnySingleActionSignaled() do
        if not Settings.Sols.autoFishActive then break end
        task.wait(0.5)
    end

    getgenv().IsFlexibilityState = prevFlex or false
    if Settings.Sols.autoFishActive then
        StartMacro("Fishing")
        SetCurrentAction("낚시 - 자리 되찾음, 이어서 진행")
    end
end

-- ✅ [치명적 버그 수정] CanStartMacro가 통과해도, 그건 "지금 자리가 비어있다"는 뜻일
-- 뿐이지 실제로 자리가 비워졌다는 보장은 아니다(자리를 쥔 쪽은 자기 코드 안의
-- 체크포인트에 도달해야만 신호를 알아채고 StopMacro를 부름). 그래서 신호부터 세우고,
-- 자리가 실제로 비워졌다는 게 확인될 때까지 기다린 뒤에야 진행해야 함.
--
-- ✅ [치명적 버그 수정 #2] 기존엔 오직 "Fishing"이 자리를 쥐고 있는지만 체크했음.
-- 그래서 낚시가 아니라 다른 단일성 행동(예: 포션 제작)이 자리를 쥐고 있을 때는
-- "낚시가 없으니 됐다"고 오판하고 그냥 진행해버려서, 실제로 자리를 쥔 쪽과
-- 충돌하거나(둘 다 뭔가 하려다 서로 CanStartMacro에 막혀 아무 것도 못 하고 대기만
-- 반복) 매크로 전체가 진행이 안 되는 상태에 빠질 수 있었음. 이제 "나 자신이 아닌
-- 무엇이든 자리를 쥐고 있으면" 기다리도록 일반화해서, 토글 순서(우선순위)를 지키며
-- 순서대로 자리가 넘어가게 한다.
--
-- 이 함수는 낚시/Memory Match/Potion Craft/Auto Item Use 등 모든 "단일성 행동"이
-- 공용으로 쓴다.
-- myName: 자기 자신의 매크로 이름 (예: "MemoryMatch", "PotionCraft", "AutoItemUse").
--         낚시가 자리를 요청할 때는 nil로 두면 "Fishing"이 아닌 다른 어떤 것도 기다림.
-- signalFlagName: 세울 플래그 이름 (예: "MemoryMatchWantsSlot", "PotionCraftWantsSlot")
-- logPrefix: 로그에 찍을 이름표
local function WaitForFishingToYield(signalFlagName, logPrefix, myName)
    if signalFlagName then
        getgenv()[signalFlagName] = true
    end

    local function someoneElseHoldingSlot()
        local holder = MacroPriority.CurrentActive
        if not holder then return false end
        if myName and holder == myName then return false end
        return MacroPriority.IsActive[holder] == true
    end

    if not someoneElseHoldingSlot() then return true end

    local waitStart = tick()
    while someoneElseHoldingSlot() and (tick() - waitStart) < 60 do
        task.wait(0.2)
    end
    local yielded = not someoneElseHoldingSlot()
    return yielded
end

-- ✅ [사용자 요청] "단일성 행동"(메모리 매치, 포션 제작, 아이템 사용처럼 반복이 아니라
-- 신호가 오면 한 번 실행하고 끝나는 것들)을 새로 추가할 때마다 6~7군데를 손으로 다
-- 배선해야 했음 - 하나라도 빠뜨리면 데드락/충돌이 났었음. 이제 이 함수 하나로 등록만
-- 하면 신호 감지 → 낚시 자리 양보 요청 → 최초 1회 강제 실행 → 감시 루프까지 전부
-- 자동으로 배선된다.
--
-- ⚠️ run() 안에서 지켜야 할 규칙 (안 지키면 데드락 남):
--   1. run() 내부에서 StartMacro(name) / StopMacro(name)을 직접 호출할 것
--      (RegisterSingleAction 자체는 Start/Stop을 대신 불러주지 않음)
--   2. 절대로 run() 끝에서 StartMacro("Fishing")을 호출하지 말 것 - 자리 소유권은
--      반드시 "그 자리를 넘겨줬던 코루틴 자신"만 되찾아야 함. 낚시는 자기 스스로
--      신호가 사라진 걸 확인하고 자리를 되찾아간다. 제3자가 대신 되찾아주면
--      "자리는 있는데 진짜 주인은 모르는" 상태가 되어 서로 영원히 기다리는
--      데드락이 발생함.
--
-- config 필드:
--   name             (필수) 매크로 이름. MacroPriority.IsActive/CanStartMacro/StartMacro/
--                     StopMacro에서 쓰는 그 이름과 정확히 같아야 함 (예: "PotionCraft").
--   signalFlagName   (필수) getgenv()에 세울 신호 플래그 이름 (예: "PotionCraftWantsSlot").
--   isEnabled        (필수) function() -> boolean : 토글이 켜져 있는지 (masterMacroEnabled 포함해서 반환)
--   isSignaled       (필수) function() -> boolean : 지금 신호(할 일)가 있는지. 매 틱 호출되므로
--                     여기서 캐시된 플래그를 갱신하는 부수효과를 넣어도 됨 (Memory Match 참고).
--   run              (필수) function() : 실제로 한 번 실행하는 함수. 위의 규칙 1, 2를 반드시 지킬 것.
--   logName          (선택) 로그에 찍을 한글 이름표. 없으면 name을 그대로 씀.
--   tickInterval     (선택) 감시 주기(초). 기본 1초.
--   forceInitialRun  (선택) 토글이 켜진 직후 신호 여부와 무관하게 무조건 한 번 실행할지.
--                     기본 true (Memory Match/Potion Craft처럼 "켜지면 일단 해보는" 성격).
--                     Auto Item Use처럼 순수 타이머/쿨타임 기반이라 "진짜 신호가 있을 때만"
--                     실행해야 하는 기능은 false로 끌 것.
--   onDisable        (선택) function() : 토글이 꺼졌을 때 추가로 정리할 게 있으면 여기에.
--
-- 반환값: 없음 (task.spawn으로 즉시 감시 루프가 시작됨)
-- ✅ [사용자 요청] 등록된 모든 단일성 행동의 "지금 신호가 있는가"를 한곳에서 조회할 수
-- 있게 하는 레지스트리. 최초 실행 순서가 파일 안에서 spawn된 순서(=우연)에 좌우되지
-- 않고, 토글 순서(우선순위)를 실제로 지키게 하기 위해 필요함.
local RegisteredSingleActions = {}

local function RegisterSingleAction(config)
    local name = config.name
    local signalFlagName = config.signalFlagName
    local logName = config.logName or name
    -- ✅ 기본값 true: 토글이 켜진 뒤 "처음 한 번"은 신호 여부와 무관하게 무조건 실행.
    -- MemoryMatch/PotionCraft처럼 "켜지면 일단 한 번 해보는" 성격의 기능에 적합.
    -- AutoItemUse처럼 "쿨타임이 진짜로 찼을 때만" 실행해야 하는 타이머 기반 기능은
    -- forceInitialRun = false로 꺼서, 신호(쿨타임)가 실제로 있을 때만 실행하게 한다.
    local forceInitialRun = (config.forceInitialRun ~= false)

    table.insert(RegisteredSingleActions, { name = name, isSignaled = config.isSignaled, isEnabled = config.isEnabled })

    task.spawn(function()
        -- 이미 최초 1회를 실행했는지 여부. forceInitialRun이 false인 기능은 처음부터
        -- true로 시작해서 "최초 강제 실행" 단계 자체를 건너뛰고 바로 신호 기반으로 동작.
        local hasRunInitial = not forceInitialRun

        -- ✅ [치명적 버그 수정] 여러 단일성 행동을 동시에 켰을 때, 최초 실행 순서가
        -- "누가 파일에서 먼저 task.spawn 됐는지"(=우연, 파일 위치순)에 좌우되어 토글
        -- 순서(우선순위)가 완전히 무시됐었음. 이 체크를 "최초 실행일 때만" 적용했던
        -- 게 진짜 문제: 매크로를 켠 지 오래 지나서 두 기능의 신호가 거의 동시에 뜨면
        -- (예: 메모리 매치와 아이템 사용의 쿨타임이 우연히 겹치는 경우), 최초 실행이
        -- 아니므로 이 우선순위 체크를 안 거치고 "먼저 도착한 쪽이 그냥 이겨버리는"
        -- 문제가 있었음. 이제 최초 실행 여부와 무관하게, run()을 시도하기 전에는
        -- 항상 나보다 우선순위 높은 것이 신호를 보내는지 확인하고 먼저 양보한다.
        local function higherPriorityIsBusy()
            local myPriority = GetMacroPriorityRule(name)
            for _, other in ipairs(RegisteredSingleActions) do
                if other.name ~= name and GetMacroPriorityRule(other.name) < myPriority
                    and other.isEnabled() and other.isSignaled() then
                    return true
                end
            end
            return false
        end

        while true do
            task.wait(config.tickInterval or 1)

            if config.isEnabled() then
                local signaled = config.isSignaled()

                if not hasRunInitial then
                    if higherPriorityIsBusy() then
                        -- 조용히 다음 틱에 재시도 (매초 로그로 도배되지 않게 함)
                    elseif CanStartMacro(name) then
                        if WaitForFishingToYield(signalFlagName, logName .. " 루프", name) then
                            hasRunInitial = true
                            config.run()
                        end
                        -- 자리를 못 비워주면 조용히 다음 틱에 재시도
                    end
                    -- CanStartMacro가 막히면(다른 게 이미 자리를 쥐고 있음) 조용히 다음 틱에 재시도
                elseif signaled and not higherPriorityIsBusy() then
                    if WaitForFishingToYield(signalFlagName, logName .. " 루프", name) then
                        config.run()
                    end
                end
            else
                hasRunInitial = not forceInitialRun
                if signalFlagName then
                    getgenv()[signalFlagName] = false
                end
                if MacroPriority.IsActive[name] then
                    StopMacro(name)
                end
                if config.onDisable then
                    config.onDisable()
                end
            end
        end
    end)
end

