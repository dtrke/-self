SVTab.Button({
    Text = "맵 전부 해금하기",
    Callback = function()
        task.spawn(function()
            local loadingGui = Instance.new("ScreenGui")
            loadingGui.Name = "SVMapLoadingScreen"
            loadingGui.IgnoreGuiInset = true
            loadingGui.ResetOnSpawn = false
            -- Safe parent to CoreGui or PlayerGui
            local coreGui = game:GetService("CoreGui")
            if coreGui then
                loadingGui.Parent = coreGui
            else
                loadingGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
            end

            local TweenService = game:GetService("TweenService")

            local bgFrame = Instance.new("Frame")
            bgFrame.Size = UDim2.new(1, 0, 1, 0)
            bgFrame.BackgroundColor3 = Color3.new(0, 0, 0)
            bgFrame.BackgroundTransparency = 1
            bgFrame.Parent = loadingGui

            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = "Working..."
            textLabel.TextColor3 = Color3.new(1, 1, 1)
            textLabel.TextTransparency = 1
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.TextScaled = true
            textLabel.Parent = bgFrame

            local textSizeConstraint = Instance.new("UITextSizeConstraint")
            textSizeConstraint.MaxTextSize = 80
            textSizeConstraint.Parent = textLabel

            local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(bgFrame, tweenInfo, { BackgroundTransparency = 0 }):Play()
            TweenService:Create(textLabel, tweenInfo, { TextTransparency = 0 }):Play()
            task.wait(0.5)

            local islands = workspace:FindFirstChild("Islands")
            if not islands then
                warn("Islands 폴더를 찾을 수 없습니다.")
                loadingGui:Destroy()
                return
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                loadingGui:Destroy()
                return
            end

            local originalCFrame = hrp.CFrame

            local isTeleporting = true
            task.spawn(function()
                local vim = game:GetService("VirtualInputManager")
                while isTeleporting do
                    task.wait(0.5)
                    vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end
            end)

            local platform = Instance.new("Part")
            platform.Size = Vector3.new(10, 1, 10)
            platform.Anchored = true
            platform.Transparency = 1
            platform.CanCollide = true
            platform.Parent = workspace

            local RunService = game:GetService("RunService")

            -- 안티치트 우회용 분할 순간이동
            local function bypassTeleport(targetCFrame)
                local currentCharacter = LocalPlayer.Character
                local currentHrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
                if not currentHrp then return end

                local maxStep = 50 -- 한 프레임당 최대 50스터드 이동
                local startCFrame = currentHrp.CFrame
                local dist = (startCFrame.Position - targetCFrame.Position).Magnitude

                currentHrp.Anchored = true

                local conn = RunService.Stepped:Connect(function()
                    if platform and platform.Parent then
                        platform.CFrame = currentHrp.CFrame - Vector3.new(0, 3.5, 0)
                    end
                end)

                if dist > maxStep then
                    local steps = math.ceil(dist / maxStep)
                    for i = 1, steps do
                        if not currentCharacter or not currentHrp or not currentHrp.Parent then break end
                        local alpha = i / steps
                        currentHrp.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                        RunService.Heartbeat:Wait()
                    end
                end

                if currentHrp and currentHrp.Parent then
                    currentHrp.CFrame = targetCFrame
                    -- 텔레포트가 끝난 뒤 강제로 Anchored를 풉니다 (버그 수정)
                    currentHrp.Anchored = false
                end
                conn:Disconnect()
            end

            local function getTargetCFrame(model)
                local baseParts = model:FindFirstChild("BaseParts")

                if baseParts then
                    for _, v in ipairs(baseParts:GetDescendants()) do
                        if (v:IsA("Model") or v:IsA("BasePart")) and v:GetPivot() ~= CFrame.new() then
                            return v:GetPivot()
                        end
                    end
                end

                for _, v in ipairs(model:GetDescendants()) do
                    if v ~= baseParts and (v:IsA("Model") or v:IsA("BasePart")) and v:GetPivot() ~= CFrame.new() then
                        return v:GetPivot()
                    end
                end

                if baseParts then
                    for _, v in ipairs(baseParts:GetDescendants()) do
                        if v:IsA("Model") or v:IsA("BasePart") then
                            return v:GetPivot()
                        end
                    end
                end

                return model:GetPivot()
            end

            task.wait(0.5)
            local startCharacter = LocalPlayer.Character
            local startHrp = startCharacter and startCharacter:FindFirstChild("HumanoidRootPart")
            if startHrp then
                bypassTeleport(CFrame.new(0, startHrp.Position.Y, 0))
            end
            task.wait(0.5)

            while true do
                local currentCharacter = LocalPlayer.Character
                local currentHrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

                -- 만약 캐릭터가 죽었거나 없으면 잠시 대기했다가 다시 찾음
                if not currentHrp then
                    task.wait(0.5)
                    continue
                end

                local found = false

                for _, obj in ipairs(islands:GetChildren()) do
                    -- 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1 은 CFrame.new() 와 동일함
                    if obj:IsA("Model") and obj:GetPivot() == CFrame.new() then
                        found = true

                        -- WorldPivot이 바뀔 때까지 지속적으로 텔레포트 시도
                        while obj.Parent and obj:GetPivot() == CFrame.new() do
                            local cChar = LocalPlayer.Character
                            local cHrp = cChar and cChar:FindFirstChild("HumanoidRootPart")
                            if not cHrp then
                                task.wait(0.5)
                                continue
                            end

                            local tCFrame = getTargetCFrame(obj)
                            bypassTeleport(tCFrame + Vector3.new(0, 3, 0))
                            task.wait(0.2)
                        end
                    end
                end

                -- 조건에 맞는 모델이 없으면 무한루프 종료
                if not found then break end
                task.wait(0.5)
            end

            isTeleporting = false

            task.wait(0.5)
            local endCharacter = LocalPlayer.Character
            local endHrp = endCharacter and endCharacter:FindFirstChild("HumanoidRootPart")
            if endHrp then
                bypassTeleport(CFrame.new(0, endHrp.Position.Y, 0))
            end
            task.wait(0.5)

            -- 원래 위치로 복귀 (캐릭터가 죽지 않고 그대로일 때만)
            if LocalPlayer.Character == char then
                bypassTeleport(originalCFrame + Vector3.new(0, 3, 0))
            end

            -- 복귀 후 만약을 위해 한 번 더 앵커 해제
            local finalChar = LocalPlayer.Character
            local finalHrp = finalChar and finalChar:FindFirstChild("HumanoidRootPart")
            if finalHrp then
                finalHrp.Anchored = false
            end

            if platform then
                platform:Destroy()
            end

            -- 작업 완료 후 로딩 스크린 제거
            if loadingGui then
                local ts = game:GetService("TweenService")
