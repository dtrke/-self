local HitboxModule = {}

function HitboxModule.isValidCharacter(plr)
    return plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
end

function HitboxModule.updateCollision()
    for _, plr in ipairs(Services.Players:GetPlayers()) do
        if plr ~= LocalPlayer and HitboxModule.isValidCharacter(plr) then
            plr.Character.HumanoidRootPart.CanCollide = not Settings.Hitbox.collisionDisabled
        end
    end
end

function HitboxModule.apply()
    for _, plr in ipairs(Services.Players:GetPlayers()) do
        if plr ~= LocalPlayer and HitboxModule.isValidCharacter(plr) then
            local hrp = plr.Character.HumanoidRootPart
            if not Settings.Hitbox.originalSizes[plr] then
                Settings.Hitbox.originalSizes[plr] = hrp.Size
            end
            if Settings.Hitbox.enabled then
                hrp.Size = Vector3.new(Settings.Hitbox.size, Settings.Hitbox.size, Settings.Hitbox.size)
                hrp.Transparency = 0.5
                hrp.Material = Enum.Material.ForceField
            else
                if Settings.Hitbox.originalSizes[plr] then
                    hrp.Size = Settings.Hitbox.originalSizes[plr]
                end
                hrp.Transparency = 1
                hrp.Material = Enum.Material.Plastic
            end
        end
    end
end

Services.Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        HitboxModule.updateCollision()
        HitboxModule.apply()
    end)
end)

