            TweenService:Create(bgFrame, ti, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(textLabel, ti, { TextTransparency = 1 }):Play()
            task.wait(0.5)

            if loadingGui then loadingGui:Destroy() end
        end)
    end
