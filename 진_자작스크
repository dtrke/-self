local function parseHexColor(hexStr)
    if not hexStr or type(hexStr) ~= "string" then return nil end
    hexStr = hexStr:gsub("#", ""):gsub("%s", "")
    if #hexStr == 6 then
        local r = tonumber(hexStr:sub(1, 2), 16)
        local g = tonumber(hexStr:sub(3, 4), 16)
        local b = tonumber(hexStr:sub(5, 6), 16)
        if r and g and b then
            return Color3.fromRGB(r, g, b)
        end
    elseif #hexStr == 3 then
        local r = tonumber(hexStr:sub(1, 1):rep(2), 16)
        local g = tonumber(hexStr:sub(2, 2):rep(2), 16)
        local b = tonumber(hexStr:sub(3, 3):rep(2), 16)
        if r and g and b then
            return Color3.fromRGB(r, g, b)
        end
    end
    return nil
end

local function getVisualizerColor(colorStr)
    if not colorStr then return Color3.new(1, 1, 1) end
    if VisualizerColorMap[colorStr] then
        return VisualizerColorMap[colorStr]
    end
    local parsed = parseHexColor(colorStr)
    if parsed then
        return parsed
    end
    return Color3.new(1, 1, 1)
end

