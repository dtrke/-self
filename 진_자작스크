local function RunAutoMemoryMatchLogic()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
    local MainInterface = PlayerGui:WaitForChild("MainInterface")
    local vim = game:GetService("VirtualInputManager")
    local coreGui = game:GetService("CoreGui")

    -- ✅ [우선순위 시스템] Memory Match 시작 전 우선순위 체크
    if not CanStartMacro("MemoryMatch") then
        return
    end
    
    StartMacro("MemoryMatch")

    if getgenv().CurrentActiveFeature and getgenv().CurrentActiveFeature ~= "MemoryMatch" then
        StopMacro("MemoryMatch")
        return
    end
    getgenv().CurrentActiveFeature = "MemoryMatch"

    -- ✅ [사용자 요청] 콘솔 print 전부 삭제, 오른쪽 상태 UI만 유지. 호출부(50여 곳)를
    -- 일일이 지우는 대신 함수 자체를 no-op으로 바꿔서 안전하게 출력만 없앤다.
    local function myPrint(msg)
    end

    local function checkToggles()
        if not (Settings and Settings.Sols and Settings.Sols.autoMemoryMatch and Settings.Sols.masterMacroEnabled) then
            if getgenv().CurrentActiveFeature == "MemoryMatch" then getgenv().CurrentActiveFeature = nil end
            return false
        end
        return true
    end

    -- GUI 클릭 함수
    local function ClickGui(guiObj)
        if not guiObj then return end
        local absPos = guiObj.AbsolutePosition
        local absSize = guiObj.AbsoluteSize
        if absSize.X <= 0 then return end
        local topBarH = game:GetService("GuiService"):GetGuiInset().Y
        local cx = math.floor(absPos.X + absSize.X / 2)
        local cy = math.floor(absPos.Y + absSize.Y / 2 + topBarH)
        -- ✅ [사용자 요청] 클릭할 때 시각적 표시(이펙트) 추가
        showPremiumIndicator(cx, cy)
        vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
    end

    -- ✅ [최적화] 한 번도 호출되지 않는 죽은 함수 3개(moveToPlace3, clickAdClose, ensureClickToMove)
    -- 제거함 - moveToPlace3AutoFishStyle / executeSolaraAdClick / ensureClickToMoveMode로 대체되어
    -- 실제로는 항상 그쪽만 쓰이고 있었음.

    -- ===========================
    -- 메인 로직 시작
    -- ===========================

    local function isClose(udim, scaleX, scaleY)
        if not udim then return false end
        return math.abs(udim.X.Scale - scaleX) < 0.05 and math.abs(udim.Y.Scale - scaleY) < 0.05
    end

    local function GetFrameA()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                local posMatch = (frame.Position == UDim2.new(0.5, 0, 0.5, 0)) or isClose(frame.Position, 0.5, 0.5)
                local sizeMatch = (frame.Size == UDim2.new(0.300000012, 0, 0.300000012, 0)) or isClose(frame.Size, 0.3, 0.3)
                if posMatch and sizeMatch then
                    return frame
                end
            end
        end

        -- 보완: 하위에 "Start Memory Match" 텍스트를 가진 중앙 프레임 보완 검색
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") and isClose(frame.Position, 0.5, 0.5) then
                if HasStartMemoryMatchText(frame) then
                    return frame
                end
            end
        end
        return nil
    end

    local function GetMemoryMatchMainFrame()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                for _, desc in ipairs(frame:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text == "Memory Match" then
                        return frame
                    end
                end
            end
        end
        return nil
    end

    local function GetFrameB()
        local mainB = GetMemoryMatchMainFrame()
        if not mainB then return nil end
        for _, child1 in ipairs(mainB:GetChildren()) do
            if child1:IsA("Frame") and (child1.Position == UDim2.new(0.995000005, 0, 0.540000021, 0) or isClose(child1.Position, 0.995, 0.54)) then
                for _, child2 in ipairs(child1:GetChildren()) do
                    if child2:IsA("Frame") and child2:FindFirstChildWhichIsA("UIListLayout") then
                        return child2
                    end
                end
            end
        end
        return nil
    end

    local function GetCountLabel()
        local mainB = GetMemoryMatchMainFrame()
        if not mainB then return nil end

        -- B 안의 [ Position {0.00499999989, 0}, {0.540000021, 0}, Size {0.230000004, 0}, {0.899999976, 0} ] Frame - [ Position {0.5, 0}, {0.100000001, 0} ] Frame - [ Position {0.5, 0}, {0.449999988, 0} ] TextLabel
        for _, c1 in ipairs(mainB:GetChildren()) do
            if c1:IsA("Frame") and (c1.Position == UDim2.new(0.00499999989, 0, 0.540000021, 0) or isClose(c1.Position, 0.005, 0.54)) then
                for _, c2 in ipairs(c1:GetChildren()) do
                    if c2:IsA("Frame") and (c2.Position == UDim2.new(0.5, 0, 0.100000001, 0) or isClose(c2.Position, 0.5, 0.1)) then
                        for _, c3 in ipairs(c2:GetChildren()) do
                            if c3:IsA("TextLabel") and (c3.Position == UDim2.new(0.5, 0, 0.449999988, 0) or isClose(c3.Position, 0.5, 0.45)) then
                                return c3
                            end
                        end
                    end
                end
            end
        end

        return nil
    end

    local function ensureClickToMoveMode()
        -- ✅ [사용자 요청] 매크로 중단 시 즉시 멈추도록 토글 체크 추가
        if not checkToggles() then return false end

        local coreGui = game:GetService("CoreGui")
        local vim = Services.VirtualInputManager

        local isTargetPos = false
        local selector = nil

        local success, result = pcall(function()
            local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
                .PageViewClipper.PageView.PageViewInnerFrame.Page
            selector = basePage["Movement ModeFrame"].Selector
            return selector.Selection3
        end)

        if success and result and result.Position == UDim2.new(0, 32, 0, 0) then
            return true
        end


        -- 메뉴 열기 (ESC -> Tab)
        vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(1.5)
        vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)

        vim:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
        task.wait(1.5)
        vim:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)

        -- ✅ [사용자 요청] 메뉴를 연 직후에도 토글 체크 - 꺼졌으면 메뉴 닫고 즉시 종료
        if not checkToggles() then
            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
            task.wait(1)
            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
            return false
        end

        pcall(function()
            local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
                .PageViewClipper.PageView.PageViewInnerFrame.Page
            selector = basePage["Movement ModeFrame"].Selector
        end)

        local hoverSuccess = false
        if selector then
            for i = 1, 50 do
                if not checkToggles() then break end
                vim:SendKeyEvent(true, Enum.KeyCode.Down, false, game)
                task.wait(0.35)
                vim:SendKeyEvent(false, Enum.KeyCode.Down, false, game)
                if selector.GuiState == Enum.GuiState.Hover then
                    hoverSuccess = true
                    break
                end
            end

            if not hoverSuccess and checkToggles() then
                for i = 1, 50 do
                    if not checkToggles() then break end
                    vim:SendKeyEvent(true, Enum.KeyCode.Up, false, game)
                    task.wait(0.35)
                    vim:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                    if selector.GuiState == Enum.GuiState.Hover then
                        hoverSuccess = true
                        break
                    end
                end
            end
        end

        if hoverSuccess then
            local targetReached = false
            -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 30회 시도, 약 30초)
            local rightAttempts = 0
            while checkToggles() and rightAttempts < 30 do
                rightAttempts = rightAttempts + 1
                local s3 = nil
                pcall(function() s3 = selector.Selection3 end)
                if s3 and s3.Position == UDim2.new(0, 32, 0, 0) then
                    targetReached = true
                    break
                end

                vim:SendKeyEvent(true, Enum.KeyCode.Right, false, game)
                task.wait(1)
                vim:SendKeyEvent(false, Enum.KeyCode.Right, false, game)
            end

            if targetReached then
                task.wait(1)
                vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
                task.wait(1.5)
                vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
                return true
            end
        end

        vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(1)
        vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
        return false
    end

    local function moveToPlace3AutoFishStyle()
        -- ✅ [사용자 요청] 이동 시작 전 1초 대기
        task.wait(1)
        -- ✅ [사용자 요청] 매크로 중단 시 그 즉시 멈추도록 토글 체크 추가
        if not checkToggles() then return end

        ensureClickToMoveMode()
        if not checkToggles() then return end

        local scriptParts = workspace:FindFirstChild("ScriptParts")
        local p3 = scriptParts and scriptParts:FindFirstChild("Place3")
        if not p3 then
            p3 = Instance.new("Part")
            p3.Name = "Place3"
            p3.Position = Vector3.new(134.22, 92.00, -386.61)
            p3.Anchored = true
            p3.CanCollide = false
            p3.Transparency = 1
            p3.Parent = scriptParts or workspace
        end

        -- ✅ [치명적 버그 수정] 낚시 기능(Phase1/Phase2 캐스팅 이동)과 동일한 방식 적용:
        -- 이동이 실제로 성공했는지(도착했는지) 감지하고, 실패했으면 성공한 것으로 오판하고
        -- 그냥 넘어가지 않고 캐릭터를 리셋한 뒤 처음부터 다시 이동을 시도한다.
        -- (기존엔 "3초간 멈춰있으면 도착한 것"으로만 판단해서, 중간에 막혀서 멈춘 경우에도
        --  무조건 성공 처리하고 다음 단계로 진행해버리는 문제가 있었음)
        -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 10회 시도)
        local place3Attempts = 0
        while checkToggles() and place3Attempts < 10 do
            place3Attempts = place3Attempts + 1
            SetCurrentAction("메모리 매치 - Place3으로 이동 중 (시도 " .. place3Attempts .. "/10)")
            local cam = workspace.CurrentCamera
            local originalCamCFrame = nil
            local originalCamType = nil

            if cam then
                originalCamType = cam.CameraType
                originalCamCFrame = cam.CFrame
                cam.CameraType = Enum.CameraType.Scriptable
                cam.CFrame = CFrame.new(p3.Position) * CFrame.Angles(math.rad(-90), 0, 0)
            end

            task.wait(1)

            -- ✅ [사용자 요청] 카메라를 이미 조작했으니, 꺼졌으면 클릭하지 말고 카메라부터 원복 후 종료
            if not checkToggles() then
                if cam and originalCamCFrame and originalCamType then
                    cam.CFrame = originalCamCFrame
                    cam.CameraType = originalCamType
                end
                return
            end

            local viewport = workspace.CurrentCamera.ViewportSize
            local centerX = math.floor(viewport.X / 2)
            local centerY = math.floor(viewport.Y / 2)

            showPremiumIndicator(centerX, centerY)
            Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, true, game, 0)
            task.wait(0.05)
            Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, false, game, 0)

            task.wait(0.1)

            if cam and originalCamCFrame and originalCamType then
                cam.CFrame = originalCamCFrame
                cam.CameraType = originalCamType
            end

            -- 도착 확인 (낚시의 checkTouched 방식과 동일)
            local function checkTouchedPlace3()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and p3 and (hrp.Position - p3.Position).Magnitude < 10 then
                    return true
                end
                return false
            end

            local touched = checkTouchedPlace3()

            if not touched then
                local isStoppedTime = 0
                while isStoppedTime < 3 and checkToggles() do
                    task.wait(0.1)
                    if checkTouchedPlace3() then
                        touched = true
                        break
                    end
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp.Velocity.Magnitude < 1 then
                        isStoppedTime = isStoppedTime + 0.1
                    else
                        isStoppedTime = 0
                    end
                end

                if not touched then
                    -- 낚시처럼 한 번 더 재확인
                    touched = checkTouchedPlace3()
                end
            end

            if touched then
                -- ✅ [사용자 요청] 이동 완료 후 1초 대기
                task.wait(1)
                return
            end

            -- ✅ [버그 수정] 이동 실패! 낚시와 동일하게 캐릭터를 강제 리셋하고 처음부터 재시도.
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then
                hum.Health = 0
            end
            task.wait(5)
            -- 반복문 처음으로 돌아가서 이동을 처음부터 재시도
        end

        if place3Attempts >= 10 then
        end
    end

    local function executeSolaraAdClick()
        local Camera = workspace.CurrentCamera
        local VirtualInputManager = Services.VirtualInputManager

        local refWidth = 1920
        local refHeight = 1080
        local refX = 1513
        local refY = 239

        local viewportSize = Camera.ViewportSize
        local currentWidth = viewportSize.X
        local currentHeight = viewportSize.Y

        local shiftStrength = 0.03
        local currentAspectRatio = currentWidth / currentHeight
        local baseAspectRatio = 16 / 9
        local extraRightShift = math.max(0, (currentAspectRatio - baseAspectRatio) * currentHeight * shiftStrength)

        local targetX = math.floor(currentWidth * (refX / refWidth) + extraRightShift)
        local targetY = math.floor(currentHeight * (refY / refHeight))

        -- 2회 연타 버스트 클릭 (Window Focus 누락 및 프레임 드랍 방지)
        for attempt = 1, 2 do
            if not checkToggles() then break end

            if mousemoveabs then
                mousemoveabs(targetX, targetY)
            end

            task.wait(0.15)

            if mouse1press and mouse1release then
                mouse1press()
                task.wait(0.08)
                mouse1release()
                myPrint(string.format("[SolaraAd] (%d차) mouse1press + release 클릭 완료!", attempt))
            elseif mouse1click then
                mouse1click()
                myPrint(string.format("[SolaraAd] (%d차) mouse1click 클릭 완료!", attempt))
            end

            -- 이중 방어: 가상 마우스 클릭 신호 동시 전송
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 0)
            end)

            if attempt < 2 then
                task.wait(0.3)
            end
        end
    end

    -- ! - Start 루프
    -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 5회, 한 번에 약 50초 이상 걸리므로 넉넉함)
    local adLoopAttempts = 0
    while checkToggles() and adLoopAttempts < 5 do
        adLoopAttempts = adLoopAttempts + 1
        -- 메모리 매치가 활성화 상태가 아닐 때 (바로 시작할 수 있는 상태가 아닐 때)
        if not getgenv().MemoryMatchActive then
            local A = GetFrameA()

            -- ✅ [사용자 요청] 메모리 매치를 바로 할 수 있는 상태(Start Memory Match
            -- 버튼이 이미 보임)라면 광고 시청 루프를 거치지 않고 곧바로 메모리 매치부터 진행한다.
            if A and HasStartMemoryMatchText(A) then
                break
            end

            local innerFrame = A and A:FindFirstChildWhichIsA("Frame")

            -- ✅ [버그 수정] "A 안의 Frame의 Visible"이 진짜 신호인데, A 자체의 Visible까지
            -- 같이 요구하고 있어서 A.Visible이 false인 경우 innerFrame이 켜져있어도
            -- 무조건 비활성으로 오판하던 문제. 이제 innerFrame의 Visible만 기준으로 판정.
            if not A or not innerFrame or not innerFrame.Visible then
                -- ✅ [치명적 버그 수정] 매크로를 처음 켤 때는 게임 UI(MainInterface 안의
                -- A 프레임)가 아직 완전히 로드/구성되지 않았을 수 있음. 기존엔 3초만
                -- 기다리고 안 보이면 그냥 포기하고 break해버려서, 최초 실행이 "아무
                -- 것도 안 하고 그냥 끝나버리는" 것처럼 보였음. 넉넉하게 10초까지 기다린다.
                local inactiveTime = 0
                while inactiveTime < 10 and checkToggles() do
                    task.wait(0.5)
                    inactiveTime = inactiveTime + 0.5
                    A = GetFrameA()
                    innerFrame = A and A:FindFirstChildWhichIsA("Frame")
                    if A and innerFrame and innerFrame.Visible then
                        break
                    end
                end

                if inactiveTime >= 10 then
                    break
                end
            end

            -- A 안의 Frame의 Visible 값이 활성화 상태라면 진입
            SetCurrentAction("메모리 매치 - Place3으로 이동 중 (광고 루프)")
            moveToPlace3AutoFishStyle()
            if not checkToggles() then break end

            -- E 키 누르기
            SetCurrentAction("메모리 매치 - E키 입력 중")
            Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.1)
            Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

            -- ✅ [사용자 요청] E키 누른 후 0.1초마다 계속 폴링하지 않고,
            -- 먼저 7초를 통째로 대기한 다음, 그 시점에 딱 한 번만 Visible 여부를 체크한다.
            task.wait(7)
            if not checkToggles() then break end

            A = GetFrameA()
            local inf = A and A:FindFirstChildWhichIsA("Frame")
            -- ✅ [버그 수정] A.Visible이 아니라 "A 안의 Frame(inf)"의 Visible이 진짜 신호.
            local frameReopened = (inf ~= nil) and inf.Visible

            -- 7초 뒤 체크했는데도 Visible이 켜지지 않았으면 끝(종료)으로 처리
            if not frameReopened then
                break
            end

            -- Visible 값이 켜져있는 게 확인되면 1초 더 대기 후 클릭!
            task.wait(1)
            if not checkToggles() then return end
            A = GetFrameA()
            if A then
                local clickTarget = A:FindFirstChildWhichIsA("Frame") or A:FindFirstChildWhichIsA("ImageButton") or A
                SetCurrentAction("메모리 매치 - 광고 시작 버튼 클릭")
                ClickGui(clickTarget)
            end

            -- 45초 시점 1차 닫기 시도 + 50초 시점 2차 보완 닫기 시도 (동적 대기)
            SetCurrentAction("메모리 매치 - 광고 시청 대기 중 (최대 45초)")
            local waitStart = tick()
            while tick() - waitStart < 45 and checkToggles() do
                task.wait(0.5)
            end
            if not checkToggles() then return end

            -- 1차 클릭 실행
            SetCurrentAction("메모리 매치 - 광고 닫기 1차 시도")
            executeSolaraAdClick()

            -- 5초 추가 대기 (50초 시점 2차 클릭)
            task.wait(5)
            if not checkToggles() then return end

            -- 2차 클릭 실행
            SetCurrentAction("메모리 매치 - 광고 닫기 2차 시도")
            executeSolaraAdClick()

            -- 클릭 완료 후 3초 대기
            task.wait(3)
        else
            break
        end
    end

    local A = GetFrameA()
    if not A then return end

    local imgButton = A:FindFirstChildWhichIsA("ImageButton") or A:FindFirstChildWhichIsA("Frame")

    -- ✅ [안정화] "A 안에 TextLabel이 아무거나 하나라도 있으면 통과"하던 지나치게 관대한
    -- 예외 처리(A:FindFirstChildWhichIsA("TextLabel", true))를 제거. Start Memory Match 텍스트가
    -- 실제로 없어도 A에 다른 문구(로딩 텍스트 등)만 있으면 무조건 진행해버리던 문제가 있었음.
    if HasStartMemoryMatchText(A) then
        -- ✅ [버그 수정] 메뉴를 열지도 않은 채로 "클릭이동이 이미 켜져있는지"를 판정하면
        -- 특히 신선한 세션에서 거의 항상 잘못된 값(false)이 나와서, 실제로는 켜져있어도
        -- "꺼져있음" 분기로 빠져 Place3 이동 자체를 건너뛰던 문제가 있었음.
        -- moveToPlace3AutoFishStyle()이 내부적으로 ensureClickToMoveMode()를 실행해서
        -- 클릭이동을 확실히 켜준 뒤 이동하므로, 매번 이거 하나만 호출하면 충분함.
        SetCurrentAction("메모리 매치 - Place3으로 이동 중")
        moveToPlace3AutoFishStyle()
        if not checkToggles() then return end

        -- E키 한번 누르기
        SetCurrentAction("메모리 매치 - E키 입력 중")
        Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

        -- 3.5초 대기
        task.wait(3.5)
        if not checkToggles() then return end

        -- Start 버튼 누르기
        A = GetFrameA()
        local clickTarget = (A and (A:FindFirstChildWhichIsA("ImageButton") or A:FindFirstChildWhichIsA("Frame"))) or imgButton or A
        SetCurrentAction("메모리 매치 - Start 버튼 클릭")
        ClickGui(clickTarget)

        -- 그 뒤에 원래대로 진행
        getgenv().MemoryMatchActive = true

        -- ✅ [버그 수정] Start 버튼을 누른 직후엔 CountLabel이 아직 이전 라운드의
        -- 값(0)을 그대로 보여주고 있을 수 있어서, 그걸 "기회 0"으로 오판해 바로
        -- 종료해버리는 문제가 있었음. 먼저 5.5초를 기다린 뒤, 그래도 0으로 보이면
        -- 진짜 10이 될 때까지 계속 더 기다린다.
        SetCurrentAction("메모리 매치 - 게임 준비 확인 중")
        task.wait(5.5)
        if not checkToggles() then return end
        do
            local function getCleanCountText()
                local lbl = GetCountLabel()
                if not lbl or not lbl.Text then return nil end
                return (lbl.Text:gsub("%s+", ""))
            end
            local clean = getCleanCountText()
            if clean == "0" then
                -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트(최대 30초)
                local waitStart = tick()
                while checkToggles() and (tick() - waitStart) < 30 do
                    clean = getCleanCountText()
                    if clean == "10" then
                        break
                    end
                    task.wait(0.5)
                end
            end
        end

        local B = GetFrameB()
        local countLabel = GetCountLabel()

        -- 블랙리스트 (클릭해서 맞춘 카드들 - 다시 누르지 않음)
        local blacklist = {}
        -- 한번 이상 확인해서 이미 알고 있는 카드 정보 (frame -> cardID)
        local remembered = {}

        -- ✅ [제외 항목] Memory Match에 등장하는 "안 좋은 아이템"을 ImageID로 걸러냄.
        -- 실제 목록은 영구 탭 "메모리 매치 제외 아이템 입력칸"에서 설정한 값을 그대로 참조함
        -- (Settings.Sols.memoryMatchExcludedItems) - 입력칸을 바꾸면 바로 다음 체크부터 반영됨.

        -- 카드 안의 ZIndex=1 ImageLabel 오브젝트 자체를 반환 (getCardID / 제외 판정에서 공통 재사용)
        local function getCardImageLabel(cardFrame)
            if not cardFrame or not cardFrame.Parent then return nil end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if not inner then return nil end
            for _, img in pairs(inner:GetChildren()) do
                if img:IsA("ImageLabel") and img.ZIndex == 1 then
                    return img
                end
            end
            return nil
        end

        -- 카드의 이미지가 제외 목록에 있는 "안 좋은 아이템"인지 판정
        local function isExcludedCardItem(cardFrame)
            local cImage = getCardImageLabel(cardFrame)
            if not cImage or cImage.Image == "" then return false end
            local excludedList = Settings.Sols.memoryMatchExcludedItems or {}
            return excludedList[cImage.Image] == true
        end

        local function isBlacklisted(cardFrame)
            if not cardFrame or not cardFrame.Parent then return true end
            if not cardFrame.Visible then return true end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if inner and inner.BackgroundTransparency and inner.BackgroundTransparency >= 0.8 then
                return true
            end
            -- ✅ [제외 항목] 안 좋은 아이템(ImageID로 판별)은 매칭 대상에서 완전히 제외
            if isExcludedCardItem(cardFrame) then
                return true
            end
            return blacklist[cardFrame] == true
        end

        -- B 안의 Frame들 안의 Frame 안의 TextLabel Text & ZIndex=1 ImageLabel Image
        local function getCardID(cardFrame)
            if not cardFrame or not cardFrame.Parent then return nil end
            local inner = cardFrame:FindFirstChildWhichIsA("Frame")
            if not inner then return nil end
            
            local cText = inner:FindFirstChildWhichIsA("TextLabel")
            local cImage = getCardImageLabel(cardFrame)
            
            if cText and cImage and cImage.Image ~= "" then
                local rectStr = ""
                if cImage:IsA("ImageLabel") then
                    rectStr = tostring(cImage.ImageRectOffset.X) .. "_" .. tostring(cImage.ImageRectOffset.Y)
                end
                return cText.Text .. "_" .. cImage.Image .. "_" .. rectStr
            end
            return nil
        end

        -- 블랙리스트에 없는 유효한 B 내부 Frame들 추출
        local function getValidBFrames()
            if not B or not B.Parent then B = GetFrameB() end
            if not B then return {} end
            local list = {}
            for _, child in ipairs(B:GetChildren()) do
                if child:IsA("Frame") and not isBlacklisted(child) then
                    table.insert(list, child)
                end
            end
            return list
        end

        -- ✅ [사용자 요청] 메모리 매치 디버그 HUD("남은 횟수" 표시 오버레이) 제거.
        -- 호출부는 그대로 두고 여기서 아무 동작도 안 하게 만들어 안전하게 비활성화.
        -- 혹시 이전에 이미 떠 있던 HUD가 있다면 그것도 함께 지움.
        local function updateDebugHud(statusText, labelText, parsedNum, validCardCount)
            local existingHud = LocalPlayer.PlayerGui:FindFirstChild("MemoryMatchDebugHud")
            if existingHud then
                existingHud:Destroy()
            end
        end

        local function checkIsZeroChances()
            local label = GetCountLabel()
            local labelText = label and label.Text or nil
            if label and label.Text then
                local clean = label.Text:gsub("%s+", "")
                local num = clean:match("^(%d+)$") or clean:match("(%d+)")
                if num and tonumber(num) == 0 then
                    return true, tostring(label.Text), labelText
                end
            end
            return false, nil, labelText
        end

        local function checkEmergency()
            if Settings and Settings.Emergency then
                SetCurrentAction("메모리 매치 - Emergency 대기 중")
                updateDebugHud("Emergency 대기 중", "N/A", "N/A", 0)

                local mainB = GetMemoryMatchMainFrame()
                if mainB and not mainB.Visible then
                    repeat task.wait(0.2) until (mainB and mainB.Visible) or not (Settings and Settings.Emergency)
                end

                if Settings and Settings.Emergency then
                    -- 1. B 비활성화 전 1초 대기
                    task.wait(1)
                    if mainB then mainB.Visible = false end
                    task.wait(1) -- 비활성화 후 1초 대기

                    -- Emergency 진행
                    Settings.EmergencyReady = true
                    SetCurrentAction("메모리 매치 - Emergency 처리 중")
                    -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 90초)
                    local emergencyWaitStart2 = tick()
                    while Settings and Settings.Emergency and (tick() - emergencyWaitStart2) < 180 do
                        task.wait(0.5)
                    end
                    Settings.EmergencyReady = false

                    -- 2. Emergency 종료 후 B 재활성화 전/후 1초 대기
                    task.wait(1)
                    if mainB then mainB.Visible = true end
                    task.wait(1)
                    getgenv().MemoryMatchActive = true
                    getgenv().IsFlexibilityState = true
                    SetCurrentAction("메모리 매치 - Emergency 종료, 이어서 진행")
                end
            end
        end

        -- 반복 A: CountLabel Text 값이 0이 될 때까지
        -- ✅ [버그 수정] 무한 루프 방지용 넉넉한 리미트 (최대 10분)
        local matchLoopStart = tick()
        while true do
            checkEmergency()

            if not checkToggles() then
                updateDebugHud("매크로 끔", "N/A", "N/A", 0)
                break
            end

            if (tick() - matchLoopStart) > 1200 then
                updateDebugHud("게임 종료 (시간 초과)", "N/A", "N/A", 0)
                break
            end

            local isZero, zeroText, currentText = checkIsZeroChances()
            local validFrames = getValidBFrames()
            local curLabel = GetCountLabel()
            local rawText = curLabel and curLabel.Text or currentText or "못 찾음"
            local parsedNum = rawText:match("(%d+)")

            updateDebugHud("플레이 중", rawText, parsedNum, #validFrames)

            if isZero then
                updateDebugHud("게임 종료 (기회 0 감지!)", rawText, "0", #validFrames)
                break
            end

            if #validFrames == 0 then
                updateDebugHud("게임 종료 (남은 카드 없음)", rawText, parsedNum, 0)
                break
            end

            task.wait(1) -- 1초 대기 후 반복 A-1 진행

            checkEmergency()

            -- 이미 알고 있는 짝(중복)이 2개 존재하는지 확인
            local knownPair = nil
            for f1, id1 in pairs(remembered) do
                if not isBlacklisted(f1) then
                    for f2, id2 in pairs(remembered) do
                        if f1 ~= f2 and not isBlacklisted(f2) and id1 == id2 then
                            knownPair = {f1, f2}
                            break
                        end
                    end
                end
                if knownPair then break end
            end

            if knownPair then
                -- 짝수 번째 클릭 완료: 중복 발견된 B 프레임을 각각 1번씩 클릭 (2초 간격)
                SetCurrentAction("메모리 매치 - 발견된 짝 클릭 중")
                local card1, card2 = knownPair[1], knownPair[2]
                
                ClickGui(card1)
                task.wait(2)
                ClickGui(card2)
                task.wait(3)

                blacklist[card1] = true
                blacklist[card2] = true
                remembered[card1] = nil
                remembered[card2] = nil
            else
                -- 짝이 없다면: 이미 확인한 프레임 및 블랙리스트 제외, 랜덤한 1개 클릭 (홀수 클릭)
                local unclickedPool = {}
                for _, f in ipairs(validFrames) do
                    if not remembered[f] and not isBlacklisted(f) then
                        table.insert(unclickedPool, f)
                    end
                end

                -- ✅ [버그 수정] 안 뒤집은 카드가 하나도 없으면(전부 이미 remembered에 있음)
                -- 이미 클릭한 카드를 랜덤으로 골라 재클릭하던 문제가 있었음. 이 상태에선
                -- 아무것도 클릭하지 않고, 다음 반복의 knownPair 확인이 알아서 짝을 찾게 둔다.
                if #unclickedPool == 0 then
                    SetCurrentAction("메모리 매치 - 대기 중 (안 뒤집은 카드 없음)")
                else
                    local firstCard = unclickedPool[math.random(1, #unclickedPool)]

                    SetCurrentAction("메모리 매치 - 카드 클릭 1번 (홀수)")
                    ClickGui(firstCard)
                task.wait(3) -- 3초 대기

                local id1 = getCardID(firstCard)
                if id1 then remembered[firstCard] = id1 end

                -- ✅ [제외 항목] 방금 뒤집은 카드가 "안 좋은 아이템"이면, 짝이 이미 있어도(홀수
                -- 후 중복 발견) 짝수 클릭으로 새로 짝을 찾으려는 시도도 하지 않고 완전히 건너뛴다.
                if isExcludedCardItem(firstCard) then
                    blacklist[firstCard] = true
                    remembered[firstCard] = nil

                    -- ✅ [치명적 버그 수정] 카드 하나만 뒤집고 두 번째 클릭을 안 하면,
                    -- 게임 내부적으로 이 카드가 "짝을 기다리는 상태"로 계속 열려있게 되어서
                    -- 다음번 아무 카드나 뒤집을 때 그게 이 카드와 잘못 비교되어버림
                    -- (이미 클릭한 카드 재클릭, 진짜 짝을 못 맞추는 등 온갖 문제의 원인이었음).
                    -- 제외 카드라도 반드시 다른 카드를 하나 더 클릭해서 대기 상태를 해소해야 함.
                    -- ✅ [버그 수정] remembered(이미 클릭해서 앞면 상태이거나 애매한) 카드는
                    -- 마무리 클릭 대상에서 제외 - 확실히 안 뒤집은(뒷면) 카드만 골라야 함.
                    -- 안 그러면 이미 클릭한 곳을 또 클릭하는 문제가 생김.
                    local closeoutPool = {}
                    for _, f in ipairs(validFrames) do
                        if f ~= firstCard and not remembered[f] and not isBlacklisted(f) then
                            table.insert(closeoutPool, f)
                        end
                    end
                    if #closeoutPool > 0 then
                        local closeoutCard = closeoutPool[math.random(1, #closeoutPool)]
                        SetCurrentAction("메모리 매치 - 마무리 클릭 (제외 항목 처리)")
                        ClickGui(closeoutCard)
                        task.wait(3)
                        if isExcludedCardItem(closeoutCard) then
                            blacklist[closeoutCard] = true
                            remembered[closeoutCard] = nil
                        else
                            local closeoutId = getCardID(closeoutCard)
                            if closeoutId then remembered[closeoutCard] = closeoutId end
                        end
                    end
                else
                    -- ! - 만약 이미 클릭을 해서 홀수가 되었는데 그 때에 중복이 발견된다면, 그걸 누르기
                    local matchedSecondCard = nil
                    if id1 then
                        for f, id in pairs(remembered) do
                            if f ~= firstCard and not isBlacklisted(f) and id == id1 then
                                matchedSecondCard = f
                                break
                            end
                        end
                    end

                    local secondCard = nil
                    if matchedSecondCard then
                        secondCard = matchedSecondCard
                    else
                        -- 중복이 없으면: 1번째 카드가 아니고 + 아직 탐색 안 한 프레임 중 랜덤 1개 선택 (짝수 클릭)
                        local secondPool = {}
                        for _, f in ipairs(validFrames) do
                            if f ~= firstCard and not remembered[f] and not isBlacklisted(f) then
                                table.insert(secondPool, f)
                            end
                        end

                        if #secondPool > 0 then
                            secondCard = secondPool[math.random(1, #secondPool)]
                        else
                            local fallbackPool = {}
                            for _, f in ipairs(validFrames) do
                                if f ~= firstCard and not isBlacklisted(f) then
                                    table.insert(fallbackPool, f)
                                end
                            end
                            if #fallbackPool > 0 then
                                secondCard = fallbackPool[math.random(1, #fallbackPool)]
                            end
                        end
                    end

                    if secondCard then
                        SetCurrentAction("메모리 매치 - 카드 클릭 2번 (짝수)")
                        ClickGui(secondCard)
                        task.wait(3) -- 3초 대기

                        local id2 = getCardID(secondCard)
                        if id2 then remembered[secondCard] = id2 end

                        -- ✅ [제외 항목] 방금 뒤집은 두 번째 카드가 제외 대상이면, 이미지가
                        -- 일치해도(짝수 클릭) 매칭을 확정하지 않는다.
                        if isExcludedCardItem(secondCard) then
                            blacklist[secondCard] = true
                            remembered[secondCard] = nil
                        elseif id1 and id2 and id1 == id2 then
                            blacklist[firstCard] = true
                            blacklist[secondCard] = true
                            remembered[firstCard] = nil
                            remembered[secondCard] = nil
                        else
                            -- ✅ [버그 수정] 진짜 안 맞은 경우(불일치) - 게임이 두 카드를 다시
                            -- 뒷면으로 뒤집는 애니메이션이 끝날 시간을 안 주고 바로 다음 라운드로
                            -- 넘어가서, 아직 뒤집히는 중인 카드를 너무 빨리 재클릭해 무반응이
                            -- 나던 문제가 있었음. firstCard/secondCard의 remembered 기록은
                            -- (뒷면으로 돌아가도 카드 정체성 자체는 그대로이므로) 그대로 유지하되,
                            -- 애니메이션이 끝나도록 추가로 여유를 준다.
                            task.wait(2)
                        end
                    end
                end
                end
            end
        end

        getgenv().MemoryMatchActive = false

        -- B 안의 ImageButton의 Visible 값이 켜지면 1초 대기 후 B 안의 ImageButton 1번 클릭
        local function GetEndButtonB()
            local mainBFrame = GetMemoryMatchMainFrame()
            if not mainBFrame then return nil end
            local cardBoardFrame = GetFrameB()

            for _, desc in ipairs(mainBFrame:GetDescendants()) do
                if desc:IsA("ImageButton") or desc:IsA("TextButton") then
                    if not cardBoardFrame or not desc:IsDescendantOf(cardBoardFrame) then
                        return desc
                    end
                end
            end
            return nil
        end

        SetCurrentAction("메모리 매치 - 종료 버튼 대기 중")
        local bEndBtn = GetEndButtonB()
        if bEndBtn then
            while not bEndBtn.Visible and checkToggles() do
                task.wait(0.5)
            end
        else
            local startTime = tick()
            while tick() - startTime < 8 and checkToggles() do
                bEndBtn = GetEndButtonB()
                if bEndBtn and bEndBtn.Visible then break end
                task.wait(0.5)
            end
        end

        task.wait(1)

        if not checkToggles() then return end

        if bEndBtn then
            SetCurrentAction("메모리 매치 - 종료 버튼 클릭")
            ClickGui(bEndBtn)
        end

        -- 메모리 매치가 끝나면 Place3으로 간 뒤 E키 1번 누르기
        task.wait(1)

        SetCurrentAction("메모리 매치 - 종료 후 Place3으로 이동 중")
        moveToPlace3AutoFishStyle()
        if not checkToggles() then return end
        task.wait(0.5)

        SetCurrentAction("메모리 매치 - 종료 E키 입력 중")
        Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.1)
        Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        task.wait(0.5)

        -- ✅ [치명적 버그 수정] 기존엔 E키 누른 뒤 0.5초 딱 한 번만 대기하고 바로
        -- innerFrame.Visible을 확인해서, 게임 쪽 UI가 그 짧은 시간 안에 아직 갱신이
        -- 안 됐으면 "다음 라운드 없음"으로 오판하고 그냥 끝내버렸음. 최대 3초까지
        -- 0.1초 간격으로 재확인해서, 실제로 다음 라운드가 있는데도 대기를 안 하고
        -- 없다고 판단해버리는 문제를 없앤다.
        local endA = nil
        local innerFrame = nil
        local visibleWaitStart = tick()
        while (tick() - visibleWaitStart) < 3 do
            endA = GetFrameA()
            innerFrame = endA and endA:FindFirstChildWhichIsA("Frame")
            if innerFrame and innerFrame.Visible then
                break
            end
            task.wait(0.1)
        end

        -- ✅ [버그 수정] "원래대로 진행합니다"라고 로그만 찍고 실제로는 그냥 종료 정리로
        -- 떨어지던 문제. Visible이 켜져있으면 진짜로 함수를 다시 실행해서 이어가야 함.
        if innerFrame and innerFrame.Visible then
            -- 종료 정리(MemoryMatchActive=false, A.Visible=false, StopMacro)를 타지 않고
            -- 함수를 다시 실행해서 새 라운드 감지·진행을 그대로 이어간다.
            return RunAutoMemoryMatchLogic()
        end
        if getgenv().CurrentActiveFeature == "MemoryMatch" then
            getgenv().CurrentActiveFeature = nil
        end
    end
    getgenv().MemoryMatchActive = false
    if getgenv().CurrentActiveFeature == "MemoryMatch" then
        getgenv().CurrentActiveFeature = nil
    end

    -- ✅ [사용자 요청] 메모리 매치가 종료되면 A의 Visible 값을 꺼준다.
    local finalA = GetFrameA()
    if finalA then
        finalA.Visible = false
    end

    -- ✅ [우선순위 시스템] Memory Match 종료
    StopMacro("MemoryMatch")
end

-- 메모리 매치 감시 루프 - RegisterSingleAction 등록 방식으로 배선
RegisterSingleAction({
    name = "MemoryMatch",
    signalFlagName = "MemoryMatchWantsSlot",
    logName = "메모리 매치",
    isEnabled = function()
        return Settings.Sols.autoMemoryMatch and Settings.Sols.masterMacroEnabled
    end,
    -- ✅ IsMemoryMatchSignaled()는 UI를 직접 스캔하는 "느린" 버전인데, 이걸 매 틱마다
    -- 호출하면서 그 결과로 캐시된 플래그(MemoryMatchWantsSlot)도 같이 갱신한다.
    -- 다른 곳(doFlexibility 등)에서는 이 캐시된 값(IsMemoryMatchSignaledFast)만 읽는다.
    isSignaled = function()
        local uiSignaled = IsMemoryMatchSignaled()
        if not getgenv().MemoryMatchActive then
            getgenv().MemoryMatchWantsSlot = uiSignaled
        end
        return uiSignaled
    end,
    run = RunAutoMemoryMatchLogic,
    onDisable = function()
        if getgenv().MemoryMatchActive then
            getgenv().MemoryMatchActive = false
        end
    end
})
