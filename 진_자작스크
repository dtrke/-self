-- 포션 자동 제작 실행 함수 - 전체 시퀀스
-- 끝내기 패턴 + Emergency 대기까지 한 번에 처리하는 헬퍼.
-- 패턴 경계에서 호출: Emergency 신호가 없으면 즉시 false 반환(계속 진행).
-- 신호가 있으면 EmergencyReady를 켜서 "지금 끝내기 패턴 쓰고 안전하게 넘길게" 알리고,
-- 끝내기 패턴(재설정 전 1초 대기 -> 재설정 -> 재설정 후 3초 대기)을 실행한 뒤, Emergency가
-- 완전히 끝날 때까지 대기하고 true를 반환한다. 호출부는 true를 받으면 전체 동작을 한 번 더 재시도.
local function HandlePotionCraftEmergencyBoundary()
    if not Settings.Emergency then return false end

    Settings.EmergencyReady = true

    -- 끝내기 패턴 (재설정 전 1초 -> 재설정 -> 재설정 후 3초)
    task.wait(1)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then hum.Health = 0 end
    task.wait(3)

    -- Emergency 행동이 다 끝날 때까지 대기 (넉넉한 리미트 3분)
    local emergencyWaitStart = tick()
    while Settings.Emergency and (tick() - emergencyWaitStart) < 180 do
        task.wait(0.5)
    end
    Settings.EmergencyReady = false
    return true
end

-- 포션 자동 제작 실행 함수 - 전체 시퀀스 (패턴 단위로 구성)
local function RunAutoPotionCraft()
    if not CanStartMacro("PotionCraft") then
        return
    end
    StartMacro("PotionCraft")
    SetCurrentAction("포션 제작 - 재설정 및 부활 대기 중")

    -- ===== 시작 패턴 =====
    -- 재설정 및 부활까지 대기
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then hum.Health = 0 end
    task.wait(0.5)
    char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    -- 1초 대기
    task.wait(1)

    if HandlePotionCraftEmergencyBoundary() then
        return RunAutoPotionCraft()
    end

    -- ===== 이동 패턴 =====
    SetCurrentAction("포션 제작 - Place4로 이동 중")
    -- Place4로 이동 및 캐릭터가 1.5초간 멈춰 있으면 Place5로 이동
    MoveToPlaceClickStyle(Vector3.new(531, 113, -210), "Place4")
    WaitUntilStationary(1.5)
    SetCurrentAction("포션 제작 - Place5로 이동 중")
    MoveToPlaceClickStyle(Vector3.new(-4648.5, 146, -232.5), "Place5")
    WaitUntilStationary(1.5)

    -- ✅ [사용자 요청] 캐릭터가 멈춰 있어도 실제로 Place5 파트와 겹쳐있는지 확인.
    -- 겹쳐있지 않으면(이동 실패) 시작 패턴부터 처음부터 다시 시도.
    local place5Part = workspace:FindFirstChild("ScriptParts") and workspace.ScriptParts:FindFirstChild("Place5")
    local reachedPlace5 = false
    if place5Part then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - place5Part.Position).Magnitude < 10 then
            reachedPlace5 = true
        end
    end

    if not reachedPlace5 then
        SetCurrentAction("포션 제작 - 이동 실패, 처음부터 재시도")
        return RunAutoPotionCraft()
    end

    -- 0.5초 대기
    task.wait(0.5)

    if HandlePotionCraftEmergencyBoundary() then
        return RunAutoPotionCraft()
    end

    -- ===== 상호작용 패턴 =====
    SetCurrentAction("포션 제작 - F키 입력 중")
    -- F키 한번 누르기
    Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.1)
    Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)

    -- ✅ [사용자 요청] ZIndex 999 페이드 대기 대신 단순히 3초 대기로 변경
    task.wait(3)

    if HandlePotionCraftEmergencyBoundary() then
        return RunAutoPotionCraft()
    end

    -- ===== ui 오픈 및 오퍼 패턴 =====
    -- ui 오픈 패턴
    SetCurrentAction("포션 제작 - 재료 목록 탐색 중")
    local craftScreenGui = GetPotionCraftScreenGui()
    local rootFrame = GetPotionCraftRootFrame(craftScreenGui)
    local targetButton, potionViewport, itemContainer = FindPotionCraftTargetButton(rootFrame)

    -- ✅ [주의 리스트] 해당 색(0,99,87)의 ImageButton이 없으면 현재 자동 제작 중인 포션이
    -- 없다는 뜻이므로, 바로 끝내기 패턴을 실행하고 종료 (Emergency 재시도 아님 - 정상 종료)
    if not targetButton then
        SetCurrentAction("포션 제작 - 제작 중인 포션 없음, 종료")
        task.wait(1)
        local char2 = LocalPlayer.Character
        local hum2 = char2 and char2:FindFirstChild("Humanoid")
        if hum2 then hum2.Health = 0 end
        task.wait(3)

        getgenv().PotionCraftWantsSlot = false
        StopMacro("PotionCraft")
        SetCurrentAction("")
        return
    end

    SetCurrentAction("포션 제작 - 재료로 스크롤 중")
    ScrollToPotionButton(targetButton, potionViewport, itemContainer)
    -- 1초 대기
    task.wait(1)
    -- 그 ImageButton 클릭
    SetCurrentAction("포션 제작 - 재료 클릭 1번")
    clickExactly(targetButton)
    -- 0.5초 대기
    task.wait(0.5)

    -- "Open Recipe" 버튼 클릭
    rootFrame = GetPotionCraftRootFrame(GetPotionCraftScreenGui())
    local openRecipeBtn = FindOpenRecipeButton(rootFrame)
    if openRecipeBtn then
        SetCurrentAction("포션 제작 - Open Recipe 클릭")
        clickExactly(openRecipeBtn)
    end
    -- 0.5초 대기
    task.wait(0.5)

    if HandlePotionCraftEmergencyBoundary() then
        return RunAutoPotionCraft()
    end

    -- 오퍼 패턴: 세 번의 클릭 ({0,0} -> 0.25초 -> {1,0} -> 0.25초 -> {0,0})
    rootFrame = GetPotionCraftRootFrame(GetPotionCraftScreenGui())
    local stepContainer = FindRecipeStepContainer(rootFrame)
    if stepContainer then
        local btnA = FindImageButtonByPosition(stepContainer, 0, 0)
        if btnA then
            SetCurrentAction("포션 제작 - 클릭 1번")
            clickExactly(btnA)
        end
        task.wait(0.25)

        stepContainer = FindRecipeStepContainer(GetPotionCraftRootFrame(GetPotionCraftScreenGui()))
        local btnB = stepContainer and FindImageButtonByPosition(stepContainer, 1, 0)
        if btnB then
            SetCurrentAction("포션 제작 - 클릭 2번")
            clickExactly(btnB)
        end
        task.wait(0.25)

        stepContainer = FindRecipeStepContainer(GetPotionCraftRootFrame(GetPotionCraftScreenGui()))
        local btnC = stepContainer and FindImageButtonByPosition(stepContainer, 0, 0)
        if btnC then
            SetCurrentAction("포션 제작 - 클릭 3번")
            clickExactly(btnC)
        end
    end

    if HandlePotionCraftEmergencyBoundary() then
        return RunAutoPotionCraft()
    end

    -- ===== 끝내기 패턴 =====
    SetCurrentAction("포션 제작 - 마무리 재설정 대기 중")
    -- 재설정 전 1초 대기
    task.wait(1)
    -- 재설정 하기
    local char3 = LocalPlayer.Character
    local hum3 = char3 and char3:FindFirstChild("Humanoid")
    if hum3 then hum3.Health = 0 end
    -- 재설정 후 3초 대기
    task.wait(3)

    getgenv().PotionCraftWantsSlot = false
    StopMacro("PotionCraft")
    SetCurrentAction("")
end

