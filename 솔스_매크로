-- Memory Match와 무관한 범용 "클릭 이동" 활성화 함수 (Settings.Sols.masterMacroEnabled 기준으로 동작)
local function EnsureClickToMoveModeForPotion()
    if not Settings.Sols.masterMacroEnabled then return false end

    local coreGui = game:GetService("CoreGui")
    local vim = Services.VirtualInputManager
    local selector = nil

    local success, result = pcall(function()
        local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
            .PageViewClipper.PageView.PageViewInnerFrame.Page
        selector = basePage["Movement ModeFrame"].Selector
        return selector.Selection3
    end)

    if success and result and result.Position == UDim2.new(0, 32, 0, 0) then
        return true
    end


    vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
    task.wait(1.5)
    vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)

    vim:SendKeyEvent(true, Enum.KeyCode.Tab, false, game)
    task.wait(1.5)
    vim:SendKeyEvent(false, Enum.KeyCode.Tab, false, game)

    if not Settings.Sols.masterMacroEnabled then
        vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
        task.wait(1)
        vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
        return false
    end

    pcall(function()
        local basePage = coreGui.RobloxGui.SettingsClippingShield.SettingsShield.MenuContainer.Page
            .PageViewClipper.PageView.PageViewInnerFrame.Page
        selector = basePage["Movement ModeFrame"].Selector
    end)

    local hoverSuccess = false
    if selector then
        for i = 1, 50 do
            if not Settings.Sols.masterMacroEnabled then break end
            vim:SendKeyEvent(true, Enum.KeyCode.Down, false, game)
            task.wait(0.35)
            vim:SendKeyEvent(false, Enum.KeyCode.Down, false, game)
            if selector.GuiState == Enum.GuiState.Hover then
                hoverSuccess = true
                break
            end
        end

        if not hoverSuccess and Settings.Sols.masterMacroEnabled then
            for i = 1, 50 do
                if not Settings.Sols.masterMacroEnabled then break end
                vim:SendKeyEvent(true, Enum.KeyCode.Up, false, game)
                task.wait(0.35)
                vim:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                if selector.GuiState == Enum.GuiState.Hover then
                    hoverSuccess = true
                    break
                end
            end
        end
    end

    if hoverSuccess then
        local targetReached = false
        local rightAttempts = 0
        while Settings.Sols.masterMacroEnabled and rightAttempts < 30 do
            rightAttempts = rightAttempts + 1
            local s3 = nil
            pcall(function() s3 = selector.Selection3 end)
            if s3 and s3.Position == UDim2.new(0, 32, 0, 0) then
                targetReached = true
                break
            end
            vim:SendKeyEvent(true, Enum.KeyCode.Right, false, game)
            task.wait(1)
            vim:SendKeyEvent(false, Enum.KeyCode.Right, false, game)
        end

        if targetReached then
            task.wait(1)
            vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
            task.wait(1.5)
            vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
            return true
        end
    end

    vim:SendKeyEvent(true, Enum.KeyCode.Escape, false, game)
    task.wait(1)
    vim:SendKeyEvent(false, Enum.KeyCode.Escape, false, game)
    return false
end

-- 지정한 위치(Place4/Place5 등)로 클릭이동 방식(카메라 직하향 + 클릭)으로 이동
-- ✅ [치명적 버그 수정] 포션 제작 토글이 꺼졌는지 확인하는 함수. MoveToPlaceClickStyle/
-- WaitUntilStationary(이동 단계)와 RunAutoPotionCraft(패턴 경계) 양쪽에서 다 필요해서
-- 이 파일 앞쪽에 전역으로 둔다. 이동 중에 토글을 꺼도 즉시 멈추지 않고 이동이 끝날
-- 때까지 계속 진행되던 문제(사용자 요청)의 원인이 바로 이 확인이 이동 함수 내부에
-- 전혀 없었기 때문이었음.
local function IsPotionCraftToggleOff()
    return not (Settings.Sols.autoPotionCraft and Settings.Sols.masterMacroEnabled)
end

local function MoveToPlaceClickStyle(placePosition, placeName)
    EnsureClickToMoveModeForPotion()

    local scriptParts = workspace:FindFirstChild("ScriptParts")
    if not scriptParts then
        scriptParts = Instance.new("Folder")
        scriptParts.Name = "ScriptParts"
        scriptParts.Parent = workspace
    end
    local placePart = scriptParts:FindFirstChild(placeName)
    if not placePart then
        placePart = Instance.new("Part")
        placePart.Name = placeName
        placePart.Position = placePosition
        placePart.Anchored = true
        placePart.CanCollide = false
        placePart.Transparency = 1
        placePart.Parent = scriptParts
    end

    local cam = workspace.CurrentCamera
    local originalCamCFrame, originalCamType
    if cam then
        originalCamType = cam.CameraType
        originalCamCFrame = cam.CFrame
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.new(placePart.Position) * CFrame.Angles(math.rad(-90), 0, 0)
    end

    task.wait(1)

    -- ✅ [치명적 버그 수정] 이동 중(카메라 조작 -> 1초 대기 -> 클릭) 토글을 꺼도 끝까지
    -- 계속 진행되던 문제. 카메라를 원래 상태로 복구한 뒤 즉시 빠져나간다.
    if IsPotionCraftToggleOff() then
        if cam and originalCamCFrame and originalCamType then
            cam.CFrame = originalCamCFrame
            cam.CameraType = originalCamType
        end
        return
    end

    local viewport = workspace.CurrentCamera.ViewportSize
    local centerX = math.floor(viewport.X / 2)
    local centerY = math.floor(viewport.Y / 2)
    showPremiumIndicator(centerX, centerY)
    Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, true, game, 0)
    task.wait(0.05)
    Services.VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 1, false, game, 0)

    task.wait(0.1)

    if cam and originalCamCFrame and originalCamType then
        cam.CFrame = originalCamCFrame
        cam.CameraType = originalCamType
    end
end

-- 캐릭터가 duration초 동안 계속 멈춰있으면 반환 (최대 maxWait초까지만 기다림)
local function WaitUntilStationary(duration, maxWait)
    local stationaryTime = 0
    local startTime = tick()
    -- ✅ [치명적 버그 수정] 이 대기는 최대 30초까지 걸릴 수 있는데, 토글 확인이 없어서
    -- 토글을 꺼도 최대 30초 동안 계속 대기를 이어갔음. 매 반복마다 확인해서 즉시 멈춘다.
    while stationaryTime < duration and (tick() - startTime) < (maxWait or 30) and not IsPotionCraftToggleOff() do
        task.wait(0.1)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Magnitude < 1 then
            stationaryTime = stationaryTime + 0.1
        else
            stationaryTime = 0
        end
    end
end

-- 앞서 완성한 "ScrollingFrame 없는 스크롤" 방식 그대로 재사용
local function ScrollToPotionButton(targetButton, viewport, itemContainer)
    if not (targetButton and viewport and itemContainer) then
        return
    end
    local layout = itemContainer:FindFirstChildWhichIsA("UIListLayout")
        or itemContainer:FindFirstChildWhichIsA("UIGridLayout")
    if not layout then
        return
    end

    local btnPos = targetButton.AbsolutePosition
    local btnSize = targetButton.AbsoluteSize
    local viewportPos = viewport.AbsolutePosition
    local viewportSize = viewport.AbsoluteSize

    local deltaY = (btnPos.Y + btnSize.Y / 2) - (viewportPos.Y + viewportSize.Y / 2)

    local currentPos = itemContainer.Position
    local newOffsetY = currentPos.Y.Offset - deltaY

    local maxOffset = 0
    local minOffset = -(layout.AbsoluteContentSize.Y - viewport.AbsoluteSize.Y)
    if minOffset > maxOffset then minOffset = maxOffset end


    newOffsetY = math.clamp(newOffsetY, minOffset, maxOffset)
    itemContainer.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset, currentPos.Y.Scale, newOffsetY)
end

-- A-1 -> [AnchorPoint 1,0.5 / Size 0.25,0.7] -> [Size 0.98,0.885] -> [Size 0.98,0.947] -> Item -> 색 (0,99,87)인 ImageButton
local function FindPotionCraftTargetButton(rootFrame)
    if not rootFrame then
        return nil, nil, nil
    end
    local panelFound, viewportFound, contentFound, itemFound = false, false, false, false
    for _, panel in ipairs(rootFrame:GetChildren()) do
        if panel:IsA("Frame") and panel.AnchorPoint == Vector2.new(1, 0.5)
            and math.abs(panel.Size.X.Scale - 0.25) < 0.01 and math.abs(panel.Size.Y.Scale - 0.7) < 0.01 then
            panelFound = true
            for _, viewport in ipairs(panel:GetChildren()) do
                if viewport:IsA("Frame") and math.abs(viewport.Size.X.Scale - 0.98) < 0.01 and math.abs(viewport.Size.Y.Scale - 0.885) < 0.01 then
                    viewportFound = true
                    for _, content in ipairs(viewport:GetChildren()) do
                        if content:IsA("Frame") and math.abs(content.Size.X.Scale - 0.98) < 0.01 and math.abs(content.Size.Y.Scale - 0.947) < 0.01 then
                            contentFound = true
                            local itemContainer = content:FindFirstChild("Item")
                            if itemContainer then
                                itemFound = true
                                local btnCount = 0
                                for _, btn in ipairs(itemContainer:GetDescendants()) do
                                    if btn:IsA("ImageButton") then
                                        btnCount = btnCount + 1
                                        local c = btn.BackgroundColor3
                                        local r = math.floor(c.R * 255 + 0.5)
                                        local g = math.floor(c.G * 255 + 0.5)
                                        local b = math.floor(c.B * 255 + 0.5)
                                        if r == 0 and g == 99 and b == 87 then
                                            return btn, viewport, itemContainer
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil, nil, nil
end

