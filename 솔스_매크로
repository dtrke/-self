                            vim:SendMouseButtonEvent(centerX, centerY, 1, true, game, 0)
                            task.wait(0.05)
                            vim:SendMouseButtonEvent(centerX, centerY, 1, false, game, 0)
                            lastActivityTime = tick() -- [ACT] Phase1 cast

