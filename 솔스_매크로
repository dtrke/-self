    local function isClose(udim, scaleX, scaleY)
        if not udim then return false end
        return math.abs(udim.X.Scale - scaleX) < 0.05 and math.abs(udim.Y.Scale - scaleY) < 0.05
    end

    local function GetFrameA()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                local posMatch = (frame.Position == UDim2.new(0.5, 0, 0.5, 0)) or isClose(frame.Position, 0.5, 0.5)
                local sizeMatch = (frame.Size == UDim2.new(0.300000012, 0, 0.300000012, 0)) or isClose(frame.Size, 0.3, 0.3)
                if posMatch and sizeMatch then
                    return frame
                end
            end
        end

        -- 보완: 하위에 "Start Memory Match" 텍스트를 가진 중앙 프레임 보완 검색
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") and isClose(frame.Position, 0.5, 0.5) then
                if HasStartMemoryMatchText(frame) then
                    return frame
                end
            end
        end
        return nil
    end

    local function GetMemoryMatchMainFrame()
        for _, frame in ipairs(MainInterface:GetChildren()) do
            if frame:IsA("Frame") then
                for _, desc in ipairs(frame:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text == "Memory Match" then
                        return frame
                    end
                end
            end
        end
        return nil
    end

    local function GetFrameB()
        local mainB = GetMemoryMatchMainFrame()
        if not mainB then return nil end
        for _, child1 in ipairs(mainB:GetChildren()) do
            if child1:IsA("Frame") and (child1.Position == UDim2.new(0.995000005, 0, 0.540000021, 0) or isClose(child1.Position, 0.995, 0.54)) then
                for _, child2 in ipairs(child1:GetChildren()) do
                    if child2:IsA("Frame") and child2:FindFirstChildWhichIsA("UIListLayout") then
                        return child2
                    end
                end
            end
        end
        return nil
    end

    local function GetCountLabel()
        local mainB = GetMemoryMatchMainFrame()
        if not mainB then return nil end

        -- B 안의 [ Position {0.00499999989, 0}, {0.540000021, 0}, Size {0.230000004, 0}, {0.899999976, 0} ] Frame - [ Position {0.5, 0}, {0.100000001, 0} ] Frame - [ Position {0.5, 0}, {0.449999988, 0} ] TextLabel
        for _, c1 in ipairs(mainB:GetChildren()) do
            if c1:IsA("Frame") and (c1.Position == UDim2.new(0.00499999989, 0, 0.540000021, 0) or isClose(c1.Position, 0.005, 0.54)) then
                for _, c2 in ipairs(c1:GetChildren()) do
                    if c2:IsA("Frame") and (c2.Position == UDim2.new(0.5, 0, 0.100000001, 0) or isClose(c2.Position, 0.5, 0.1)) then
                        for _, c3 in ipairs(c2:GetChildren()) do
                            if c3:IsA("TextLabel") and (c3.Position == UDim2.new(0.5, 0, 0.449999988, 0) or isClose(c3.Position, 0.5, 0.45)) then
                                return c3
                            end
                        end
                    end
