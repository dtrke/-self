                    end

                    if proceed and Settings.Sols.autoFishActive then
                        while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                            if getgenv().MemoryMatchActive then
                                task.wait(0.5)
                                continue
                            end

                            -- ✅ [사용자 요청] Memory Match/Potion Craft/Auto Item Use 중
                            -- 뭐라도 가능할 경우 낚시 투척보다 먼저 우선 실행되도록 통합 체크
                            -- (직접 실행하지 않고, 신호가 사라질 때까지 기다리기만 함)
                            if Settings.Sols and Settings.Sols.masterMacroEnabled then
                                YieldFishingForSingleActions()
                                if getgenv().MemoryMatchActive then
                                    task.wait(0.5)
                                    continue
                                end
                            end

                            -- ✅ [치명적 버그 수정] YieldFishingForSingleActions()가 자리를
                            -- 넘겨줬다가 다시 되찾는데, 그 결과(진짜로 자리를 되찾았는지)를
                            -- 확인 안 하고 곧바로 아래 이동/캐스팅 로직으로 진입했었음. 그러면
                            -- 낚시가 자리를 아직 못 쥔 상태에서 이동 클릭 로직이 실행되면서
                            -- 이동 명령이 씹히거나 스킵되는 문제가 있었음("다른 기능을 하고
                            -- 다시 낚시로 돌아올 때 이동을 안 하는" 증상의 원인). 자리를
                            -- 진짜로 쥐고 있을 때까지 여기서 기다린다.
                            while Settings.Sols.autoFishActive and not MacroPriority.IsActive.Fishing do
                                SetCurrentAction("낚시 - 다른 기능에 자리 확인 중")
                                task.wait(0.5)
                                if IsAnySingleActionSignaled() then
                                    YieldFishingForSingleActions()
                                else
                                    StartMacro("Fishing")
                                end
                            end
                            if not Settings.Sols.autoFishActive then break end

                            if tick() - lastActivityTime > 180 then
                                break
                            end

                            -- ! - 1
                            SetCurrentAction("낚시 - Place1에서 낚싯대 던지는 중")
                            local cam = workspace.CurrentCamera
                            local originalCamCFrame = nil
                            local originalCamType = nil

                            if cam then
                                originalCamType = cam.CameraType
                                originalCamCFrame = cam.CFrame
                                cam.CameraType = Enum.CameraType.Scriptable
                                local p1 = workspace:FindFirstChild("ScriptParts") and
                                    workspace.ScriptParts:FindFirstChild("Place1")
                                if p1 then
                                    cam.CFrame = CFrame.new(p1.Position) * CFrame.Angles(math.rad(-90), 0, 0)
