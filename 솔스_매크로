-- Position/투명도를 개별적으로 강제 재동기화할 필요가 없어졌다. FadeStatusUI를
-- getgenv()에 노출해두는 것만으로 충분하다.
getgenv()._FadeStatusUI = FadeStatusUI

-- 이미 만들어둔 아이콘들을 재사용하기 위한 캐시 (매번 새로 만들고 지우면 페이드가 매번
-- 끊기고, GC 부담도 생기므로 이름 기준으로 캐시해서 필요한 것만 추가/삭제한다)
local excludedIconCache = {}

local function RefreshExcludedItemIcons()
    local excluded = Settings.Sols.memoryMatchExcludedItems or {}
    local activeNames = {}

    for _, def in pairs(MemoryMatchItemDefinitions) do
        if excluded[def.imageId] then
            activeNames[def.name] = true
            if not excludedIconCache[def.name] then
                -- ✅ [사용자 요청] 글자(이름) 없이 이미지만 표시
                local iconImage = Instance.new("ImageLabel")
                iconImage.Name = "Icon_" .. def.name
                iconImage.LayoutOrder = 1
                iconImage.Size = UDim2.new(0, 44, 0, 44)
                iconImage.BackgroundTransparency = 1
                iconImage.Image = def.imageId
                iconImage.ZIndex = 1001
                iconImage.ImageTransparency = 0
                iconImage.Parent = ExcludedItemsContainer

                excludedIconCache[def.name] = iconImage
            end
        end
    end

    -- 더 이상 제외 목록에 없는 아이콘은 제거
    for name, iconInstance in pairs(excludedIconCache) do
        if not activeNames[name] then
            iconInstance:Destroy()
            excludedIconCache[name] = nil
        end
    end

    return next(activeNames) ~= nil
end

task.spawn(function()
    while true do
        task.wait(0.2)

        -- ✅ [사용자 요청] "안정성" 개선 - 이 루프는 상태 UI 전체를 갱신하는 핵심
        -- 루프인데 pcall 보호가 전혀 없었음. 예상치 못한 에러(예: 어떤 UI 요소가 이미
        -- 파괴된 상태에서 접근)가 발생하면 이 task.spawn 스레드 전체가 영구히 죽어서,
        -- 그 시점부터 상태 UI가 완전히 멈추는 문제가 있었음. pcall로 감싸서 한 번의
        -- 에러가 다음 반복까지 영향을 주지 않게 한다.
        local ok, err = pcall(function()

        -- ✅ [사용자 요청] 매크로가 켜져있을 때만 UI를 보이게 함 (즉시 켜짐/꺼짐 대신
        -- 부드러운 페이드로 전환)
        FadeStatusUI(Settings.Sols.masterMacroEnabled == true)

        if not Settings.Sols.masterMacroEnabled then
            return
        end

        local holder = MacroPriority.CurrentActive
        local holderDisplay = holder and (macroDisplayNames[holder] or holder) or "없음"

        -- Emergency는 CurrentActive를 건드리지 않으므로, holder가 "Emergency"가 되는
        -- 경우는 없다. Settings.Emergency 플래그로 직접 확인한다.
        -- ✅ [사용자 요청] "하드코딩 정리" - 기존엔 대기열 후보를 "MemoryMatch",
        -- "AutoItemUse", "PotionCraft" 세 개만 하드코딩해서, 나중에 새로 추가된
        -- 단일성 기능(예: MerchantBuy)이 대기열 표시에서 누락되는 문제가 있었다.
        -- RegisteredSingleActions(RegisterSingleAction으로 등록된 모든 단일성 기능
        -- 목록)를 그대로 순회해서 자동으로 확인하도록 바꾼다 - 새 기능이 추가돼도
        -- 이 목록을 따로 갱신할 필요가 없다.
        local queueCandidates = {}
        for _, action in ipairs(RegisteredSingleActions) do
            if holder ~= action.name and action.isEnabled() and action.isSignaled() then
                table.insert(queueCandidates, action.name)
            end
        end

        local queueDisplay = {}
        for _, name in ipairs(queueCandidates) do
            table.insert(queueDisplay, macroDisplayNames[name] or name)
        end
        local queueStr = (#queueDisplay > 0) and table.concat(queueDisplay, ", ") or "없음"

        -- ✅ [사용자 요청] "현재 행동"은 이제 각 로직이 실시간으로 세팅하는
        -- getgenv().CurrentActionText를 그대로 보여준다 (예: "클릭 1번", "이동 중" 등).
        -- 값이 비어있으면 자리를 쥔 것의 기본 상태 문구로 대체.
        local liveAction = getgenv().CurrentActionText
        local actionText
        if liveAction and liveAction ~= "" then
            actionText = liveAction
        elseif Settings.Emergency then
            actionText = "긴급 회피 중"
        elseif not holder then
            actionText = "대기 중 (아무 것도 안 함)"
        else
            actionText = holderDisplay .. " 진행 중"
        end
        if Settings.Emergency and holder then
            actionText = actionText .. " (동시에 " .. holderDisplay .. " 대기 중)"
