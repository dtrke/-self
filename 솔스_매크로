-- =============================
-- ✅ [사용자 요청] Players -> LocalPlayer -> PlayerGui -> Stats -> ScrollingFrame -> Rolls
-- 안의 텍스트(쉼표 포함 숫자)를 실시간으로 읽어서, 사용자가 설정한 롤 수에 도달하면
-- 지정된 게임(PlaceId 118377355457595)으로 텔레포트한다.
do
    local function readRollCount()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local stats = playerGui and playerGui:FindFirstChild("Stats")
        local scrollingFrame = stats and stats:FindFirstChild("ScrollingFrame")
        local rolls = scrollingFrame and scrollingFrame:FindFirstChild("Rolls")
        if not rolls then return nil end

        local label = rolls:IsA("TextLabel") and rolls or rolls:FindFirstChildWhichIsA("TextLabel", true)
        if not label then return nil end

        -- ✅ 쉼표(,)가 포함된 숫자 텍스트("1,234,567" 등)를 정리해서 숫자로 변환
        local cleaned = label.Text:gsub(",", ""):gsub("%s+", ""):match("%d+")
        if not cleaned then return nil end
        return tonumber(cleaned)
    end

    local ROLL_KICK_TARGET_PLACE_ID = 8425637426
    -- ✅ [치명적 버그 수정] "이제는 롤수가 차도 텔레포트를 아예 안 함" - 이전 방식(유예
    -- 시간 5초)은, 그 5초 동안 우연히 "이미 목표를 넘긴 상태"로 판정되면
    -- hasTriggeredKick이 true로 고정됐다. 그런데 롤 수는 시간이 지나면서 계속 증가만
    -- 하는 값이라, 한 번 목표를 넘기면 그 이후로도 계속 그 이상을 유지하므로 다시는
    -- 조건(currentRolls >= target and not hasTriggeredKick)이 성립하지 않아 영원히
    -- 트리거되지 않았다. "얼마나 기다렸는지" 같은 시간 개념 자체를 없애고, 토글을 켠
    -- 바로 그 순간(정확히 처음으로 롤 수를 읽는 데 성공한 딱 1번)의 롤 수를 "기준값"
    -- 으로 저장한 뒤, 그 이후로 "기준값보다 낮았다가 목표에 새로 도달"하는 상황만
    -- 감시한다. 이미 목표를 넘긴 상태로 토글을 켰다면 기준값 자체가 이미 목표 이상
    -- 이므로 자연스럽게 트리거되지 않고, 이후 서버가 바뀌어 롤 수가 낮아졌다가 다시
    -- 목표에 도달하면 정상적으로 트리거된다.
    local baselineRolls = nil

    task.spawn(function()
        while true do
            task.wait(1)

            local ok, err = pcall(function()
                -- ✅ [사용자 요청] "자동으로 안 감" - masterMacroEnabled(매크로 시작) 조건이
                -- 걸려있어서, 매크로 전체를 켜지 않으면 이 기능이 전혀 작동하지 않았다.
                -- 롤수 대비 자동 킥은 낚시/포션 제작 등 다른 매크로 기능과 무관하게 독립적으로
                -- 동작해야 하므로, 이 토글 하나만 켜면 바로 작동하도록 조건을 완화한다.
                if not Settings.Sols.autoRollKick then
                    baselineRolls = nil
                    return
                end

                local target = tonumber(Settings.Sols.rollKickTarget) or 0
                if target <= 0 then return end

                local currentRolls = readRollCount()
                if not currentRolls then return end

                -- ✅ 토글을 켠 뒤 처음으로 값을 성공적으로 읽은 시점 - 이 값을 기준값으로
                -- 저장하고, 이번 확인에서는 트리거하지 않는다.
                if not baselineRolls then
                    baselineRolls = currentRolls
                    return
                end

                -- ✅ [사용자 요청] "이미 롤수가 그 이상이면 튕기지 않게" - 기준값 자체가
                -- 이미 목표 이상이었다면(토글을 켰을 때 이미 넘긴 상태) 절대 트리거하지
                -- 않는다. 기준값이 목표 미만이었는데 지금 목표 이상이 됐을 때만(=진짜로
                -- 새로 도달했을 때만) 트리거한다.
                if baselineRolls < target and currentRolls >= target then
                    SetCurrentAction("롤수 대비 자동 킥 - 목표 도달, 텔레포트 중")
                    game:GetService("TeleportService"):Teleport(ROLL_KICK_TARGET_PLACE_ID, LocalPlayer)
                end
            end)
            if not ok then
                warn("[롤수 대비 자동 킥 오류] " .. tostring(err))
            end
        end
    end)
end

-- ✅ B(알림) 프레임 찾기: MainInterface 안, Position {0.994, 0.899} / Size {0.199, 0.5}
local function GetPotionCraftNotificationFrame()
    local mainUI = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    if not mainUI then
        return nil
    end

    -- ✅ [디버그] 조건에 맞는 후보가 여러 개 있을 수 있으니, 전부 찾아서 오차가 가장 작은
    -- 것을 고른다. (매초 호출되므로 여기서는 로그를 남기지 않고, 호출부에서 프레임이
    -- 새로 바뀔 때만 로그를 남긴다.)
    local candidates = {}
    for _, frame in ipairs(mainUI:GetChildren()) do
        if frame:IsA("Frame") then
            local dx1 = math.abs(frame.Position.X.Scale - 0.994)
            local dy1 = math.abs(frame.Position.Y.Scale - 0.899)
            local dx2 = math.abs(frame.Size.X.Scale - 0.199)
            local dy2 = math.abs(frame.Size.Y.Scale - 0.5)
            if dx1 < 0.02 and dy1 < 0.02 and dx2 < 0.02 and dy2 < 0.02 then
                table.insert(candidates, { frame = frame, score = dx1 + dy1 + dx2 + dy2 })
            end
        end
    end

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b) return a.score < b.score end)
    return candidates[1].frame
end

-- ✅ [사용자 요청] 매크로가 시작되거나 진행 중일 때 항상 B를 감시해서, 새로 생기는 Frame들 중
-- TextLabel의 Text 값이 "Auto Crafted"인 게 있으면 포션 자동 제작 신호를 켠다.
-- ✅ [치명적 버그 수정] 인스턴스(child) 기준 중복 방지가 실제로는 11번 이상 카운트되는
-- 문제가 있었음 - 게임이 "Auto Crafted" 알림 하나를 표시할 때 애니메이션 단계 등으로
-- 여러 개의 서로 다른 Frame/TextLabel 인스턴스를 순차적으로 생성하는 것으로 보임(우리
-- 코드 관점에서는 매번 "새로운" 인스턴스라 인스턴스 기준 중복 방지가 무력화됨). 대신
-- 마지막으로 카운트한 시점 이후 일정 시간 안에는 추가 카운트를 무시하는 시간 기반
-- 디바운스로 바꾼다.
-- ✅ [치명적 버그 수정] "8번 카운트됨" - 원인은 하나의 함수(CheckFrameForAutoCrafted)가
-- "신호 유지"와 "카운트"라는 두 가지 다른 목적을 같이 처리했던 것. 신호 유지는 알림이
-- 떠있는 내내(몇 초짜리 진행바 애니메이션 동안) 매초 계속 확인해야 하지만, 카운트는
-- "이 알림이 새로 생겼을 때" 딱 한 번만 세야 한다. 매초 재스캔이 그 알림의 텍스트
-- 라벨(또는 메인 프레임)을 계속 다시 발견해서 반복 카운트했던 것으로 보임(알림이 약
-- 8초간 떠있으면 1초 간격 재스캔에 정확히 8번 카운트되는 것과 일치). 두 역할을 완전히
-- 분리한다: 카운트는 ChildAdded(새로 생성되는 순간)에서만 하고, 매초 재스캔은 신호
-- 유지만 담당한다.
local function CountAutoCraftedOnce(child)
    if not (child and child:IsA("Frame")) then return end
    for _, desc in ipairs(child:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text == "Auto Crafted" then
            getgenv().PotionCraftWantsSlot = true
            -- ✅ [사용자 요청] 스탯 UI의 "지금까지 만든 아이템 갯수"는 이 알림(UI)이
            -- 새로 뜬 것으로 판단해서 집계한다 - ChildAdded로만 호출되므로 정확히 1번.
            getgenv().PotionCraftCompletedCount = (getgenv().PotionCraftCompletedCount or 0) + 1
            -- ✅ [사용자 요청] 올타임 통계에도 같이 누적
            getgenv()._AllTimeAddPotionCraft()
            return
        end
    end
end

-- 매초 재스캔에서는 카운트 없이 신호만 유지한다.
local function RefreshAutoCraftedSignal(child)
    if not (child and child:IsA("Frame")) then return end
    for _, desc in ipairs(child:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text == "Auto Crafted" then
            getgenv().PotionCraftWantsSlot = true
            return
        end
    end
end

task.spawn(function()
    local connectedFrame = nil
    local conn = nil
    while true do
        task.wait(1)
        if Settings.Sols.masterMacroEnabled then
            local notifFrame = GetPotionCraftNotificationFrame()
            if notifFrame and notifFrame ~= connectedFrame then
                if conn then conn:Disconnect() end
                connectedFrame = notifFrame
                -- ✅ 새로 알림 프레임(notifFrame)에 연결되는 시점부터는 새로 생기는
                -- 알림만 카운트한다.
                conn = notifFrame.ChildAdded:Connect(CountAutoCraftedOnce)

                -- ✅ [버그 수정] ChildAdded는 "새로 생기는 것"만 잡아서, 매크로를 켜기 전에
                -- 이미 떠 있던 "Auto Crafted" 알림은 놓쳐버리는 문제가 있었음. 새로 연결되는
                -- 이 순간(최초 1회)에만 기존 자식들도 카운트해서 놓치는 것을 방지한다 -
                -- 이후 반복되는 재스캔에서는 절대 카운트하지 않는다(중복 방지의 핵심).
                for _, child in ipairs(notifFrame:GetChildren()) do
                    CountAutoCraftedOnce(child)
                end
            end

            -- ✅ [치명적 버그 수정] "8번 카운트됨" - 신호(PotionCraftWantsSlot)는 알림이
            -- 떠있는 내내 매초 계속 갱신해야 하지만(포션 제작 실행 루프가 이걸 계속
            -- 확인함), 카운트는 절대 여기서 하지 않는다 - 카운트는 위의 ChildAdded에서만
            -- 한다.
            if notifFrame then
                for _, child in ipairs(notifFrame:GetChildren()) do
                    RefreshAutoCraftedSignal(child)
                end
            end
        else
            if conn then
                conn:Disconnect()
                conn = nil
                connectedFrame = nil
            end
        end
    end
end)

