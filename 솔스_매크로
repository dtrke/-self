    StatsSwitchButton.Visible = false
    StatsSwitchButton.Parent = StatsButtonRow
    local StatsSwitchButtonPad = Instance.new("UIPadding")
    StatsSwitchButtonPad.PaddingRight = UDim.new(0, 12)
    StatsSwitchButtonPad.Parent = StatsSwitchButton
    local StatsSwitchButtonGrad = Instance.new("UIGradient")
    StatsSwitchButtonGrad.Transparency = NumberSequence.new({
