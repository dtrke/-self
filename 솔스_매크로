local function FadeStatusUI(shouldShow)
    if shouldShow == statusUIVisible then return end
    statusUIVisible = shouldShow

    local targetMasterTransparency = shouldShow and 0 or 1
    getgenv()._TweenService:Create(getgenv()._MasterFrame, StatusFadeInfo, { GroupTransparency = targetMasterTransparency }):Play()
end

