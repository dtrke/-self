-- ✅ [사용자 요청] 바이옴별로 어떤 포션을 어떤 순서(우선순위)로, 얼마나 사용할지를
-- 테이블로 관리한다. 새 바이옴을 추가하려면 이 테이블에 새 키를 추가하면 되고, 특정
-- 바이옴에 포션을 추가/순서 변경하려면 그 목록의 항목을 추가/재배치하면 된다 - 코드
-- 로직(performRareBiomePopSequence)을 건드릴 필요가 없다.
--
-- 각 항목의 필드:
--   name: 인벤토리에서 찾을 아이템 이름 (useSpecificItemByNameWithAmount에 그대로 전달)
--   amount: 사용량. 숫자 또는 "ALL"(가진 만큼 전부). 함수를 넣으면 실행 시점에 호출되어
--           그 반환값을 사용량으로 쓴다 - 함수는 (hasItem, getAmount) 두 헬퍼를 인자로
--           받아서 다른 아이템의 소지 여부/개수에 따라 동적으로 계산할 수 있다.
--   condition: (선택) 함수(hasItem, getAmount) -> boolean. 이 항목을 시도할지 여부를
--              결정한다. 생략하면 항상 hasItem(name)만으로 판정한다.
--
-- 목록 안에서 위에 있을수록(배열 순서상 앞쪽) 먼저 시도된다 = 우선순위가 높다.
-- ✅ 파일이 이미 로컬 변수 슬롯 200개 한도에 근접해 있어서, getgenv()에 저장한다.
getgenv()._RareBiomePotionTable = {
    GLITCHED = {
        { id = "GLITCHED_1", name = "Warp Potion", amount = 1, enabled = true },
        { id = "GLITCHED_2", name = "Oblivion Potion", amount = "ALL", enabled = true },
        { id = "GLITCHED_3", name = "Godlike Potion", amount = "ALL", enabled = true },
        { id = "GLITCHED_4", name = "Heavenly Potion", amount = "ALL", enabled = true },
        { id = "GLITCHED_5", name = "Potion of Bound", amount = "ALL", enabled = true },
        { id = "GLITCHED_6", name = "Popping Potion", amount = "ALL", enabled = true },
    },
    DREAMSPACE = {
        { id = "DREAMSPACE_1", name = "Warp Potion", amount = 1, enabled = true },
        { id = "DREAMSPACE_2", name = "Oblivion Potion", amount = "ALL", enabled = true },
        { id = "DREAMSPACE_3", name = "Godlike Potion", amount = "ALL", enabled = true },
        { id = "DREAMSPACE_4", name = "Heavenly Potion", amount = "ALL", enabled = true },
        { id = "DREAMSPACE_5", name = "Potion of Bound", amount = "ALL", enabled = true },
        { id = "DREAMSPACE_6", name = "Popping Potion", amount = "ALL", enabled = true },
    },
    CYBERSPACE = {
        -- ✅ [사용자 요청] 우선순위 트리 (위에서부터 하나만 실행됨 - 서로 배타적):
        --   1. 워프 포션이 10개 이상 있으면 -> 워프 포션 10개를 쓰기
        --   2. (아니면) 트랜센던트 포션이 있으면 -> 트랜센던트 포션 1개를 쓰기
        --   3. (아니면) Tidal Shifter Potion이 2개 이상 있으면 -> Tidal Shifter Potion 1개를 쓰기
        --   4. (아니면) 워프 포션이 있기라도 하면 -> 가진 워프 포션 전부(최대 10개)를 쓰기
        -- 각 조건은 앞 단계들이 전부 해당 안 됐을 때만 만족하도록 짜여있어, 실제로는
        -- 이 목록에서 딱 하나의 항목만 실행된다. enabled=false로 끄면 그 조건 자체를
        -- 완전히 건너뛰고 다음 우선순위로 넘어간다.
        {
            id = "CYBERSPACE_1",
            name = "Warp Potion",
            amount = 10,
            enabled = true,
            condition = function(hasItem, getAmount)
                return getAmount("Warp Potion") >= 10
            end,
        },
        {
            id = "CYBERSPACE_2",
            name = "Transcendent Potion",
            amount = 1,
            enabled = true,
            condition = function(hasItem, getAmount)
                return getAmount("Warp Potion") < 10 and hasItem("Transcendent Potion")
            end,
        },
        {
            id = "CYBERSPACE_3",
            name = "Tidal Shifter Potion",
            amount = 1,
            enabled = true,
            condition = function(hasItem, getAmount)
                return getAmount("Warp Potion") < 10
                    and not hasItem("Transcendent Potion")
                    and getAmount("Tidal Shifter Potion") > 1
            end,
        },
        {
            id = "CYBERSPACE_4",
            name = "Warp Potion",
            amount = 10,
            enabled = true,
            condition = function(hasItem, getAmount)
                local w = getAmount("Warp Potion")
                return w < 10
                    and not hasItem("Transcendent Potion")
                    and getAmount("Tidal Shifter Potion") <= 1
                    and w > 0
            end,
        },
    },
}

local function performRareBiomePopSequence(biomeName)
    if not Settings.Sols.autoRareBiomePop then return end

    if biomeName == "GLITCHED" and not Settings.Sols.popGlitched then return end
    if biomeName == "DREAMSPACE" and not Settings.Sols.popDreamspace then return end
    if biomeName == "CYBERSPACE" and not Settings.Sols.popCyberspace then return end

    -- 1. 대기 및 시작
    Settings.Emergency = true
    StartMacro("Emergency")

    -- 버그 수정: 기존에는 낚시 중일 때만 안전 지점(EmergencyReady)까지 기다렸고,
    -- 메모리 매치만 단독으로 돌고 있을 땐 무조건 2초만 대기 후 캐릭터를 강제 리스폰시켜
    -- 카드 게임 도중에 끊기는 문제가 있었음. Memory Match 진행 중에도 안전 지점을 기다리도록 확장.
    -- ✅ [사용자 요청] 포션 자동 제작 진행 중에도 동일하게 안전 지점까지 기다려준다.
    if (Settings.Sols and Settings.Sols.autoFishActive) or getgenv().MemoryMatchActive or MacroPriority.IsActive.PotionCraft then
        local waitLimit = 60
        local elapsed = 0
        while not Settings.EmergencyReady and elapsed < waitLimit do
            task.wait(0.5)
            elapsed = elapsed + 0.5
        end
    else
        task.wait(2)
    end

    -- 캐릭터 재설정
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.Health = 0
    end

    -- Wait for character respawn
    task.wait(0.5)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)

    -- 2. 인벤토리 열기
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then
        Settings.Emergency = false; StopMacro("Emergency"); return
    end

    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in pairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    clickExactly(btn)
                    task.wait(0.5)
                    break
                end
            end
        end
    end
    if not inventory.Visible then
        Settings.Emergency = false; StopMacro("Emergency"); return
    end
    -- ✅ [사용자 요청] 인벤토리 대기 시간이 체감될 만큼 길었음. 0.5 -> 0.3으로 단축.
    task.wait(0.3)

    -- ItemsTab 클릭
    local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
    if itemsTab then clickExactly(itemsTab) end
    task.wait(0.3)

    -- ✅ [사용자 요청] 카테고리 버튼(QuickCategory) 클릭 방식 제거 - 아이템이 늘어나면
    -- 그 카테고리 안에서도 원하는 아이템을 못 찾을 위험이 있었음. 이제 useSpecificItemByName이
    -- 포션 자동 제작과 동일한 방식(정확한 좌표 계산 스크롤)으로 전체 목록에서 아이템을
    -- 찾으므로, 카테고리 필터가 불필요하다.

    -- 아이템 정렬 2초 대기
    task.wait(2)

    -- 2-1. 아이템 종류별 우선순위 파악 및 사용
    -- ✅ [치명적 버그 수정] "이름이 들어가있는 다른 아이템까지 사용한다" - hasItem/getAmount가
    -- 부분 문자열 매칭(string.find)을 써서, 예를 들어 "Warp Potion"을 확인할 때 "Super
    -- Warp Potion" 같은 다른 아이템도 있다고 착각해 잘못된 재료 판단을 할 수 있었음.
    -- 정확 일치(exact match)로 강화한다.
    local function hasItem(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return false end
        return getgenv()._FindInventoryItemByName(scrollingFrame, itemName) ~= nil
    end

    local function getAmount(itemName)
        local scrollingFrame = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemGrid") and
            inventory.Items.ItemGrid:FindFirstChild("ItemGridScrollingFrame")
        if not scrollingFrame then return 0 end
        local item = getgenv()._FindInventoryItemByName(scrollingFrame, itemName)
        if item then
            local btn = item:FindFirstChild("Button")
            if btn and btn:FindFirstChild("ItemAmount") then
                local txt = btn.ItemAmount.Text
                local num = txt:match("x(%d+)")
                if num then return tonumber(num) end
            end
            return 1 -- fallback if it exists but no xNum
        end
        return 0
    end

    -- ✅ [사용자 요청] 바이옴별 포션 목록(RareBiomePotionTable)을 우선순위 순서대로
    -- 순회하며 사용한다. 새 바이옴/포션/우선순위는 위쪽 테이블만 수정하면 되고, 이
    -- 루프 자체는 건드릴 필요가 없다.
    local potionList = getgenv()._RareBiomePotionTable[biomeName]
    if potionList then
        for _, entry in ipairs(potionList) do
            -- ✅ [사용자 요청] UI 토글로 개별 포션을 끄면 이 조건/포션 자체를 완전히
            -- 건너뛰고 다음 우선순위로 넘어간다 (CYBERSPACE는 이 방식으로 "무조건
            -- 사용하지 않기"가 구현된다).
            if entry.enabled ~= false then
                local shouldUse
                if entry.condition then
                    shouldUse = entry.condition(hasItem, getAmount)
                else
                    shouldUse = hasItem(entry.name)
                end

                if shouldUse then
                    local amountToUse = entry.amount
                    if type(amountToUse) == "function" then
                        amountToUse = amountToUse(hasItem, getAmount)
                    end
                    useSpecificItemByNameWithAmount(entry.name, amountToUse)
                end
            end
        end
    end

    task.wait(1)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end

    Settings.Emergency = false
    StopMacro("Emergency")
end


-- (lastStrangeControllerUse / lastBiomeRandomizerUse는 파일 앞쪽으로 옮겨졌음 - 상태 UI에서도 참조하기 위함)

task.spawn(function()
    local lastTick = tick()
    while true do
        local now = tick()
        local dt = now - lastTick
        lastTick = now

        if Settings and Settings.Emergency then
            lastStrangeControllerUse = lastStrangeControllerUse + dt
            lastBiomeRandomizerUse = lastBiomeRandomizerUse + dt
        end

        -- ✅ [사용자 요청] Auto Item Use가 스스로 감시하다가 쿨타임이 찼을 때
        -- Flexibility(낚시)에 신호를 보내는 방식. 낚시는 이 플래그만 읽으면 되고
        -- 매번 직접 타이머를 계산할 필요가 없음.
        if Settings and Settings.Sols and Settings.Sols.autoBiomeUseReady and Settings.Sols.masterMacroEnabled then
            local nowCheck = tick()
            getgenv().AutoItemUseWantsSlot = (nowCheck - lastStrangeControllerUse) >= (10.5 * 60)
                or (nowCheck - lastBiomeRandomizerUse) >= (18 * 60)
        else
            getgenv().AutoItemUseWantsSlot = false
        end

        task.wait(0.1)
    end
end)

-- ✅ [사용자 요청] 아이템(Strange Controller/Biome Randomizer)을 사용한 뒤, 0.5초 동안
-- 알림 프레임(B, 포션 자동 제작 감지와 같은 곳)에 새로 뜨는 텍스트를 확인한다.
-- "Warning"이 포함된 알림이 하나라도 뜨면(예: 쿨타임이 아직 안 찼다는 경고 등) 실패로
-- 간주해 카운트하지 않고, 0.5초 동안 그런 알림이 전혀 없었으면 실제로 사용된 것으로
-- 판단해 카운트를 늘린다.
-- ✅ 파일이 이미 로컬 변수 슬롯 200개 한도에 근접해 있어서, getgenv()에 저장한다.
getgenv()._CountItemUseIfNoWarning = function(counterKey)
    task.spawn(function()
        local notifFrame = GetPotionCraftNotificationFrame()
        local hadWarning = false
        local conn = nil

        if notifFrame then
            conn = notifFrame.ChildAdded:Connect(function(child)
                if child:IsA("Frame") then
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Text:lower():find("warning") then
                            hadWarning = true
                            break
                        end
                    end
                end
            end)
        end

        task.wait(0.5)

        if conn then conn:Disconnect() end

        if not hadWarning then
            getgenv()[counterKey] = (getgenv()[counterKey] or 0) + 1
            -- ✅ [사용자 요청] 올타임 통계에도 같이 누적 (counterKey는 StrangeControllerUseCount
            -- 또는 BiomeRandomizerUseCount - AllTimeStats 테이블의 같은 키를 그대로 재사용)
            getgenv()._AllTimeAddItemUse(counterKey)
        end
    end)
end

local function performBiomeAutoSequence(force)
    local now = tick()
    -- ✅ [사용자 요청] "오토 아이템 사용"의 부가 토글 - 개별로 끄면 쿨타임이 찼어도
    -- 그 아이템은 사용하지 않는다(기본값은 둘 다 켜짐이라 기존 동작과 동일).
    local useStrange = Settings.Sols.useStrangeControllerItem
        and (now - lastStrangeControllerUse) >= (10.5 * 60)
    local useBiome = Settings.Sols.useBiomeRandomizerItem
        and (now - lastBiomeRandomizerUse) >= (18 * 60)

    if not useStrange and not useBiome then return end

    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
    local inventory = mainInterface and mainInterface:FindFirstChild("Inventory")
    if not inventory then return end

    if not inventory.Visible then
        local sideButtons = mainInterface:FindFirstChild("SideButtons")
        if sideButtons then
            for _, btn in pairs(sideButtons:GetChildren()) do
                if btn.Name == "TextButton" and btn:FindFirstChild("Usage") and btn.Usage.Text == "Inventory" then
                    clickExactly(btn)
                    task.wait(0.5)
                    if Settings.Emergency or getgenv().MemoryMatchActive then
                        if inventory and inventory.Visible then inventory.Visible = false end
                        return
                    end
                    if not (force or Settings.Sols.autoBiomeUse) then return end
                    break
                end
            end
        end
    end
    if not inventory.Visible then return end
    -- ✅ [사용자 요청] 인벤토리 대기 시간이 체감될 만큼 길었음. 0.5 -> 0.3으로 단축.
    task.wait(0.3)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    local itemsTab = inventory:FindFirstChild("Items") and inventory.Items:FindFirstChild("ItemsTab")
    if itemsTab then clickExactly(itemsTab) end
    task.wait(0.3)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    -- ✅ [사용자 요청] 카테고리 버튼(QuickCategory) 클릭 방식 제거 - useSpecificItemByName이
    -- 포션 자동 제작과 동일한 방식(정확한 좌표 계산 스크롤)으로 전체 목록에서 아이템을
    -- 찾으므로, 카테고리 필터가 불필요하다.

    task.wait(2)
    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    if useStrange then
        useSpecificItemByName("Strange Controller")
        lastStrangeControllerUse = tick()
        -- ✅ [사용자 요청] 즉시 카운트하지 않고, 0.5초 동안 알림에 Warning이 없을 때만 카운트
        getgenv()._CountItemUseIfNoWarning("StrangeControllerUseCount")
        task.wait(0.75)
    end

    if Settings.Emergency or getgenv().MemoryMatchActive then
        if inventory and inventory.Visible then inventory.Visible = false end
        return
    end
    if not (force or Settings.Sols.autoBiomeUse) then return end

    if useBiome then
        useSpecificItemByName("Biome Randomizer")
        lastBiomeRandomizerUse = tick()
        -- ✅ [사용자 요청] 즉시 카운트하지 않고, 0.5초 동안 알림에 Warning이 없을 때만 카운트
        getgenv()._CountItemUseIfNoWarning("BiomeRandomizerUseCount")
    end

    task.wait(0.5)
    if inventory and inventory.Visible then
        inventory.Visible = false
    end
end

-- 아이템 사용 실행 루프 - RegisterSingleAction 등록 방식으로 배선.
-- forceInitialRun=false: 순수 쿨타임 기반이라 "진짜 쿨타임이 찼을 때만" 실행해야 함
-- (Memory Match/Potion Craft처럼 "켜지면 일단 한 번"은 여기선 부적절 - 쿨타임 무시하고
-- 아이템을 낭비하게 됨).
RegisterSingleAction({
    name = "AutoItemUse",
    signalFlagName = "AutoItemUseWantsSlot",
    logName = "아이템 사용",
    forceInitialRun = false,
    isEnabled = function()
        return Settings.Sols.autoBiomeUseReady and Settings.Sols.masterMacroEnabled and not getgenv().MemoryMatchActive
    end,
    isSignaled = function()
        local now = tick()
        return (now - lastStrangeControllerUse) >= (10.5 * 60) or (now - lastBiomeRandomizerUse) >= (18 * 60)
    end,
    run = function()
        StartMacro("AutoItemUse")
        -- ✅ force=true 필수: performBiomeAutoSequence 내부의 (force or Settings.Sols.autoBiomeUse)
        -- 체크에서, autoBiomeUse는 낚시가 켜지면 항상 false로 강제되는 값이라 여기서
        -- force 없이 부르면 아무것도 안 하고 즉시 return해버림 (자세한 배경은
        -- RegisterSingleAction 정의부 규칙 설명 참고)
        pcall(performBiomeAutoSequence, true)
        StopMacro("AutoItemUse")
        -- ⚠️ 여기서 StartMacro("Fishing")을 부르지 않는다 - 위의 "run() 안에서 지켜야
        -- 할 규칙 2" 참고. 자리는 비워두고, 낚시가 스스로 신호가 사라진 걸 확인하고
        -- 자리를 되찾아가게 둔다.
    end
})
