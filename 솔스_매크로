--   A: PlayerGui 안에서 DisplayOrder==3000이고 Enabled==true인 ScreenGui 안의,
--      AnchorPoint==(1,0.5)인 Frame
--   B: PlayerGui.MainInterface.Dialog.Choices
local function FindMerchantFrameA()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.DisplayOrder == 3000 and gui.Enabled == true then
            for _, frame in ipairs(gui:GetChildren()) do
                if frame:IsA("Frame") and frame.AnchorPoint == Vector2.new(1, 0.5) then
                    return frame
                end
            end
        end
    end
    return nil
end

local function FindDialogChoices()
    local mainInterface = LocalPlayer.PlayerGui:FindFirstChild("MainInterface")
