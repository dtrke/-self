local function getHooksList()
    local hooks = {}
    if Settings.Webhook and Settings.Webhook ~= "" then table.insert(hooks, Settings.Webhook) end
    if Settings.Webhook2 and Settings.Webhook2 ~= "" then table.insert(hooks, Settings.Webhook2) end
    local customHook = CustomWebhooks[game:GetService("Players").LocalPlayer.Name]
    if customHook then
        table.insert(hooks, customHook)
    end
    return hooks
end

local function updateBiomeMacroState()
    local v = Settings.Sols.masterMacroEnabled and Settings.Sols.biomeMacroReady

    local function sendToggleWebhook(stateMsg)
        local HttpService = game:GetService("HttpService")
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or
            (fluxus and fluxus.request) or request
        if not requestFunc then return end
        local hooks = getHooksList()
        if #hooks == 0 then return end

        local payload = HttpService:JSONEncode({
            ["embeds"] = { {
                ["description"] = stateMsg,
                ["color"] = WEBHOOK_EMBED_COLOR,
                ["timestamp"] = DateTime.now():ToIsoDate(),
                ["footer"] = {
                    ["text"] = MACRO_NAME_LABEL .. " | Player: " .. game:GetService("Players").LocalPlayer.Name
                }
            } }
        })
        for _, hook in ipairs(hooks) do
            task.spawn(function()
                pcall(function()
                    requestFunc({
                        Url = hook,
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body =
                            payload
                    })
                end)
            end)
        end
    end

    if v then
        if not biomeMacroConnection then
            sendToggleWebhook("> ## Biome Macro Enabled")
            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer

            local function findTargetScrollingFrame()
                local mainInterface = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainInterface")

                for _, frame in pairs(mainInterface:GetChildren()) do
                    if frame:IsA("Frame") then
                        local textLabel = frame:FindFirstChildWhichIsA("TextLabel")
                        if textLabel and textLabel.Text == "Private Server" then
                            local f1 = frame:FindFirstChildWhichIsA("Frame")
                            if f1 then
                                local f2 = f1:FindFirstChildWhichIsA("Frame")
                                if f2 then
                                    local f3 = f2:FindFirstChildWhichIsA("Frame")
                                    if f3 then
                                        for _, f4 in pairs(f3:GetChildren()) do
                                            if f4:IsA("Frame") and math.abs(f4.Position.X.Scale - 0.675) < 0.01 and f4.Position.Y.Scale == 0 then
                                                local scrollingFrame = f4:FindFirstChildWhichIsA("ScrollingFrame")
                                                if scrollingFrame then
                                                    return scrollingFrame
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                return nil
            end

            local scrollingFrame = findTargetScrollingFrame()
            if not scrollingFrame then
                warn("Biome Macro: Could not find target ScrollingFrame.")
                return
            end
            local currentBiomeSession = 0

            local function sendDiscordWebhook(biomeNameRaw, actionType, uptimeText)
                local hooks = getHooksList()
                if #hooks == 0 then return end

                local biomeNameUpper = biomeNameRaw:upper()
                local rareBiomes = {
                    ["GLITCHED"] = true,
                    ["DREAMSPACE"] = true,
                    ["CYBERSPACE"] = true
                }
                local isRare = rareBiomes[biomeNameUpper] or false

                local contentMsg = ""
                if actionType == "started" and isRare then
                    contentMsg = "@everyone"
                end

                local desc = "> ## Biome " ..
                    (actionType == "started" and "Started" or "Ended") .. " - " .. biomeNameUpper
                if actionType == "started" then
                    desc = desc .. "\n> \n> **Started:** <t:" .. tostring(os.time()) .. ":R>"
                end
                currentBiomeSession = tick()
                local mySession = currentBiomeSession

                local embed = {
                    ["description"] = desc,
                    ["color"] = WEBHOOK_EMBED_COLOR,
                    ["timestamp"] = DateTime.now():ToIsoDate(),
                    ["fields"] = {
                        {
                            ["name"] = "PS owner",
                            ["value"] = LocalPlayer.Name,
                            ["inline"] = true
                        },
                        {
                            ["name"] = "Uptime",
                            ["value"] = uptimeText,
                            ["inline"] = true
                        }
                    }
                }

                if actionType == "started" then
                    -- ✅ [사용자 요청] "현재 인원수" 필드 삭제
                    local psLink = Settings.PrivateServerLink or "None"
                    if psLink == "" then psLink = "None" end

                    table.insert(embed.fields, {
                        ["name"] = "Private Server Link",
                        ["value"] = psLink,
                        ["inline"] = false
                    })
                end

                local imageUrl = "https://raw.githubusercontent.com/dtrke/SolsRNG/refs/heads/main/" ..
                    biomeNameUpper .. ".png"
                embed["thumbnail"] = {
                    ["url"] = imageUrl
                }

                if actionType == "started" then
                    embed["footer"] = {
                        ["text"] = MACRO_NAME_LABEL .. " | Player: " .. game:GetService("Players").LocalPlayer.Name
                    }
                end

                local payload = {
                    ["content"] = contentMsg,
                    ["embeds"] = { embed }
                }

                local HttpService = game:GetService("HttpService")

                for _, webhookUrl in ipairs(hooks) do
                    task.spawn(function()
                        pcall(function()
                            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or
                                (fluxus and fluxus.request) or request
                            if requestFunc then
                                local res = requestFunc({
                                    Url = webhookUrl .. "?wait=true",
                                    Method = "POST",
                                    Headers = {
                                        ["Content-Type"] = "application/json"
                                    },
                                    Body = HttpService:JSONEncode(payload)
                                })

                                if res and res.Body then
                                    local resData = HttpService:JSONDecode(res.Body)
                                    if resData and resData.id then
                                        local msgId = resData.id
                                        -- ✅ [사용자 요청] "현재 인원수" 표시/실시간 업데이트 로직 삭제.
                                        -- Players 필드 자체가 없어졌으므로 이걸 계속 갱신하던
                                        -- 코루틴(2.5초 간격 PATCH 요청)도 함께 제거한다.
                                    end
                                end
                            end
                        end)
                    end)
                end
            end

            local targetBiomes = {
                "WINDY", "SNOWY", "RAINY", "SANDSTORM", "HELL",
                "STARFALL", "HEAVEN", "CORRUPTION", "NULL",
                "GLITCHED", "DREAMSPACE", "CYBERSPACE", "SINGULARITY"
            }

            local function isValidBiome(biomeStr)
                local cleanBiome = biomeStr:upper():gsub(" ", "")
                for _, tb in ipairs(targetBiomes) do
                    if cleanBiome == tb then
                        return cleanBiome
                    end
                end
                return nil
            end

            biomeMacroConnection = scrollingFrame.ChildAdded:Connect(function(child)
                if child:IsA("TextLabel") then
                    task.wait(0.2)
                    local text = child.Text
                    if text:lower():find("biome") and (text:lower():find("started") or text:lower():find("ended")) then
                        local timeStr = text:match("%[(%d+:%d+)%]") or "Unknown"
                        local biomeRaw = text:match('"(.-)"')

                        local action = text:lower():find("started") and "started" or "ended"
                        if biomeRaw then
                            local validBiome = isValidBiome(biomeRaw)
                            if validBiome then
                                sendDiscordWebhook(validBiome, action, timeStr)

                                -- ✅ [사용자 요청] 상태 UI에 "현재 인식중인 바이옴"을 보여주기 위해
                                -- 전역에 기록해둔다.
                                if action == "started" then
                                    getgenv().CurrentBiomeName = validBiome
                                elseif action == "ended" and getgenv().CurrentBiomeName == validBiome then
                                    getgenv().CurrentBiomeName = nil
                                end

                                if action == "started" and (validBiome == "GLITCHED" or validBiome == "DREAMSPACE" or validBiome == "CYBERSPACE") then
                                    task.spawn(function()
                                        pcall(function()
                                            performRareBiomePopSequence(validBiome)
                                        end)
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        if biomeMacroConnection then
            sendToggleWebhook("> ## Biome Macro Disabled")
            biomeMacroConnection:Disconnect()
            biomeMacroConnection = nil
        end
    end
end


