                barFill,
                TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { BackgroundTransparency = 1 }
            )
            tween:Play()
            labelTween:Play()
            outlineTween:Play()
            fillTween:Play()
            tween.Completed:Wait()
            loadingGui:Destroy()
        end,
    }

    setLoadingProgress(0.05, "LOADING... 5%")
end

