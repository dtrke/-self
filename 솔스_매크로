                        place3.Name = "Place3"
                        place3.Position = Vector3.new(134.22, 92.00, -386.61)
                        place3.Anchored = true
                        place3.CanCollide = false
                        place3.Transparency = 1
                        place3.Parent = scriptParts
                    end
                end)

                local function findFishStorageCount()
