                                end

                                while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                    if getgenv().MemoryMatchActive then
                                        task.wait(0.5)
                                        continue
                                    end
                                    if tick() - lastActivityTime > 180 then
