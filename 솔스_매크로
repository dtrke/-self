    local StatsButtonRow = Instance.new("Frame")
    StatsButtonRow.Name = "StatsButtonRow"
    StatsButtonRow.LayoutOrder = -100
    StatsButtonRow.Size = UDim2.new(1, 0, 0, 40)
    StatsButtonRow.BackgroundTransparency = 1
    StatsButtonRow.ZIndex = 1000
    StatsButtonRow.Parent = StatsFrame

    local StatsButtonRowLayout = Instance.new("UIListLayout")
    StatsButtonRowLayout.FillDirection = Enum.FillDirection.Horizontal
    StatsButtonRowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    StatsButtonRowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    StatsButtonRowLayout.Padding = UDim.new(0, 10)
    StatsButtonRowLayout.SortOrder = Enum.SortOrder.LayoutOrder
    StatsButtonRowLayout.Parent = StatsButtonRow

    local SwitchButton = makeSwitchButton("통계 보기", getgenv()._StatusFrame)

    -- 스탯 화면의 두 버튼: 왼쪽은 "매크로 보기"(순서1), 오른쪽은 "올타임 통계"(순서2,
