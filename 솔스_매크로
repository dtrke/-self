-- ✅ [사용자 요청] "Glitched" 텍스트 이펙트:
--   1. 대소문자가 랜덤하게 뒤바뀜 (매 프레임이 아니라 0.15초 간격 - 너무 빠르면 정신없음)
--   2. 대소문자가 바뀔 때마다 글자색이 랜덤하게 글리치처럼 바뀜
--   3. 랜덤하게 위치가 팍 튀고(각도도 살짝 줌), Expo 이징으로 0.5초 안에 원래 자리로 복귀
--
-- ⚠️ innerLabel(자식 라벨)을 직접 움직인다 - 부모(containerLabel)가 UIListLayout이
-- 관리하는 자리라면 Position/Rotation을 바꿔도 매번 되돌려져 튀는 모션이 반영되지 않음.
--
-- ✅ [사용자 요청] "화면상으로 없어진 건 완전히 제거" - isEnabledFn()이 false면, 루프는
-- 텍스트/색/위치를 원래 상태로 되돌리고 아무 작업도 하지 않은 채 대기만 한다.
--
-- ✅ 스탯 UI에서도 동일한 이펙트를 재사용하기 위해 매개변수화된 함수로 뽑아둔다
-- (대상 라벨/조건이 다를 뿐 로직은 완전히 동일).
-- innerLabel: 실제로 텍스트/위치를 움직일 자식 라벨
-- isEnabledFn: function() -> boolean, 이 이펙트가 지금 보여야 하는지
-- suffixFn: (선택) function() -> string, 텍스트 뒤에 덧붙일 접미사 (예: " : 3번").
-- 상태 UI에서는 안 넘기고(이름만), 스탯 UI에서는 개수 표시용으로 넘긴다.
getgenv()._RunGlitchedEffect = function(innerLabel, isEnabledFn, suffixFn)
    local baseText = "Glitched"
    local rng = Random.new()
    local lastGlitchColor = "#FFFFFF"
    local isJumping = false

    while true do
        if not isEnabledFn() then
            -- 꺼져 있으면 원래 상태로 정리하고 다음 틱까지 조용히 대기
            if innerLabel.Rotation ~= 0 then innerLabel.Rotation = 0 end
            if innerLabel.Position ~= UDim2.new(0, 0, 0, 0) then
                innerLabel.Position = UDim2.new(0, 0, 0, 0)
            end
            task.wait(0.2)
            continue
        end

        -- 1+2. 대소문자 랜덤 토글 + 그때마다 색도 같이 글리치 (0.15초 간격)
        local chars = {}
        for i = 1, #baseText do
            local c = baseText:sub(i, i)
            if rng:NextNumber() < 0.5 then
                chars[i] = c:upper()
            else
                chars[i] = c:lower()
            end
        end
        local displayText = table.concat(chars)

        local glitchColors = { "#FFFFFF", "#AAAAAA", "#00FFFF", "#FF00FF", "#DDDDDD", "#EEEEEE" }
        lastGlitchColor = glitchColors[rng:NextInteger(1, #glitchColors)]

        -- ✅ [사용자 요청] 접미사(개수 등)는 이펙트 색과 무관하게 기본 값 색으로 붙인다.
        local suffix = suffixFn and suffixFn() or ""
        -- ✅ [치명적 버그 수정] "Glitched/Dreamspace가 안 보인다" - innerLabel(Inner
        -- 자식 라벨)이 생성 시점에 TextTransparency = 1(완전 투명)로 초기화되는데, 이
        -- 함수 안에는 그 값을 0으로 되돌리는 코드가 전혀 없었음(Cyberspace는 별도
        -- Inner 자식이 없어서 이 문제가 없었음). 매번 확실하게 선명한 상태로 맞춘다.
        innerLabel.TextTransparency = 0
        innerLabel.Text = string.format('<font color="%s">%s</font>%s', lastGlitchColor, displayText, suffix)

        -- 3. 랜덤하게 팍 튀고 Expo로 0.5초 안에 복귀
        -- ✅ [사용자 요청] 튀는 빈도를 약간 더 늘림 (0.35 -> 0.5)
        if not isJumping and rng:NextNumber() < 0.5 then
            isJumping = true
            local jumpX = rng:NextInteger(-6, 6)
            -- ✅ [사용자 요청] 위아래 튀는 범위 2.5배 감소 (-4~4 -> -1.6~1.6, 정수라 -2~2로 반올림)
            local jumpY = rng:NextInteger(-2, 2)
            local jumpRot = rng:NextInteger(-8, 8)

            innerLabel.Position = UDim2.new(0, jumpX, 0, jumpY)
            innerLabel.Rotation = jumpRot

            local returnTween = getgenv()._TweenService:Create(
                innerLabel,
                TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
                { Position = UDim2.new(0, 0, 0, 0), Rotation = 0 }
            )
            returnTween:Play()
            returnTween.Completed:Connect(function()
                isJumping = false
            end)
        end

        task.wait(0.15) -- 대소문자/색 전환 속도 (기존엔 매 프레임이라 너무 빨랐음)
    end
end

task.spawn(function()
    getgenv()._RunGlitchedEffect(glitchedTextInner, function()
        return Settings.Sols.autoRareBiomePop and Settings.Sols.popGlitched and glitchedPopLabel.Visible
    end)
end)

-- ✅ [사용자 요청] "Dreamspace" 텍스트 이펙트: 지금 색(#F258C7)에서 조금 더 연한 색으로
-- 천천히 순환하며, "매크로 시작하면 뜨는 무한 기호(∞) 모양으로 떠다니는 이미지"와 동일한
-- Lissajous 곡선 모션으로 움직인다. 그 이미지(속도 1.5)보다 약간 느리게(속도 1.0) 움직인다.
--
-- ⚠️ innerLabel(자식 라벨)을 직접 움직인다.
getgenv()._RunDreamspaceEffect = function(innerLabel, isEnabledFn, suffixFn)
    local baseHue, baseSat, baseVal = Color3.fromRGB(242, 88, 199):ToHSV()

    while true do
        task.wait()

        if not isEnabledFn() then
            if innerLabel.Position ~= UDim2.new(0, 0, 0, 0) then
                innerLabel.Position = UDim2.new(0, 0, 0, 0)
            end
            if innerLabel.Rotation ~= 0 then innerLabel.Rotation = 0 end
            task.wait(0.2)
            continue
        end

        local t = tick() * 1.0 -- 이미지(속도 1.5)보다 약간 느리게

        -- ✅ 색 순환: 원래 색(#F258C7) <-> 더 연한 버전 사이를 천천히 오가며 순환
        local lighten = (math.sin(t * 0.6) + 1) / 2 -- 0~1 사이를 천천히 오가는 값
        local cycleColor = Color3.fromHSV(baseHue, baseSat * (1 - lighten * 0.5), math.clamp(baseVal + lighten * 0.35, 0, 1))
        local hex = string.format("#%02X%02X%02X", cycleColor.R * 255, cycleColor.G * 255, cycleColor.B * 255)

        local suffix = suffixFn and suffixFn() or ""
        -- ✅ [치명적 버그 수정] 위 Glitched와 동일한 이유로 매번 확실하게 선명하게 맞춤
        innerLabel.TextTransparency = 0
        innerLabel.Text = string.format('<font color="%s">Dreamspace</font>%s', hex, suffix)

        -- ✅ [사용자 요청] 무한 기호(∞) 궤적을 그리며 떠다니는 모션 (이미지와 동일한 Lissajous
        -- 곡선 공식, 텍스트 라벨 크기에 맞게 폭/높이는 축소해서 UI 밖으로 안 나가게 함)
        -- ✅ [사용자 요청] 각도가 이동속도(위상)와 싱크가 안 맞았음 - 기존엔 좌우 이동이
        -- sin(t)인데 각도는 cos(t)라서 위상이 90도 어긋나 있었음(사인/코사인은 서로 90도
        -- 차이). 각도도 sin(t)로 통일해서 좌우로 움직이는 방향과 정확히 같은 리듬으로
        -- 기울어지게 동기화한다.
        -- ✅ [사용자 요청] 이동 범위 1.3배 감소 후, 추가로 1.5배 더 감소 (누적 약 1.95배)
        local offsetX = math.sin(t) * (8 / 1.3 / 1.5)
        local offsetY = math.sin(t * 2) * (4 / 1.3 / 1.5)
        local rot = math.sin(t) * 2

        innerLabel.Position = UDim2.new(0, offsetX, 0, offsetY)
        innerLabel.Rotation = rot
    end
end

task.spawn(function()
    getgenv()._RunDreamspaceEffect(dreamspaceTextInner, function()
        return Settings.Sols.autoRareBiomePop and Settings.Sols.popDreamspace and dreamspacePopLabel.Visible
    end)
end)

-- ✅ [사용자 요청] "Cyberspace" 텍스트 이펙트:
--   1. 텍스트 곳곳(글자 근처)에 정사각형(가운데 검정, 외곽 파란색)이 스폰됐다가 작아지며
--      사라짐 (스폰 간격 0.133~2.67초 - 이전 대비 빈도 1.5배, 0.25초 안에 사라짐, 크기는
--      미세하게 랜덤하되 너무 크지 않게)
--   2. 중간중간 아무 글자나 하얀색으로 10프레임간 변함
--   (색이 천천히 순환하는 효과는 요청에 따라 제거 - 항상 고정색 #1313EB)
--
-- ⚠️ 스폰 위치: TextBounds로 실제 텍스트가 그려지는 폭을 구하고, 오른쪽 정렬 기준으로
-- 그 영역 안에서만 스폰하도록 제한한다.
--
-- ✅ "화면상으로 없어진 건 완전히 제거" - 스폰된 정사각형은 사라지는 트윈이 끝나면
-- Destroy()로 완전히 제거해서 잔여 인스턴스가 쌓이지 않게 한다.
getgenv()._RunCyberspaceEffect = function(targetLabel, isEnabledFn, suffixFn)
    local baseText = "Cyberspace"
    local fixedHex = "#1313EB"
    local rng = Random.new()
    local nextSquareSpawn = tick() + rng:NextNumber(0.2 / 1.5 / 3, 4 / 1.5 / 3)
    local whiteFlashCharIndex = nil
    local whiteFlashFramesLeft = 0

    while true do
        task.wait()

        if not isEnabledFn() then
            whiteFlashCharIndex = nil
            whiteFlashFramesLeft = 0
            nextSquareSpawn = tick() + rng:NextNumber(0.2 / 1.5 / 3, 4 / 1.5 / 3)
            task.wait(0.2)
            continue
        end

        local t = tick()

        -- 2. 중간중간 아무 글자나 하얀색으로 10프레임간 변경
        if whiteFlashFramesLeft > 0 then
            whiteFlashFramesLeft -= 1
            if whiteFlashFramesLeft <= 0 then
                whiteFlashCharIndex = nil
            end
        elseif rng:NextNumber() < 0.02 then
            whiteFlashCharIndex = rng:NextInteger(1, #baseText)
            whiteFlashFramesLeft = 10
        end

        local suffix = suffixFn and suffixFn() or ""
        if whiteFlashCharIndex then
            local before = baseText:sub(1, whiteFlashCharIndex - 1)
            local flashChar = baseText:sub(whiteFlashCharIndex, whiteFlashCharIndex)
            local after = baseText:sub(whiteFlashCharIndex + 1)
            targetLabel.Text = string.format(
                '<font color="%s">%s</font><font color="#FFFFFF">%s</font><font color="%s">%s</font>%s',
                fixedHex, before, flashChar, fixedHex, after, suffix
            )
        else
            targetLabel.Text = string.format('<font color="%s">%s</font>%s', fixedHex, baseText, suffix)
        end

        -- 1. 정사각형 스폰 (빈도 1.5배 증가)
        if t >= nextSquareSpawn then
            nextSquareSpawn = t + rng:NextNumber(0.2 / 1.5 / 3, 4 / 1.5 / 3)

            -- ✅ 실제 텍스트가 그려지는 폭을 구해서, 그 영역(오른쪽 정렬 기준) 안에서만
            -- 스폰되도록 제한 - "글자 근처에만" 뜨게 하기 위함.
            local textW = targetLabel.TextBounds.X
            local labelW = targetLabel.AbsoluteSize.X
            -- 텍스트가 차지하는 비율 범위 (오른쪽 정렬이므로 오른쪽 끝부터 textW만큼)
            local textStartRatio = labelW > 0 and math.clamp(1 - (textW / labelW), 0, 1) or 0

            -- ✅ 크기는 미세하게 랜덤(6~11px), 텍스트가 실제로 있는 영역 안 랜덤 위치에 스폰
            local size = rng:NextInteger(6, 11)
            local posX = rng:NextNumber(textStartRatio + 0.02, 0.98)
            local posY = rng:NextNumber(0.15, 0.85)

            -- 외곽(파란색) 사각형
            local outerSquare = Instance.new("Frame")
            outerSquare.Name = "CyberspaceSquare"
            outerSquare.AnchorPoint = Vector2.new(0.5, 0.5)
            outerSquare.Position = UDim2.new(posX, 0, posY, 0)
            outerSquare.Size = UDim2.new(0, size, 0, size)
            outerSquare.BackgroundColor3 = Color3.fromRGB(50, 90, 255)
            outerSquare.BorderSizePixel = 0
            outerSquare.ZIndex = 1002
            outerSquare.Parent = targetLabel

            -- 가운데(검정) 사각형
            local innerSquare = Instance.new("Frame")
            innerSquare.Name = "Inner"
            innerSquare.AnchorPoint = Vector2.new(0.5, 0.5)
            innerSquare.Position = UDim2.new(0.5, 0, 0.5, 0)
            innerSquare.Size = UDim2.new(0.5, 0, 0.5, 0)
            innerSquare.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            innerSquare.BorderSizePixel = 0
            innerSquare.ZIndex = 1003
            innerSquare.Parent = outerSquare

            -- 0.25초 안에 작아지며 사라짐 -> 완료되면 완전히 제거(Destroy)
            local shrinkTween = getgenv()._TweenService:Create(
                outerSquare,
                TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }
            )
            shrinkTween:Play()
            shrinkTween.Completed:Connect(function()
                -- ✅ [사용자 요청] 화면상으로 없어진 건 완전히 제거 - 렉 방지
                outerSquare:Destroy()
            end)
        end
    end
end

task.spawn(function()
    getgenv()._RunCyberspaceEffect(cyberspacePopLabel, function()
        return Settings.Sols.autoRareBiomePop and Settings.Sols.popCyberspace and cyberspacePopLabel.Visible
    end)
end)
end

