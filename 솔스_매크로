                                    end

                                    SetCurrentAction("낚시 - 물고기 잡히길 기다리는 중")
                                    local n1, n2 = findFishStorageCount()
                                    if n1 ~= -1 and n1 == n2 then
                                        break
                                    end

                                    local mainUI = game.Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild(
                                        "MainInterface")
                                    if mainUI then
                                        local clicked = false
                                        local rootImageLabel = nil
                                        for _, img1 in ipairs(mainUI:GetDescendants()) do
                                            if img1:IsA("ImageLabel") and math.abs(img1.BackgroundTransparency - 0.4) < 0.01 then
                                                rootImageLabel = img1
                                                for _, img2 in ipairs(img1:GetDescendants()) do
                                                    if img2:IsA("ImageLabel") then
                                                        local textCount = 0
                                                        for _, ch2 in ipairs(img2:GetChildren()) do
                                                            if ch2:IsA("TextLabel") then
                                                                textCount = textCount + 1
                                                            end
                                                        end

                                                        if textCount == 4 then
                                                            for _, img3 in ipairs(img2:GetDescendants()) do
                                                                if img3:IsA("ImageLabel") and img3:FindFirstChildWhichIsA("UIListLayout") then
                                                                    for _, btn in ipairs(img3:GetChildren()) do
