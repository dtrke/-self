local rollKickTextField
rollKickTextField = SolTab.TextField({
    Text = "목표 롤 수 입력칸",
    Default = tostring(Settings.Sols.rollKickTarget or 0),
    Type = "Default",
    Callback = function(v)
        -- ✅ [사용자 요청] "롤수 입력칸이 문제일 수 있음" - 기존엔 쉼표만 제거하고
        -- tonumber를 바로 불러서, 공백이나 다른 문자가 섞여 있으면 파싱이 실패해
        -- 조용히 0으로 리셋될 수 있었다. readRollCount()와 동일하게 쉼표/공백을 모두
        -- 제거한 뒤 숫자 부분만 추출하도록 강화한다.
        local cleaned = tostring(v):gsub(",", ""):gsub("%s+", ""):match("%d+")
        local num = cleaned and tonumber(cleaned)
        if num then
            Settings.Sols.rollKickTarget = num
        end
        -- ✅ 파싱이 실패했을 때(빈 입력, 숫자가 전혀 없는 값 등)는 기존 설정값을 그대로
        -- 유지한다 - 잘못된 입력 때문에 이미 설정해둔 목표 롤 수가 0으로 조용히
        -- 리셋되는 것을 방지한다.

        -- ✅ [사용자 요청] 입력을 확정하면(엔터/포커스 아웃) 자동으로 쉼표가 붙은 형태로
        -- 텍스트를 다시 표시한다. 예: 19245821 입력 -> 19,245,821로 표시.
        if num and rollKickTextField and rollKickTextField.SetText then
            -- 정수 부분에 3자리마다 쉼표를 넣는 표준적인 방식. 음수/소수는 이 기능
            -- 특성상 나오지 않으므로 정수만 고려한다.
            local formatted = tostring(math.floor(num))
            local formattedWithCommas = formatted:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            pcall(function() rollKickTextField:SetText(formattedWithCommas) end)
        end
    end
})

