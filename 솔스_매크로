                                            local targetTextLabel = nil
                                            local waitStart = tick()
                                            local safe1Trigger = false

                                            while Settings.Sols.autoFishActive and not getgenv().FishRestartRequested do
                                                if getgenv().MemoryMatchActive then
                                                    task.wait(0.5)
                                                    continue
                                                end
                                                if tick() - waitStart > 30 then
                                                    safe1Trigger = true
                                                    break
                                                end
                                                targetTextLabel = nil
                                                for _, subImg1 in ipairs(rootImageLabel:GetDescendants()) do
                                                    if subImg1:IsA("ImageLabel") then
                                                        local imgCount = 0
                                                        for _, c in ipairs(subImg1:GetChildren()) do
                                                            if c:IsA("ImageLabel") then imgCount = imgCount + 1 end
                                                        end
                                                        if imgCount == 3 then
                                                            for _, subImg2 in ipairs(subImg1:GetDescendants()) do
                                                                if subImg2:IsA("ImageLabel") then
                                                                    local txtCount = 0
                                                                    for _, c in ipairs(subImg2:GetChildren()) do
                                                                        if c:IsA("TextLabel") then
                                                                            txtCount = txtCount +
                                                                                1
                                                                        end
                                                                    end
                                                                    if txtCount == 2 then
                                                                        for _, t in ipairs(subImg2:GetChildren()) do
                                                                            if t:IsA("TextLabel") and t.Text == "Click / Touch Screen to Reel" then
                                                                                targetTextLabel = t
                                                                                break
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                                if targetTextLabel then break end
                                                            end
                                                        end
                                                    end
                                                    if targetTextLabel then break end
                                                end

                                                if targetTextLabel and math.abs(targetTextLabel.Position.X.Scale) < 0.01 and math.abs(targetTextLabel.Position.X.Offset) < 0.01 and math.abs(targetTextLabel.Position.Y.Scale) < 0.01 and math.abs(targetTextLabel.Position.Y.Offset) < 0.01 then
                                                    break
                                                end
                                                task.wait(0.1)
                                            end

                                            if safe1Trigger then
                                                -- Fallthrough to Safe 1
                                            else
                                                local function getRepeatA1BarAndZone(root)
                                                    local threeImgParent = nil
                                                    for _, subImg1 in ipairs(root:GetDescendants()) do
                                                        if subImg1:IsA("ImageLabel") then
                                                            local imgCount = 0
                                                            for _, c in ipairs(subImg1:GetChildren()) do
                                                                if c:IsA("ImageLabel") then imgCount = imgCount + 1 end
                                                            end
                                                            if imgCount == 3 then
                                                                threeImgParent = subImg1
                                                                break
                                                            end
                                                        end
                                                    end
                                                    if not threeImgParent then return nil, nil end

                                                    local aspectParent = nil
                                                    for _, subImg2 in ipairs(threeImgParent:GetDescendants()) do
                                                        if subImg2:IsA("ImageLabel") and subImg2:FindFirstChildWhichIsA("UIAspectRatioConstraint") then
                                                            aspectParent = subImg2
                                                            break
                                                        end
                                                    end
                                                    if not aspectParent then return nil, nil end

                                                    local textParent = nil
                                                    for _, subImg3 in ipairs(aspectParent:GetDescendants()) do
                                                        if subImg3:IsA("ImageLabel") then
                                                            local txtCount = 0
                                                            for _, c in ipairs(subImg3:GetChildren()) do
                                                                if c:IsA("TextLabel") then txtCount = txtCount + 1 end
                                                            end
                                                            if txtCount == 1 then
                                                                textParent = subImg3
                                                                break
                                                            end
                                                        end
                                                    end
                                                    if not textParent then return nil, nil end

                                                    local barImg, zoneInner = nil, nil
                                                    for _, c in ipairs(textParent:GetChildren()) do
                                                        if c:IsA("ImageLabel") and c.ZIndex == 2 then
