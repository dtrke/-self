-- ============================================================
-- 버튼 정중앙 좌표를 계산해서 실제 마우스 클릭 시뮬레이션
-- ============================================================
local function clickExactly(button)
    if button and button.AbsoluteSize.X > 0 and button.Visible then
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local topBarHeight = GuiService:GetGuiInset().Y
        local centerX = absPos.X + (absSize.X / 2)
        local centerY = absPos.Y + (absSize.Y / 2) + topBarHeight

        showClickIndicator(centerX, centerY)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        return true
    end
    return false
end

-- ============================================================
-- 밀도 시각화 — STATE.ShowDensityViz가 켜져 있으면 각 Fragmentable 파트 위에
-- 밀도 숫자를 색깔로 표시 (초록 = 밀도 낮음/확률 높음, 빨강 = 밀도 높음/확률 낮음)
-- ============================================================
local vizGuis = {} -- part -> BillboardGui 캐시

local function updateDensityViz(candidatesList, densityList)
    if not STATE.ShowDensityViz then
        if next(vizGuis) then
            for part, gui in pairs(vizGuis) do
                if gui then gui:Destroy() end
            end
            vizGuis = {}
        end
        return
    end

    local seen = {}
    local maxDensity = 1
    for _, d in ipairs(densityList) do
        if d > maxDensity then maxDensity = d end
    end

    for i, part in ipairs(candidatesList) do
        seen[part] = true
        local d = densityList[i]
        local t = maxDensity > 1 and math.clamp((d - 1) / (maxDensity - 1), 0, 1) or 0
        local color = Color3.new(t, 1 - t, 0) -- 초록(안전) -> 빨강(몰림)

        local gui = vizGuis[part]
        if not gui then
            gui = Instance.new("BillboardGui")
            gui.Name = "DensityVizGui"
            gui.Size = UDim2.new(0, 60, 0, 24)
            gui.StudsOffset = Vector3.new(0, 2, 0)
            gui.AlwaysOnTop = true
            gui.Parent = part

            local label = Instance.new("TextLabel")
            label.Name = "Label"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.TextSize = 16
            label.Font = Enum.Font.GothamBold
            label.TextColor3 = Color3.new(1, 1, 1)
            label.Parent = gui

            vizGuis[part] = gui
        end

        local label = gui:FindFirstChild("Label")
        if label then
            label.Text = tostring(d)
            label.BackgroundColor3 = color
            label.BackgroundTransparency = 0.25
        end
    end

    for part, gui in pairs(vizGuis) do
        if not seen[part] then
            if gui then gui:Destroy() end
            vizGuis[part] = nil
        end
    end
end

