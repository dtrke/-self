    AutoEating     = (SavedToggleStates and SavedToggleStates.AutoEating) or false,
    AutoSell       = (SavedToggleStates and SavedToggleStates.AutoSell) or false,
    AutoTimeReward = (SavedToggleStates and SavedToggleStates.AutoTimeReward) or false,
    AntiAFK        = (SavedToggleStates and SavedToggleStates.AntiAFK) or false,

    SellConditionActive = false, -- Sell 조건(SellText.Visible)이 충족된 동안 true -> Auto Eating 일시 정지용
    FirePausedUntil = 0,         -- tick() 기준 이 시각이 지나기 전까진 Grab/Eat Fire만 정지 (텔레포트는 계속 작동)
    GlobalPause = false,         -- Time Reward가 전부 Claimed! 감지 -> 재접속 직전까지 모든 로직 정지
}

local function PersistCurrentToggleStates()
