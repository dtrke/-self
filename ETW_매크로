-- ============================================================
-- 재접속 시 자동 스크립트 로드 + 토글 상태 저장/복원
-- (Sol's RNG 매크로 스크립트의 makefolder / writefile,readfile / queue_on_teleport /
--  IS_TELEPORT_LOAD 스냅샷 패턴을 참고함)
-- ============================================================
local SCRIPT_URL = "https://raw.githubusercontent.com/dtrke/-self/refs/heads/main/ETW_%EB%A7%A4%ED%81%AC%EB%A1%9C"

local BASE_FOLDER = "Workspace/ETW"
local ACCOUNT_FOLDER = BASE_FOLDER .. "/" .. tostring(LocalPlayer.UserId)
if makefolder then
    pcall(function() makefolder("Workspace") end)
    pcall(function() makefolder(BASE_FOLDER) end)
    pcall(function() makefolder(ACCOUNT_FOLDER) end)
end
local TOGGLE_STATE_FILE = ACCOUNT_FOLDER .. "/ETW_ToggleStates.json"

local function SaveToggleStates(state)
    if not writefile then return end
    local ok, err = pcall(function()
        writefile(TOGGLE_STATE_FILE, HttpService:JSONEncode({
            AutoEating = state.AutoEating,
            AutoSell = state.AutoSell,
            AutoTimeReward = state.AutoTimeReward,
            AntiAFK = state.AntiAFK,
        }))
    end)
    if not ok then
        warn("[토글 상태 저장 오류] " .. tostring(err))
    end
end

local function LoadToggleStates()
    if not (isfile and readfile and isfile(TOGGLE_STATE_FILE)) then return nil end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(TOGGLE_STATE_FILE))
    end)
    if ok and type(decoded) == "table" then
        return decoded
    end
    return nil
end

-- 재접속(텔레포트)으로 다시 실행된 경우에만 저장된 토글 상태를 불러온다
