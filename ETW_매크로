end

-- ============================================================
-- [Sols RNG와 동일한 방식] 클릭 위치 인디케이터
-- ============================================================
local function showClickIndicator(x, y)
    local sg = Instance.new("ScreenGui")
    sg.Name = "SellClickIndicatorGui"
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 2147483647
    sg.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local indicator = Instance.new("Frame")
    indicator.AnchorPoint = Vector2.new(0.5, 0.5)
    indicator.Position = UDim2.new(0, x, 0, y)
    indicator.Size = UDim2.new(0, 20, 0, 20)
    indicator.BackgroundColor3 = Color3.new(1, 1, 1)
    indicator.BackgroundTransparency = 0.4
    indicator.BorderSizePixel = 0
    indicator.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = indicator

    local tween = TweenService:Create(indicator,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, 60, 0, 60), BackgroundTransparency = 1 }
    )
    tween:Play()
    tween.Completed:Connect(function()
        sg:Destroy()
    end)
end

-- ============================================================
-- 버튼 정중앙 좌표를 계산해서 실제 마우스 클릭 시뮬레이션
-- ============================================================
local function clickExactly(button)
    if button and button.AbsoluteSize.X > 0 and button.Visible then
        local absPos = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local topBarHeight = GuiService:GetGuiInset().Y
        local centerX = absPos.X + (absSize.X / 2)
        local centerY = absPos.Y + (absSize.Y / 2) + topBarHeight

        showClickIndicator(centerX, centerY)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        return true
    end
    return false
end

-- ============================================================
-- Sell 조건 감지 — SellText.Visible이 true인 동안 STATE.SellConditionActive = true
-- (AutoSell 토글 On/Off와 무관하게 항상 감지: Sell 조건이 충족되는 동안엔
--  Auto Eating을 일시적으로 멈추기 위함)
-- ============================================================
local function watchSellCondition()
    task.spawn(function()
        while true do
            task.wait(0.1)
            local ok, err = pcall(function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                local sell = screenGui and screenGui:FindFirstChild("Sell")
                local sellText = sell and sell:FindFirstChild("SellText")
                STATE.SellConditionActive = (sellText ~= nil and sellText.Visible == true)
            end)
            if not ok then
                warn("[Sell 조건 감지 오류] " .. tostring(err))
            end
        end
    end)
end

-- ============================================================
-- Auto Sell (Sell 자동 클릭) — STATE.AutoSell 일 때만 클릭
-- ============================================================
local function watchSell()
    task.spawn(function()
        while true do
            task.wait(0.1)
            if STATE.AutoSell and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                    local sell = screenGui and screenGui:FindFirstChild("Sell")
                    local sellText = sell and sell:FindFirstChild("SellText")
                    local outline = sell and sell:FindFirstChild("outline")

                    if sellText and sellText.Visible and outline then
                        clickExactly(outline)
                    end
                end)
                if not ok then
                    warn("[Auto Sell 오류] " .. tostring(err))
                end
            end
        end
    end)
end

-- ============================================================
-- Anti AFK — STATE.AntiAFK 일 때만 15분마다 스페이스바 입력
-- ============================================================
local function preventAfkKick()
    task.spawn(function()
        while true do
            task.wait(15 * 60) -- 15분
            if STATE.AntiAFK and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end)
                if not ok then
                    warn("[Anti AFK 오류] " .. tostring(err))
                end
            end
        end
    end)
end

-- ============================================================
-- Auto Eating (통합 기능) — STATE.AutoEating 일 때만 동작
--   1) Fragmentable 랜덤 텔레포트 (최근 30개 중복 제외, 스폰 대기 좌표 제외)
--   2) LocalEvents.Grab / LocalEvents.Eat Fire (0.01초 별도 루프)
--   3) ProgressText 정체 감지 (15초/30초/60초 3단계) → Fire만 일시정지, 60초는 Sell 3번+리셋
-- ============================================================
local function autoEatingLoop()
    local RECENT_EXCLUDE_COUNT = 30
    local recentParts = {}

    local lastProgressText = nil
    local lastChangeTime = tick()
    local stalledFor15Triggered = false
    local stalledFor30Triggered = false
    local stalledFor60Triggered = false

    local function rememberPart(part, capCount)
        table.insert(recentParts, part)
        while #recentParts > capCount do
            table.remove(recentParts, 1)
        end
    end

    task.spawn(function()
        while true do
            task.wait(1)
            if STATE.AutoEating and not STATE.SellConditionActive and not STATE.GlobalPause then
                -- 1) 랜덤 Fragmentable 텔레포트
                local ok1, err1 = pcall(function()
                    local map = workspace:FindFirstChild("Map")
                    local fragmentable = map and map:FindFirstChild("Fragmentable")
                    if not fragmentable then return end

                    local PENDING_POS = Vector3.new(0, -20, 0)
                    local PENDING_EPSILON = 1 -- 스터드 오차 허용

                    local candidates = {}
                    for _, child in ipairs(fragmentable:GetChildren()) do
                        if child:IsA("BasePart") then
                            -- 아직 실제 위치로 배치되지 않은(스폰 대기) 템플릿 파트는 제외
                            if (child.Position - PENDING_POS).Magnitude > PENDING_EPSILON then
                                table.insert(candidates, child)
                            end
                        end
                    end
                    local totalCount = #candidates
                    if totalCount == 0 then return end

                    -- 후보 총 개수가 30개보다 적으면, 제외 개수도 "후보 수 - 1"로 줄여서
                    -- pickPool이 절대 비지 않게(항상 최소 1곳은 선택 가능하게) 만든다.
                    local effectiveExcludeCount = math.max(0, math.min(RECENT_EXCLUDE_COUNT, totalCount - 1))
                    while #recentParts > effectiveExcludeCount do
                        table.remove(recentParts, 1)
                    end

                    local excludeSet = {}
                    for _, p in ipairs(recentParts) do
                        excludeSet[p] = true
                    end

                    local pickPool = {}
                    for _, part in ipairs(candidates) do
                        if not excludeSet[part] then
                            table.insert(pickPool, part)
                        end
                    end
                    if #pickPool == 0 then
                        pickPool = candidates
                    end

                    local targetPart = pickPool[math.random(1, #pickPool)]
                    rememberPart(targetPart, effectiveExcludeCount)

                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local partTopOffset = targetPart.Size.Y / 2
                    local partTopPosition = (targetPart.CFrame * CFrame.new(0, partTopOffset, 0)).Position

                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local hipHeight = (humanoid and humanoid.HipHeight) or 2
                    local safeMargin = (hrp.Size.Y / 2) + hipHeight + 1

                    hrp.CFrame = CFrame.new(partTopPosition + Vector3.new(0, safeMargin, 0))
                end)
                if not ok1 then
                    warn("[Auto Eating - 텔레포트 오류] " .. tostring(err1))
                end

                -- 2) ProgressText 정체 감지 (3단계: 15초 -> 5초 대기 / 30초 -> 10초 대기 /
                --    60초 -> 10초 대기 후 Sell 버튼 3번 클릭 후 재설정)
                local ok2, err2 = pcall(function()
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                    local sell = screenGui and screenGui:FindFirstChild("Sell")
                    local progressText = sell and sell:FindFirstChild("ProgressText")
                    if not progressText then return end

                    local currentText = progressText.Text
                    if currentText ~= lastProgressText then
                        lastProgressText = currentText
                        lastChangeTime = tick()
                        stalledFor15Triggered = false
                        stalledFor30Triggered = false
                        stalledFor60Triggered = false
                        STATE.FirePausedUntil = 0 -- 진행 재개됐으니 Fire 일시정지도 즉시 해제
                        return
                    end

                    local elapsed = tick() - lastChangeTime

                    if elapsed >= 60 and not stalledFor60Triggered then
                        stalledFor60Triggered = true
                        STATE.FirePausedUntil = tick() + 10 -- Fire만 10초 정지 (텔레포트는 계속 작동)

                        -- 10초 대기 -> Sell 3번 클릭 -> 재설정 은 별도 코루틴으로 처리해서
                        -- 이 함수(=메인 루프)를 블로킹하지 않게 함 (텔레포트가 계속 돌아야 하므로)
                        task.spawn(function()
                            task.wait(10)

                            local okClick, errClick = pcall(function()
                                local playerGui2 = LocalPlayer:FindFirstChild("PlayerGui")
                                local screenGui2 = playerGui2 and playerGui2:FindFirstChild("ScreenGui")
                                local sell2 = screenGui2 and screenGui2:FindFirstChild("Sell")
                                local outline2 = sell2 and sell2:FindFirstChild("outline")
                                for _ = 1, 3 do
                                    if outline2 then
                                        clickExactly(outline2)
                                    end
                                    task.wait(0.2)
                                end
                            end)
                            if not okClick then
                                warn("[Auto Eating - 60초 정체 Sell 클릭 오류] " .. tostring(errClick))
                            end

                            local char = LocalPlayer.Character
                            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                            if humanoid then
                                humanoid.Health = 0
                            end
                        end)
                    elseif elapsed >= 30 and not stalledFor30Triggered then
                        stalledFor30Triggered = true
                        STATE.FirePausedUntil = tick() + 10 -- Fire만 10초 정지
                    elseif elapsed >= 15 and not stalledFor15Triggered then
                        stalledFor15Triggered = true
                        STATE.FirePausedUntil = tick() + 5 -- Fire만 5초 정지
                    end
                end)
                if not ok2 then
                    warn("[Auto Eating - 정체 감지 오류] " .. tostring(err2))
                end
            end
        end
    end)
end

-- ============================================================
-- Auto Eating - Grab/Eat Fire 전용 루프 (0.01초 간격, 텔레포트/정체감지와 분리)
-- ============================================================
local function autoEatingFireLoop()
    task.spawn(function()
        while true do
            task.wait(0.01)
            if STATE.AutoEating and not STATE.SellConditionActive and tick() >= STATE.FirePausedUntil and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    local localEvents = ReplicatedStorage:FindFirstChild("LocalEvents")
                    local grab = localEvents and localEvents:FindFirstChild("Grab")
                    local eat = localEvents and localEvents:FindFirstChild("Eat")
                    if grab then grab:Fire() end
                    if eat then eat:Fire() end
                end)
                if not ok then
                    warn("[Auto Eating - Grab/Eat Fire 오류] " .. tostring(err))
                end
            end
        end
    end)
end

-- ============================================================
-- Auto Time Reward — STATE.AutoTimeReward 일 때만 동작
--   1) Rewards.TimedRewards.RewardGrid 안의 모든 Template 감시
--   2) Template.Time.Text == "Tap to claim!" 이면 Rewards.Visible 켜고(0.35초) 클릭 ->
--      0.25초 대기 후 Rewards.Visible 끄기. 여러 개면 각각 5초 간격으로 순서대로 처리.
--   3) 모든 Template.Time.Text == "Claimed!" 이면, 전체 로직 10초 정지 -> Sell 3번 클릭
--      -> 재접속 (재접속 전 토글 상태 저장, 재접속 후 자동 복원)
-- ============================================================
local function autoTimeRewardLoop()
    task.spawn(function()
        while true do
            task.wait(1)
            if STATE.AutoTimeReward and not STATE.GlobalPause then
                local ok, err = pcall(function()
                    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
                    local rewards = screenGui and screenGui:FindFirstChild("Rewards")
                    local timedRewards = rewards and rewards:FindFirstChild("TimedRewards")
                    local rewardGrid = timedRewards and timedRewards:FindFirstChild("RewardGrid")
                    if not rewardGrid then return end

                    local templates = {}
                    for _, child in ipairs(rewardGrid:GetChildren()) do
                        if child.Name == "Template" then
                            table.insert(templates, child)
                        end
                    end
                    if #templates == 0 then return end

                    local claimableTemplates = {}
                    local allClaimed = true
                    for _, tmpl in ipairs(templates) do
                        local timeLabel = tmpl:FindFirstChild("Time")
                        local txt = timeLabel and timeLabel.Text
                        if txt ~= "Claimed!" then
                            allClaimed = false
                        end
                        if txt == "Tap to claim!" then
                            table.insert(claimableTemplates, tmpl)
                        end
                    end

                    -- 모든 템플릿이 Claimed! 상태 -> 전체 정지 -> Sell 3번 -> 재접속
                    if allClaimed then
                        STATE.GlobalPause = true
                        task.wait(10)

                        local okClick, errClick = pcall(function()
                            local playerGui2 = LocalPlayer:FindFirstChild("PlayerGui")
                            local screenGui2 = playerGui2 and playerGui2:FindFirstChild("ScreenGui")
                            local sell2 = screenGui2 and screenGui2:FindFirstChild("Sell")
                            local outline2 = sell2 and sell2:FindFirstChild("outline")
                            for _ = 1, 3 do
                                if outline2 then
                                    clickExactly(outline2)
                                end
                                task.wait(0.2)
                            end
                        end)
                        if not okClick then
                            warn("[Auto Time Reward - Sell 클릭 오류] " .. tostring(errClick))
                        end

                        PersistCurrentToggleStates()
                        ReconnectNow()
                        return
                    end

                    -- Tap to claim! 인 것들을 순서대로 처리 (여러 개면 5초 간격)
                    for _, tmpl in ipairs(claimableTemplates) do
                        if not (STATE.AutoTimeReward and not STATE.GlobalPause) then break end

                        if rewards then
                            rewards.Visible = true
                        end
                        task.wait(0.35)
                        clickExactly(tmpl)
                        task.wait(0.25)
                        if rewards then
                            rewards.Visible = false
                        end
                        task.wait(5)
                    end
                end)
                if not ok then
                    warn("[Auto Time Reward 오류] " .. tostring(err))
                end
            end
        end
    end)
end

