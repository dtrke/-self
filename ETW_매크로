-- 재접속 시 이 스크립트를 자동으로 다시 불러오도록 예약
local queue_on_teleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    or (getgenv and getgenv().queue_on_teleport)

local function SetupTeleportAutoLoad()
    if not queue_on_teleport then return end
    local teleportConn
    teleportConn = LocalPlayer.OnTeleport:Connect(function(teleportState)
        if teleportState == Enum.TeleportState.Started or teleportState == Enum.TeleportState.InProgress then
            local autoLoadCode = [[
                pcall(function()
                    if getgenv then getgenv().IS_TELEPORT_LOAD = true end
                    loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
                end)
            ]]
            pcall(function() queue_on_teleport(autoLoadCode) end)
            if teleportConn then teleportConn:Disconnect() end
        end
    end)
end
SetupTeleportAutoLoad()

local function ReconnectNow()
    pcall(function()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

